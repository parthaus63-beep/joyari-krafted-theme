{% liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign product_form_id = 'ProductForm-' | append: section.id
  assign product_type_downcase = product.type | downcase
  assign is_ring_product = false
  assign is_non_ring_jewellery = false

  if product_type_downcase contains 'ring'
    assign is_ring_product = true
  endif
  if product_type_downcase contains 'earring' or product_type_downcase contains 'necklace' or product_type_downcase contains 'bracelet' or product_type_downcase contains 'pendant'
    assign is_non_ring_jewellery = true
  endif

  for collection in product.collections
    assign collection_handle_downcase = collection.handle | downcase
    if collection_handle_downcase contains 'ring'
      assign is_ring_product = true
    endif
    if collection_handle_downcase contains 'earring' or collection_handle_downcase contains 'necklace' or collection_handle_downcase contains 'bracelet' or collection_handle_downcase contains 'pendant'
      assign is_non_ring_jewellery = true
    endif
  endfor

  for tag in product.tags
    assign tag_downcase = tag | downcase
    if tag_downcase contains 'ring' or tag_downcase contains 'requires-ring-size'
      assign is_ring_product = true
    endif
    if tag_downcase contains 'earring' or tag_downcase contains 'necklace' or tag_downcase contains 'bracelet' or tag_downcase contains 'pendant'
      assign is_non_ring_jewellery = true
    endif
  endfor

  if is_non_ring_jewellery
    assign is_ring_product = false
  endif
%}

<section class="jk-product-template" data-product-builder data-quarter-premium="{{ section.settings.carat_quarter_premium }}" data-base-carat="1">
  {% if product != blank %}
    <script type="application/json" data-product-json>{{ product | json }}</script>

    <div class="jk-product-layout jk-product-layout--builder">
      <div class="jk-product-gallery" data-product-gallery>
        <div class="jk-product-gallery__main">
          {% if product.media.size > 0 %}
            {% for media in product.media %}
              <figure class="jk-product-media{% if forloop.first %} is-active{% endif %}" data-media-id="{{ media.id }}" data-image-id="{{ media.preview_image.id | default: media.id }}">
                {% if media.media_type == 'image' %}
                  {{ media | image_url: width: 1500 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200, 1500', sizes: '(min-width: 990px) 58vw, 100vw', alt: media.alt | default: product.title }}
                {% else %}
                  <div class="jk-product-placeholder jk-product-placeholder--media" aria-hidden="true"></div>
                {% endif %}
              </figure>
            {% endfor %}
          {% else %}
            <figure class="jk-product-media is-active">
              <div class="jk-product-placeholder jk-product-placeholder--large" aria-hidden="true"></div>
            </figure>
          {% endif %}
        </div>

        {% if product.media.size > 1 %}
          <div class="jk-product-gallery__thumbs" aria-label="Product media">
            {% for media in product.media %}
              <button type="button" class="jk-media-thumb{% if forloop.first %} is-active{% endif %}" data-media-trigger="{{ media.id }}" data-image-trigger="{{ media.preview_image.id | default: media.id }}" aria-label="View media {{ forloop.index }}">
                {% if media.media_type == 'image' %}
                  {{ media | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90, 140, 180', sizes: '90px', alt: media.alt | default: product.title }}
                {% else %}
                  <span class="jk-thumb-placeholder" aria-hidden="true"></span>
                {% endif %}
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="jk-product-panel">
        <div class="jk-product-panel__inner jk-product-panel__inner--builder">
          <div class="jk-product-panel__header">
            {% if section.settings.show_vendor and product.vendor != blank %}
              <p class="jk-eyebrow">{{ product.vendor }}</p>
            {% else %}
              <p class="jk-eyebrow">Joyari Krafted ring atelier</p>
            {% endif %}

            <h1>{{ product.title }}</h1>

            <div class="jk-product-price-row">
              <p class="jk-product-price" data-variant-price>{{ selected_variant.price | money }}</p>
              {% if selected_variant.compare_at_price > selected_variant.price %}
                <p class="jk-product-compare" data-variant-compare>{{ selected_variant.compare_at_price | money }}</p>
              {% else %}
                <p class="jk-product-compare is-hidden" data-variant-compare></p>
              {% endif %}
            </div>

            {% if section.settings.show_sku %}
              <p class="jk-sku">SKU: <span data-variant-sku>{{ selected_variant.sku | default: 'Made to order' }}</span></p>
            {% endif %}

            {% if section.settings.scarcity_text != blank %}
              <p class="jk-product-scarcity">{{ section.settings.scarcity_text }}</p>
            {% endif %}

            <p class="jk-product-panel__trustline">Certified stone guidance, secure checkout, and personal support before your ring is made.</p>
          </div>

          {% form 'product', product, id: product_form_id, class: 'jk-product-form', data-product-form: 'product' %}
            <input type="hidden" name="id" value="{{ selected_variant.id }}" data-variant-id-input>
            <input type="hidden" name="properties[Joyari builder estimate]" value="{{ selected_variant.price | money }}" data-builder-estimate-property>

            <div class="jk-ring-builder-card jk-ring-builder-card--product">
              <div class="jk-builder-card__header">
                <div>
                  <p class="jk-eyebrow">Ring builder</p>
                  <h2>{{ section.settings.builder_heading }}</h2>
                  <p class="jk-builder-subcopy">Choose your ring details below. The selected Shopify variant remains the checkout item, and your custom choices are saved with the order.</p>
                </div>
                <div class="jk-stone-preview" data-stone-preview data-shape="oval">
                  <span></span>
                </div>
              </div>

              {% unless product.has_only_default_variant %}
                <div class="jk-builder-step jk-product-variant-group">
                  <div class="jk-builder-step__header">
                    <span class="jk-builder-step__number">01</span>
                    <div>
                      <h3>Choose the base setting</h3>
                      <p>These Shopify variant options update the real checkout price and availability.</p>
                    </div>
                  </div>

                {% for option in product.options_with_values %}
                  {% assign selected_value = option.selected_value %}
                  {% assign option_key = 'option' | append: forloop.index %}
                  {% if selected_value == blank %}
                    {% assign selected_value = selected_variant[option_key] %}
                  {% endif %}

                  <fieldset class="jk-option-fieldset" data-option-position="{{ forloop.index }}" data-option-name="{{ option.name | escape }}">
                    <legend>{{ option.name }}</legend>
                    <div class="jk-swatch-row">
                      {% for value in option.values %}
                        {% assign option_id = 'Option-' | append: section.id | append: '-' | append: option.position | append: '-' | append: value | handleize %}
                        <input
                          id="{{ option_id }}"
                          type="radio"
                          name="options[{{ option.name | escape }}]"
                          value="{{ value | escape }}"
                          data-option-input
                          data-option-position="{{ forloop.parentloop.index }}"
                          {% if value == selected_value %}checked{% endif %}
                        >
                        <label for="{{ option_id }}">{{ value }}</label>
                      {% endfor %}
                    </div>
                  </fieldset>
                {% endfor %}
                </div>
              {% endunless %}

              <div class="jk-builder-step">
                <div class="jk-builder-step__header">
                  <span class="jk-builder-step__number">{% if product.has_only_default_variant %}01{% else %}02{% endif %}</span>
                  <div>
                    <h3>Metal selector</h3>
                    <p>Select the precious metal preference saved to your order notes.</p>
                  </div>
                </div>

                <fieldset class="jk-builder-field">
                  <legend class="visually-hidden">Metal selector</legend>
                  <div class="jk-choice-grid jk-choice-grid--metal">
                    <label><input type="radio" name="properties[Metal preference]" value="18k Yellow Gold" data-builder-choice data-price-adjustment="0" checked><span><i class="jk-metal-swatch jk-metal-swatch--yellow" aria-hidden="true"></i>18k Yellow</span></label>
                    <label><input type="radio" name="properties[Metal preference]" value="18k White Gold" data-builder-choice data-price-adjustment="0"><span><i class="jk-metal-swatch jk-metal-swatch--white" aria-hidden="true"></i>18k White</span></label>
                    <label><input type="radio" name="properties[Metal preference]" value="18k Rose Gold" data-builder-choice data-price-adjustment="0"><span><i class="jk-metal-swatch jk-metal-swatch--rose" aria-hidden="true"></i>18k Rose</span></label>
                    <label><input type="radio" name="properties[Metal preference]" value="Platinum" data-builder-choice data-price-adjustment="55000"><span><i class="jk-metal-swatch jk-metal-swatch--platinum" aria-hidden="true"></i>Platinum</span></label>
                  </div>
                </fieldset>
              </div>

              <div class="jk-builder-step">
                <div class="jk-builder-step__header">
                  <span class="jk-builder-step__number">{% if product.has_only_default_variant %}02{% else %}03{% endif %}</span>
                  <div>
                    <h3>Diamond shape selector</h3>
                    <p>Preview the centre stone silhouette and save the shape preference.</p>
                  </div>
                </div>

                <fieldset class="jk-builder-field">
                  <legend class="visually-hidden">Diamond shape selector</legend>
                  <div class="jk-shape-row">
                    {% assign shapes = 'Oval,Round,Emerald,Pear,Marquise,Cushion' | split: ',' %}
                    {% for shape in shapes %}
                      <label>
                        <input type="radio" name="properties[Diamond shape preference]" value="{{ shape }}" data-builder-choice data-shape-choice="{{ shape | handleize }}" data-price-adjustment="{% if shape == 'Emerald' %}25000{% elsif shape == 'Oval' %}20000{% else %}0{% endif %}" {% if forloop.first %}checked{% endif %}>
                        <span class="jk-shape-chip"><i class="jk-shape-icon jk-shape-icon--{{ shape | handleize }}" aria-hidden="true"></i>{{ shape }}</span>
                      </label>
                    {% endfor %}
                  </div>
                </fieldset>
              </div>

              <div class="jk-builder-step">
                <div class="jk-builder-step__header">
                  <span class="jk-builder-step__number">{% if product.has_only_default_variant %}03{% else %}04{% endif %}</span>
                  <div>
                    <h3>Carat slider</h3>
                    <p>Estimate diamond presence while keeping checkout tied to the chosen variant.</p>
                  </div>
                </div>

                <div class="jk-builder-field">
                  <label for="CaratPreference-{{ section.id }}">Carat preference</label>
                  <div class="jk-range-row">
                    <input id="CaratPreference-{{ section.id }}" type="range" min="0.5" max="5" step="0.25" value="1" name="properties[Carat preference]" data-carat-input data-builder-choice>
                    <output for="CaratPreference-{{ section.id }}" data-carat-output>1.00 ct</output>
                  </div>
                </div>
              </div>

              <div class="jk-builder-step">
                <div class="jk-builder-step__header">
                  <span class="jk-builder-step__number">{% if product.has_only_default_variant %}04{% else %}05{% endif %}</span>
                  <div>
                    <h3>Diamond type selector</h3>
                    <p>Choose the stone pathway for consultation and order preparation.</p>
                  </div>
                </div>

                <fieldset class="jk-builder-field">
                  <legend class="visually-hidden">Diamond type selector</legend>
                  <div class="jk-choice-grid jk-choice-grid--diamond">
                    <label><input type="radio" name="properties[Diamond type preference]" value="Lab-grown diamond" data-builder-choice data-price-adjustment="0" checked><span>Lab-grown diamond</span></label>
                    <label><input type="radio" name="properties[Diamond type preference]" value="Premium lab-grown diamond" data-builder-choice data-price-adjustment="75000"><span>Premium lab-grown</span></label>
                    <label><input type="radio" name="properties[Diamond type preference]" value="Natural diamond consultation" data-builder-choice data-price-adjustment="185000"><span>Natural consult</span></label>
                  </div>
                </fieldset>
              </div>

              {% if is_ring_product %}
                <div class="jk-builder-step">
                  <div class="jk-builder-step__header">
                    <span class="jk-builder-step__number">{% if product.has_only_default_variant %}05{% else %}06{% endif %}</span>
                    <div>
                      <h3>Ring size selector</h3>
                      <p>Choose a known size or open the Joyari size guide.</p>
                    </div>
                  </div>

                  {% liquid
                    assign ring_size_select_id = 'RingSize-' | append: section.id
                    assign ring_size_modal_id = 'RingSizeGuide-' | append: section.id
                  %}
                  {% render 'ring-size-selector', select_id: ring_size_select_id, modal_id: ring_size_modal_id %}

                  <div class="jk-builder-field">
                    <label for="Engraving-{{ section.id }}">Optional engraving</label>
                    <input id="Engraving-{{ section.id }}" type="text" name="properties[Engraving]" maxlength="28" placeholder="Initials, date, or private note">
                  </div>
                </div>
              {% endif %}

              <div class="jk-builder-price-summary" aria-live="polite">
                <div>
                  <span>Selected variant base price</span>
                  <strong data-variant-price>{{ selected_variant.price | money }}</strong>
                </div>
                <div>
                  <span>Builder choice estimate</span>
                  <strong data-builder-adjustment>{{ 0 | money }}</strong>
                </div>
                <div class="jk-builder-total jk-builder-total--grand">
                  <span>Live price estimate</span>
                  <strong data-estimate-total>{{ selected_variant.price | money }}</strong>
                </div>
              </div>

              <p class="jk-builder-note">Checkout submits the selected Shopify variant. Builder choices are saved as line item properties so Joyari can confirm every detail before crafting.</p>

              <div class="jk-product-actions">
                <button type="submit" name="add" class="jk-button jk-button--primary jk-add-to-cart" data-add-to-cart {% unless selected_variant.available %}disabled{% endunless %}>
                  {% if selected_variant.available %}
                    {{ 'products.product.add_to_cart' | t }}
                  {% else %}
                    {{ 'products.product.sold_out' | t }}
                  {% endif %}
                </button>
                <p class="jk-availability" data-availability>
                  {% if selected_variant.available %}
                    Available for secure checkout
                  {% else %}
                    This configuration is currently unavailable
                  {% endif %}
                </p>
              </div>
            </div>
          {% endform %}

          <div class="jk-builder-trust-grid" aria-label="Joyari trust badges">
            <span class="jk-trust-badge">Free resizing</span>
            <span class="jk-trust-badge">Lifetime warranty</span>
            <span class="jk-trust-badge">Secure checkout</span>
            <span class="jk-trust-badge">Ethical lab diamonds</span>
          </div>

          <div class="jk-accordions">
            <details open>
              <summary>Delivery and production</summary>
              <p>Joyari pieces are made to order with clear communication, secure packaging, and tracked delivery. Production timelines can be adjusted in your Shopify product copy.</p>
            </details>
            <details>
              <summary>Warranty and free resizing</summary>
              <p>Use your final store policy in Shopify admin. This section is designed for lifetime warranty, resizing eligibility, and aftercare details.</p>
            </details>
            <details>
              <summary>Diamond certification</summary>
              <p>Where applicable, diamond certificate details and stone specifications should be included in the product description or metafields.</p>
            </details>
            <details>
              <summary>Ethical lab-grown diamonds</summary>
              <p>Lab-grown diamonds offer traceable brilliance with the same optical beauty customers expect from fine diamond jewellery.</p>
            </details>
          </div>
        </div>
      </div>
    </div>

    <div class="jk-product-story">
      <div>
        <p class="jk-eyebrow">Product storytelling</p>
        <h2>Made to feel personal from every angle</h2>
      </div>
      <div class="rte">
        {% if product.description != blank %}
          {{ product.description }}
        {% else %}
          <p>Use this space for diamond specifications, metal details, setting notes, certification information, and the emotional story behind each Joyari piece.</p>
        {% endif %}
      </div>
    </div>

    <div class="jk-product-trust-row" aria-label="Trust badges">
      <span>Free resizing</span>
      <span>Lifetime warranty</span>
      <span>Secure checkout</span>
      <span>Ethical lab diamonds</span>
    </div>

    <div class="jk-mobile-atc" data-mobile-atc>
      <div>
        <span>{{ product.title }}</span>
        <strong data-estimate-total>{{ selected_variant.price | money }}</strong>
      </div>
      <button type="submit" name="add" form="{{ product_form_id }}" class="jk-button jk-button--primary" data-add-to-cart {% unless selected_variant.available %}disabled{% endunless %}>
        {% if selected_variant.available %}
          {{ 'products.product.add_to_cart' | t }}
        {% else %}
          {{ 'products.product.sold_out' | t }}
        {% endif %}
      </button>
    </div>
  {% else %}
    <div class="jk-section__header">
      <p class="jk-eyebrow">Joyari Krafted</p>
      <h1>Product details</h1>
      <p>Add a product in Shopify admin to activate the luxury product builder.</p>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Product template",
  "tag": "section",
  "class": "shopify-section--product-template",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_sku",
      "label": "Show SKU",
      "default": true
    },
    {
      "type": "text",
      "id": "builder_heading",
      "label": "Builder heading",
      "default": "Design your Joyari setting"
    },
    {
      "type": "text",
      "id": "scarcity_text",
      "label": "Production capacity message",
      "default": "Made to order in limited bench capacity each week."
    },
    {
      "type": "number",
      "id": "carat_quarter_premium",
      "label": "Estimate increase per 0.25ct above 1ct, in cents",
      "default": 18500
    }
  ]
}
{% endschema %}
