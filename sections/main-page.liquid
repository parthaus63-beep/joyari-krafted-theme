<section class="jk-section jk-main-page">
  <div class="jk-page-shell">
    {% if section.settings.show_title %}
      <p class="jk-eyebrow">{{ settings.brand_name | default: shop.name }}</p>
      <h1>{{ page.title | default: 'Page' }}</h1>
    {% endif %}

    <div class="rte">
      {% if page.content != blank %}
        {{ page.content }}
      {% else %}
        <p>Joyari Krafted offers private guidance for fine lab-grown diamond jewellery, engagement rings, custom design, sizing, care, and after-purchase support.</p>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main page",
  "tag": "section",
  "class": "shopify-section--main-page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show page title",
      "default": true
    }
  ]
}
{% endschema %}
