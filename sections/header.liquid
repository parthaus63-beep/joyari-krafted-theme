{% liquid
  assign primary_menu = section.settings.menu
  if primary_menu.links == blank and section.settings.menu != blank
    assign primary_menu = linklists[section.settings.menu]
  endif
  if primary_menu.links == blank
    assign primary_menu = linklists['main-menu']
  endif

  assign brand_label = section.settings.logo_text | default: settings.brand_name | default: shop.name
  assign wishlist_url = routes.root_url
  assign has_wishlist_link = false

  if section.settings.wishlist_page != blank
    assign selected_wishlist_page = section.settings.wishlist_page
    if selected_wishlist_page.url != blank
      assign wishlist_url = selected_wishlist_page.url
      assign has_wishlist_link = true
    else
      assign selected_wishlist_page = pages[section.settings.wishlist_page]
      if selected_wishlist_page != blank
        assign wishlist_url = selected_wishlist_page.url
        assign has_wishlist_link = true
      endif
    endif
  endif

  assign current_currency = 'AUD'
%}

{%- comment -%}
  Loads Shopify's versioned stylesheet from the header as a storefront-safe fallback.
  The layout also uses the versioned asset, but older fixed CSS links can linger in
  Shopify's storefront cache briefly after GitHub sync.
{%- endcomment -%}
{{ 'theme.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} .jk-header__actions {
    align-items: center;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .jk-header-icon-link,
  #shopify-section-{{ section.id }} .jk-currency-selector {
    position: relative;
    display: inline-grid !important;
    place-items: center;
    width: 42px;
    min-width: 42px;
    height: 42px;
    min-height: 42px;
    padding: 0;
    border: 1px solid rgba(198, 167, 105, .38);
    border-radius: 999px;
    background: rgba(255, 255, 255, .9);
    color: #111111;
    box-shadow: 0 10px 24px rgba(17, 17, 17, .045);
  }

  #shopify-section-{{ section.id }} .jk-header-icon-link svg {
    width: 19px;
    height: 19px;
  }

  #shopify-section-{{ section.id }} .jk-cart-link__badge {
    position: absolute;
    top: -7px;
    right: -7px;
    display: grid !important;
    place-items: center;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border: 2px solid #FFFFFF;
    border-radius: 999px;
    background: #111111;
    color: #FFFFFF;
    font-size: .67rem;
    font-weight: 850;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .jk-currency-selector {
    width: auto;
    min-width: 68px;
    padding: 0 28px 0 14px;
    font-size: .74rem;
    font-weight: 850;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  @media (max-width: 1120px) {
    #shopify-section-{{ section.id }} .jk-currency-selector,
    #shopify-section-{{ section.id }} .jk-header-icon-link--wishlist {
      display: none !important;
    }
  }

  @media (max-width: 820px) {
    #shopify-section-{{ section.id }} .jk-header__actions {
      display: flex !important;
      gap: 6px !important;
    }

    #shopify-section-{{ section.id }} .jk-header-icon-link--search,
    #shopify-section-{{ section.id }} .jk-account-link,
    #shopify-section-{{ section.id }} .jk-cart-link {
    display: inline-grid !important;
      width: 38px !important;
      min-width: 38px !important;
      height: 38px !important;
      min-height: 38px !important;
    }

    #shopify-section-{{ section.id }} .jk-currency-selector,
    #shopify-section-{{ section.id }} .jk-header-currency-form,
    #shopify-section-{{ section.id }} .jk-header-icon-link--wishlist {
      display: none !important;
    }
  }
</style>

{% if section.settings.show_announcement and settings.announcement_text != blank %}
  <div class="jk-announcement" role="status">
    <span>{{ settings.announcement_text }}</span>
  </div>
{% endif %}

<header class="jk-header" data-header>
  <div class="jk-header__inner">
    <button class="jk-nav-toggle" type="button" aria-controls="JoyariMobileMenu-{{ section.id }}" aria-expanded="false" data-nav-toggle>
      <span></span>
      <span></span>
      <span></span>
      <span class="visually-hidden">Open menu</span>
    </button>

    <a class="jk-brand{% if section.settings.logo != blank %} jk-brand--image{% endif %}" href="{{ routes.root_url }}" aria-label="{{ brand_label | escape }}" style="--jk-logo-width: {{ section.settings.logo_width | default: 180 }}px;">
      {% if section.settings.logo != blank %}
        <span class="jk-brand__logo">
          {{ section.settings.logo | image_url: width: 720 | image_tag: class: 'jk-brand__logo-image', loading: 'eager', widths: '120, 180, 240, 320, 420, 560, 720', sizes: '(max-width: 820px) 150px, var(--jk-logo-width)', alt: brand_label }}
        </span>
      {% else %}
        <span class="jk-brand__mark" aria-hidden="true">JK</span>
        <span class="jk-brand__name">{{ brand_label }}</span>
      {% endif %}
    </a>

    <nav id="JoyariPrimaryNav-{{ section.id }}" class="jk-nav" aria-label="Primary navigation">
      {% if primary_menu.links.size > 0 %}
        {% for link in primary_menu.links %}
          {% liquid
            assign desktop_dropdown_id = 'JoyariDesktopNav-' | append: section.id | append: '-' | append: forloop.index
          %}

          {% if link.links.size > 0 %}
            <div class="jk-nav__item jk-nav__item--dropdown" data-desktop-dropdown data-desktop-dropdown-target="{{ desktop_dropdown_id }}">
              <div class="jk-nav__parent">
                <a href="{{ link.url }}" class="jk-nav__link" data-desktop-dropdown-link data-menu-link>{{ link.title }}</a>
                <button class="jk-nav__dropdown-toggle" type="button" aria-expanded="false" aria-controls="{{ desktop_dropdown_id }}" data-desktop-dropdown-toggle>
                  <span class="visually-hidden">Open {{ link.title }} menu</span>
                  <svg viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1.5 6 6.5l5-5"></path></svg>
                </button>
              </div>
            </div>
          {% else %}
            <a href="{{ link.url }}" class="jk-nav__link" data-menu-link>{{ link.title }}</a>
          {% endif %}
        {% endfor %}
      {% endif %}
    </nav>

    <div class="jk-header__actions">
      <a class="jk-header-icon-link jk-header-icon-link--search" href="{{ routes.search_url }}" aria-label="Search">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="5.8"></circle>
          <path d="m15 15 4.4 4.4"></path>
        </svg>
        <span class="jk-header-icon-link__label">Search</span>
      </a>
      <a class="jk-account-link jk-header-icon-link" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" aria-label="{% if customer %}Account{% else %}Sign in{% endif %}">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 12.5a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"></path>
          <path d="M4.5 20a7.5 7.5 0 0 1 15 0"></path>
        </svg>
        <span class="jk-header-icon-link__label">{% if customer %}Account{% else %}Sign in{% endif %}</span>
      </a>
      {% if has_wishlist_link %}
        <a class="jk-header-icon-link jk-header-icon-link--wishlist" href="{{ wishlist_url }}" aria-label="Wishlist">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 20.5s-7.2-4.6-8.7-9A4.5 4.5 0 0 1 11.2 7l.8 1 .8-1a4.5 4.5 0 0 1 7.9 4.5c-1.5 4.4-8.7 9-8.7 9Z"></path>
          </svg>
          <span class="jk-header-icon-link__label">Wishlist</span>
        </a>
      {% endif %}
      <a class="jk-cart-link jk-header-icon-link" href="{{ routes.cart_url }}" aria-label="{{ 'general.cart.cart' | t }}">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6.5 7.5h11l-.8 12H7.3l-.8-12Z"></path>
          <path d="M9 7.5a3 3 0 0 1 6 0"></path>
        </svg>
        <span class="jk-header-icon-link__label">Cart</span>
        <strong class="jk-cart-link__badge" aria-label="{{ cart.item_count }} items in cart">{{ cart.item_count }}</strong>
      </a>
      {% if localization.available_countries.size > 1 %}
        {% form 'localization', class: 'jk-header-currency-form' %}
          <label class="visually-hidden" for="HeaderCurrency-{{ section.id }}">Currency selector</label>
          <select id="HeaderCurrency-{{ section.id }}" class="jk-currency-selector" name="country_code" aria-label="Currency selector" onchange="this.form.submit()">
            {% for country in localization.available_countries %}
              <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                {{ country.currency.iso_code }}
              </option>
            {% endfor %}
          </select>
        {% endform %}
      {% else %}
        <span class="jk-currency-selector" aria-label="Currency selector">{{ current_currency }}</span>
      {% endif %}
    </div>
  </div>

  {% if section.settings.show_assurance and section.settings.assurance_text != blank %}
    <div class="jk-header__assurance">
      <span>{{ section.settings.assurance_text }}</span>
    </div>
  {% endif %}
</header>

{% if primary_menu.links.size > 0 %}
  <div class="jk-desktop-dropdown-layer" data-desktop-dropdown-layer>
    {% for link in primary_menu.links %}
      {% if link.links.size > 0 %}
        {% liquid
          assign desktop_dropdown_id = 'JoyariDesktopNav-' | append: section.id | append: '-' | append: forloop.index
        %}

        <div id="{{ desktop_dropdown_id }}" class="jk-nav-dropdown" aria-label="{{ link.title }} menu" aria-hidden="true" data-desktop-dropdown-panel>
          <div class="jk-nav-dropdown__panel">
            <div class="jk-nav-dropdown__header">
              <span class="jk-nav-dropdown__eyebrow">Joyari Krafted</span>
              <a class="jk-nav-dropdown__title" href="{{ link.url }}" data-menu-link>View all {{ link.title }}</a>
            </div>

            <div class="jk-nav-dropdown__inner">
              {% for child_link in link.links %}
                {% if child_link.links.size > 0 %}
                  <div class="jk-nav-dropdown__group">
                    <a class="jk-nav-dropdown__heading" href="{{ child_link.url }}" data-menu-link>{{ child_link.title }}</a>
                    <div class="jk-nav-dropdown__children">
                      {% for grandchild_link in child_link.links %}
                        <a class="jk-nav-dropdown__link" href="{{ grandchild_link.url }}" data-menu-link>{{ grandchild_link.title }}</a>
                      {% endfor %}
                    </div>
                  </div>
                {% else %}
                  <a class="jk-nav-dropdown__link" href="{{ child_link.url }}" data-menu-link>{{ child_link.title }}</a>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
{% endif %}

<div id="JoyariMobileMenu-{{ section.id }}" class="jk-mobile-drawer" hidden data-mobile-drawer>
  <button type="button" class="jk-mobile-drawer__backdrop" aria-label="Close menu" data-nav-close></button>
  <div class="jk-mobile-drawer__panel" role="dialog" aria-modal="true" aria-label="Mobile navigation">
    <div class="jk-mobile-drawer__header">
      <span class="jk-mobile-drawer__title">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: 420 | image_tag: class: 'jk-mobile-drawer__logo', loading: 'eager', widths: '120, 180, 240, 320, 420', sizes: '160px', alt: brand_label }}
        {% else %}
          {{ brand_label }}
        {% endif %}
      </span>
      <button type="button" class="jk-mobile-drawer__close" aria-label="Close menu" data-nav-close>
        <span aria-hidden="true">&times;</span>
      </button>
    </div>

    <nav class="jk-mobile-menu" aria-label="Mobile navigation links">
      {% if primary_menu.links.size > 0 %}
        {% for link in primary_menu.links %}
          {% liquid
            assign mobile_submenu_id = 'JoyariMobileSubmenu-' | append: section.id | append: '-' | append: forloop.index
          %}

          {% if link.links.size > 0 %}
            <div class="jk-mobile-menu-group" data-mobile-menu-group>
              <button
                type="button"
                class="jk-mobile-menu__link jk-mobile-menu__link--parent"
                aria-expanded="false"
                aria-controls="{{ mobile_submenu_id }}"
                data-mobile-submenu-toggle
              >
                <span>{{ link.title }}</span>
                <svg viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1.5 6 6.5l5-5"></path></svg>
              </button>

              <div id="{{ mobile_submenu_id }}" class="jk-mobile-submenu" hidden data-mobile-submenu>
                <a class="jk-mobile-submenu__all" href="{{ link.url }}" data-nav-link data-menu-link>View all {{ link.title }}</a>
                {% for child_link in link.links %}
                  {% if child_link.links.size > 0 %}
                    <div class="jk-mobile-submenu__group">
                      <a class="jk-mobile-submenu__heading" href="{{ child_link.url }}" data-nav-link data-menu-link>{{ child_link.title }}</a>
                      <div class="jk-mobile-submenu__children">
                        {% for grandchild_link in child_link.links %}
                          <a href="{{ grandchild_link.url }}" data-nav-link data-menu-link>{{ grandchild_link.title }}</a>
                        {% endfor %}
                      </div>
                    </div>
                  {% else %}
                    <a href="{{ child_link.url }}" data-nav-link data-menu-link>{{ child_link.title }}</a>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          {% else %}
            <a href="{{ link.url }}" class="jk-mobile-menu__link" data-nav-link data-menu-link>{{ link.title }}</a>
          {% endif %}
        {% endfor %}
      {% endif %}
    </nav>

    <div class="jk-mobile-drawer__utility">
      <a href="{{ routes.search_url }}" data-nav-link>Search</a>
      <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" data-nav-link>{% if customer %}Account{% else %}Sign in{% endif %}</a>
      {% if has_wishlist_link %}
        <a href="{{ wishlist_url }}" data-nav-link>Wishlist</a>
      {% endif %}
      <a href="{{ routes.cart_url }}" data-nav-link>Cart{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</a>
      <span>Currency {{ current_currency }}</span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "Joyari Krafted"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Choose a transparent PNG or refined wordmark. The text logo is used when no image is selected."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 90,
      "max": 280,
      "step": 10,
      "unit": "px",
      "default": 180
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "page",
      "id": "wishlist_page",
      "label": "Wishlist page"
    },
    {
      "type": "checkbox",
      "id": "show_assurance",
      "label": "Show assurance line",
      "default": true
    },
    {
      "type": "text",
      "id": "assurance_text",
      "label": "Assurance line",
      "default": "Certified lab-grown diamonds · insured delivery · private guidance"
    }
  ],
  "blocks": [
    {
      "type": "mega_menu",
      "name": "Mega menu feature",
      "settings": [
        {
          "type": "text",
          "id": "menu_title",
          "label": "Top-level menu title",
          "info": "Match the title of a top-level Shopify menu item, for example Engagement Rings."
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Menu eyebrow",
          "default": "Joyari Krafted"
        },
        {
          "type": "text",
          "id": "menu_note",
          "label": "Short menu note",
          "default": "Explore refined jewellery paths, private guidance, and made-to-order details."
        },
        {
          "type": "image_picker",
          "id": "feature_image",
          "label": "Featured collection image"
        },
        {
          "type": "text",
          "id": "feature_image_alt",
          "label": "Featured image alt text"
        },
        {
          "type": "image_picker",
          "id": "lifestyle_image",
          "label": "Promotional or lifestyle image"
        },
        {
          "type": "text",
          "id": "lifestyle_image_alt",
          "label": "Lifestyle image alt text"
        },
        {
          "type": "text",
          "id": "cta_eyebrow",
          "label": "CTA eyebrow",
          "default": "Private guidance"
        },
        {
          "type": "text",
          "id": "cta_heading",
          "label": "CTA heading",
          "default": "Design your ring"
        },
        {
          "type": "textarea",
          "id": "cta_text",
          "label": "CTA text",
          "default": "Refine stones, settings, proportions, and meaningful details with a calm luxury experience."
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA button label",
          "default": "Design Your Ring"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "CTA link"
        }
      ]
    }
  ],
  "max_blocks": 8
}
{% endschema %}
