{% liquid
  assign grid_collection = section.settings.collection
  if template.name == 'collection' and grid_collection == blank
    assign grid_collection = collection
  endif
  assign grid_heading = section.settings.heading
  if grid_heading == blank and grid_collection != blank
    assign grid_heading = grid_collection.title
  endif
%}

{% if template.name == 'collection' %}
  <style>
    /* Joyari collection critical luxury UI */
    .jk-product-grid-section--collection{width:min(1840px,calc(100vw - 32px));margin-inline:auto;padding:clamp(20px,2.8vw,46px) 0 clamp(70px,8vw,122px);color:#111111}.jk-product-grid-section--collection .jk-collection-editorial{display:none}.jk-collection-hero{min-height:clamp(320px,39vw,540px);border-radius:6px!important;border-color:rgba(198,167,105,.28)!important}.jk-collection-shop{display:grid;gap:18px}.jk-collection-toolbar,.jk-active-filters{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;padding:16px 0;border-top:1px solid rgba(198,167,105,.22);border-bottom:1px solid rgba(198,167,105,.22)}.jk-collection-toolbar__summary,.jk-active-filters{display:flex;align-items:center;justify-content:flex-start;gap:14px;flex-wrap:wrap}.jk-filter-toggle,.jk-filter-close,.jk-filter-reset,.jk-filter-chip{min-height:38px;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:0 14px;border:1px solid rgba(198,167,105,.42)!important;border-radius:999px;background:#FFFFFF!important;color:#111111!important;font-size:.84rem;font-weight:850}.jk-filter-chip{background:rgba(198,167,105,.12)!important}.jk-filter-reset{color:#0F3D2E!important}.jk-collection-sort{display:inline-flex;align-items:center;gap:10px;color:#111111}.jk-collection-sort span,.jk-filter-group-panel summary,.jk-product-card__meta{color:#0F3D2E!important}.jk-collection-sort select,.jk-filter-price input{min-height:42px;border:1px solid rgba(198,167,105,.42)!important;border-radius:999px;background:#FFFFFF!important;color:#111111!important;padding:0 14px}.jk-collection-shop__layout{display:grid!important;grid-template-columns:minmax(260px,300px) minmax(0,1fr)!important;gap:clamp(22px,2.8vw,44px);align-items:start}.jk-collection-filter-backdrop{display:none!important}.jk-collection-filters{position:sticky!important;top:calc(var(--jk-dropdown-top,132px) + 16px)!important;max-height:calc(100vh - 160px)!important;overflow:auto!important;padding:22px;border:1px solid rgba(198,167,105,.28)!important;border-radius:6px;background:#FFFFFF!important;box-shadow:0 20px 54px rgba(17,17,17,.07)}.jk-collection-filters__header{display:flex;align-items:start;justify-content:space-between;gap:16px;padding-bottom:18px;border-bottom:1px solid rgba(198,167,105,.2)}.jk-filter-close{display:none;width:38px;min-width:38px;padding:0;font-size:1.4rem;line-height:1}.jk-collection-filters__form,.jk-filter-group-panel__content{display:grid;gap:12px}.jk-filter-group-panel{border-bottom:1px solid rgba(198,167,105,.18);padding:14px 0}.jk-filter-group-panel summary{cursor:pointer;list-style:none;display:flex;align-items:center;justify-content:space-between;gap:14px;min-height:36px;font-size:.88rem;font-weight:900;text-transform:uppercase}.jk-filter-group-panel summary::-webkit-details-marker{display:none}.jk-filter-group-panel summary::after{content:"+";color:#C6A769;font-family:Georgia,"Times New Roman",serif;font-size:1.25rem}.jk-filter-group-panel[open] summary::after{content:"-"}.jk-filter-option{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:10px;min-height:34px;color:#111111;font-size:.92rem}.jk-filter-option input{width:16px;height:16px;accent-color:#C6A769}.jk-filter-option small{color:#6d675d}.jk-filter-price{display:grid;grid-template-columns:1fr;gap:10px}.jk-filter-price label{display:grid;gap:6px}.jk-collection-filters__actions{display:grid;gap:10px;padding-top:10px}.jk-product-grid--collection{grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:clamp(18px,2vw,28px) clamp(14px,1.6vw,24px)!important}.jk-product-card{border-radius:6px!important;background:#FFFFFF!important;border:1px solid rgba(198,167,105,.2)!important;box-shadow:0 12px 34px rgba(17,17,17,.045)!important}.jk-product-card__media{aspect-ratio:4/5!important;background:radial-gradient(circle at 50% 20%,rgba(255,255,255,.96),transparent 24%),linear-gradient(145deg,#FFFFFF,#F8F6F1 62%,rgba(198,167,105,.2))!important}.jk-product-card__media img{object-fit:cover;transform:scale(1.005)}.jk-product-card__content{padding:18px 18px 22px!important;gap:8px!important}.jk-product-card__meta{font-size:.68rem;font-weight:900;letter-spacing:.11em;text-transform:uppercase}.jk-product-card__title{min-height:2.72em;font-size:clamp(1.02rem,1vw,1.18rem)!important}.jk-product-card__price{color:#C6A769!important;font-size:.95rem!important;font-weight:850!important}.jk-product-card__status{background:#0F3D2E!important;color:#FFFFFF!important}.jk-product-card__quick{background:rgba(255,255,255,.94)!important;border-color:rgba(198,167,105,.48)!important}.jk-collection-empty{grid-column:1/-1;display:grid;place-items:start;gap:14px;min-height:320px;padding:clamp(28px,4vw,56px);border:1px solid rgba(198,167,105,.28);border-radius:6px;background:#FFFFFF}@media(max-width:1280px){.jk-product-grid--collection{grid-template-columns:repeat(3,minmax(0,1fr))!important}}@media(max-width:989px){.jk-product-grid-section--collection{width:min(100%,calc(100vw - 20px))}.jk-collection-shop__layout{display:block!important}.jk-collection-filter-backdrop{position:fixed!important;inset:0;z-index:2147482000;display:block!important;background:rgba(17,17,17,.42);opacity:0;pointer-events:none;transition:opacity .26s var(--jk-ease)}.jk-collection-shop.is-filter-open .jk-collection-filter-backdrop{opacity:1;pointer-events:auto}.jk-collection-filters{position:fixed!important;inset:0 auto 0 0;z-index:2147482001;width:min(430px,92vw);max-height:none!important;height:100vh;height:100dvh;border-radius:0 8px 8px 0;transform:translateX(-105%);transition:transform .32s var(--jk-slow-ease)}.jk-collection-filters.is-open{transform:translateX(0)}.jk-filter-close{display:inline-flex}.jk-product-grid--collection{grid-template-columns:repeat(2,minmax(0,1fr))!important}}@media(max-width:560px){.jk-collection-toolbar,.jk-active-filters{align-items:stretch;flex-direction:column}.jk-collection-sort,.jk-collection-sort select,.jk-filter-toggle{width:100%}.jk-product-grid--collection{grid-template-columns:1fr!important}.jk-product-card__media{aspect-ratio:1/1.15!important}}
  </style>
  <style>
    /* Joyari horizontal filter critical overrides */
    .jk-collection-shop__layout{display:block!important}.jk-collection-filterbar{position:relative;z-index:20;display:flex;align-items:flex-start;justify-content:space-between;gap:14px;padding:14px 0 18px;border-bottom:1px solid rgba(198,167,105,.24)}.jk-collection-filterbar__groups{display:flex;flex-wrap:wrap;align-items:center;gap:10px}.jk-filter-dropdown{position:relative}.jk-filter-dropdown>summary{list-style:none;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px;padding:0 15px;border:1px solid rgba(198,167,105,.42);border-radius:999px;background:#fff;color:#111;cursor:pointer;font-size:.8rem;font-weight:880;text-transform:uppercase;box-shadow:0 10px 28px rgba(17,17,17,.04)}.jk-filter-dropdown>summary::-webkit-details-marker{display:none}.jk-filter-dropdown>summary:after{content:"";width:7px;height:7px;border-right:1.5px solid currentColor;border-bottom:1.5px solid currentColor;transform:rotate(45deg) translateY(-2px)}.jk-filter-dropdown[open]>summary{border-color:#C6A769;background:rgba(198,167,105,.12)}.jk-filter-dropdown__panel{position:absolute;top:calc(100% + 10px);left:0;z-index:60;width:min(370px,calc(100vw - 32px));max-height:min(58vh,520px);overflow:auto;padding:16px;border:1px solid rgba(198,167,105,.34);border-radius:8px;background:#fff;box-shadow:0 28px 70px rgba(17,17,17,.16)}.jk-filter-option-set{display:grid;gap:8px;margin:0;padding:0;border:0}.jk-filter-option--client{display:grid;grid-template-columns:auto 1fr;align-items:center;gap:10px;min-height:40px;padding:8px 10px;border:1px solid rgba(198,167,105,.22);border-radius:6px;background:#fff;color:#111;cursor:pointer}.jk-filter-option--client input{width:16px;height:16px;accent-color:#C6A769}.jk-filter-option--client input:checked+span{color:#0F3D2E;font-weight:850}.jk-filter-clear{align-self:center;min-height:40px;padding:0 14px;border:1px solid rgba(198,167,105,.42);border-radius:999px;background:#fff;color:#0F3D2E;font-size:.78rem;font-weight:880;text-transform:uppercase}.jk-active-filters[hidden],.jk-filter-clear[hidden],.jk-collection-empty--client[hidden]{display:none!important}.jk-product-card.is-filter-hidden{display:none!important}.jk-collection-filters,.jk-collection-filter-backdrop{display:none!important}@media(max-width:989px){.jk-collection-filterbar,.jk-collection-sort--desktop{display:none!important}.jk-collection-filter-backdrop{position:fixed!important;inset:0;z-index:2147482000;display:block!important;background:rgba(17,17,17,.44);opacity:0;pointer-events:none}.jk-collection-shop.is-filter-open .jk-collection-filter-backdrop{opacity:1;pointer-events:auto}.jk-collection-filters{position:fixed!important;inset:0 auto 0 0;z-index:2147482001;display:flex!important;flex-direction:column;width:min(440px,94vw);height:100vh;height:100dvh;max-height:none!important;padding:18px;border:0!important;border-radius:0 10px 10px 0;background:#fff!important;box-shadow:24px 0 80px rgba(17,17,17,.28);overflow:hidden;transform:translateX(-105%)}.jk-collection-filters.is-open{transform:translateX(0)}.jk-collection-filters__form{flex:1 1 auto;min-height:0;overflow:auto}.jk-filter-dropdown{border-bottom:1px solid rgba(198,167,105,.18);padding:8px 0}.jk-filter-dropdown>summary{width:100%;justify-content:space-between;min-height:46px;border:0;border-radius:0;box-shadow:none;background:transparent;padding-inline:0}.jk-filter-dropdown__panel{position:static;width:100%;max-height:none;padding:8px 0 12px;border:0;border-radius:0;box-shadow:none}}
  </style>
{% endif %}

<section class="jk-section jk-product-grid-section{% if template.name == 'collection' %} jk-product-grid-section--collection{% endif %}">
  {% if template.name == 'collection' %}
    {% liquid
      assign collection_banner = section.settings.collection_banner_image
      if collection_banner == blank and grid_collection.image != blank
        assign collection_banner = grid_collection.image
      endif
      assign collection_banner_alt = section.settings.collection_banner_image_alt | default: grid_heading | default: 'Joyari collection'
    %}
    <div class="jk-collection-hero">
      <div class="jk-collection-hero__media">
        {% if collection_banner != blank %}
          {{ collection_banner | image_url: width: 2200 | image_tag: loading: 'eager', widths: '720, 1000, 1400, 1800, 2200', sizes: '100vw', alt: collection_banner_alt, class: 'jk-collection-hero__image' }}
        {% else %}
          <span class="jk-collection-visual-placeholder jk-collection-visual-placeholder--wide" aria-hidden="true"></span>
        {% endif %}
      </div>
      <div class="jk-collection-hero__content">
        <p class="jk-eyebrow">{{ section.settings.collection_banner_eyebrow }}</p>
        <h1>{{ grid_heading | default: 'Luxury diamond jewellery' }}</h1>
        {% if section.settings.subheading != blank %}
          <p>{{ section.settings.subheading }}</p>
        {% elsif grid_collection.description != blank %}
          <p>{{ grid_collection.description | strip_html | truncate: 220 }}</p>
        {% endif %}
      </div>
    </div>
  {% endif %}

  <div class="jk-section__header jk-section__header--split">
    <div>
      {% if section.settings.eyebrow != blank %}
        <p class="jk-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if template.name == 'collection' %}
        <h2 class="jk-grid-heading">{{ section.settings.grid_heading | default: 'The collection edit' }}</h2>
      {% else %}
        <h1 class="jk-grid-heading">{{ grid_heading | default: 'Luxury diamond jewellery' }}</h1>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p>{{ section.settings.subheading }}</p>
      {% elsif grid_collection.description != blank %}
        <p>{{ grid_collection.description | strip_html | truncate: 180 }}</p>
      {% endif %}
    </div>
    {% if grid_collection != blank %}
      <a class="jk-text-link" href="{{ grid_collection.url }}">View collection</a>
    {% endif %}
  </div>

  {% if template.name == 'collection' %}
    <div class="jk-collection-editorial">
      <article class="jk-collection-editorial__panel">
        <div class="jk-collection-editorial__media">
          {% if section.settings.collection_intro_image != blank %}
            {{ section.settings.collection_intro_image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '420, 640, 820, 1100', sizes: '(min-width: 900px) 45vw, 100vw', alt: section.settings.collection_intro_image_alt, class: 'jk-collection-editorial__image' }}
          {% else %}
            <span class="jk-collection-visual-placeholder" aria-hidden="true"></span>
          {% endif %}
        </div>
        <div>
          <p class="jk-card-badge">{{ section.settings.collection_intro_eyebrow }}</p>
          <h3>{{ section.settings.collection_intro_heading }}</h3>
          <p>{{ section.settings.collection_intro_text }}</p>
        </div>
      </article>

      <article class="jk-collection-editorial__panel">
        <div class="jk-collection-editorial__media">
          {% if section.settings.collection_lifestyle_image != blank %}
            {{ section.settings.collection_lifestyle_image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '420, 640, 820, 1100', sizes: '(min-width: 900px) 45vw, 100vw', alt: section.settings.collection_lifestyle_image_alt, class: 'jk-collection-editorial__image' }}
          {% else %}
            <span class="jk-collection-visual-placeholder jk-collection-visual-placeholder--box" aria-hidden="true"></span>
          {% endif %}
        </div>
        <div>
          <p class="jk-card-badge">{{ section.settings.collection_lifestyle_eyebrow }}</p>
          <h3>{{ section.settings.collection_lifestyle_heading }}</h3>
          <p>{{ section.settings.collection_lifestyle_text }}</p>
        </div>
      </article>
    </div>
  {% endif %}

  {% if template.name == 'collection' and grid_collection != blank %}
    {% liquid
      assign current_sort = collection.sort_by | default: collection.default_sort_by
      assign metal_entries = 'Platinum::platinum;;Yellow Gold::yellow gold,gold,18k yellow gold,14k yellow gold,10k yellow gold;;White Gold::white gold;;Rose Gold::rose gold;;Silver::silver'
      assign ring_style_entries = 'Solitaire::solitaire;;Hidden Halo::hidden halo;;Halo::halo;;Three Stone::three stone,trilogy;;Toi et Moi::toi et moi;;Vintage::vintage;;Bezel::bezel;;Engagement Ring::engagement ring,engagement rings'
      assign diamond_shape_entries = 'Round::round;;Oval::oval;;Pear::pear;;Emerald::emerald;;Cushion::cushion;;Radiant::radiant;;Marquise::marquise;;Princess::princess'
      assign setting_style_entries = 'Solitaire::solitaire;;Hidden Halo::hidden halo;;Halo::halo;;Bezel::bezel;;Prong::prong,claw;;Pave::pave,pavé;;Cathedral::cathedral'
      assign band_style_entries = 'Plain::plain,minimal;;Pave::pave,pavé;;Eternity::eternity;;Split Shank::split shank;;Twisted::twisted,twist;;Tapered::tapered'
      assign carat_entries = '0.50 ct::0.5,0.50,.50,0.50 ct;;1.00 ct::1.0,1.00,1 ct,1.00 ct;;1.50 ct::1.5,1.50,1.50 ct;;2.00 ct::2.0,2.00,2 ct,2.00 ct;;2.50 ct::2.5,2.50,2.50 ct;;3.00 ct::3.0,3.00,3 ct,3.00 ct'
      assign ring_size_entries = '4::size 4,ring size 4,us 4;;5::size 5,ring size 5,us 5;;6::size 6,ring size 6,us 6;;7::size 7,ring size 7,us 7;;8::size 8,ring size 8,us 8;;9::size 9,ring size 9,us 9;;10::size 10,ring size 10,us 10'
      assign availability_entries = 'In stock::available;;Out of stock::sold-out'
      assign ready_entries = 'Ready to ship::ready to ship,ready-to-ship,ready now'
    %}

    <div class="jk-collection-shop" data-collection-shop>
      <div class="jk-collection-toolbar">
        <div class="jk-collection-toolbar__summary">
          <button type="button" class="jk-filter-toggle" data-collection-filter-open aria-controls="CollectionFiltersPanel-{{ section.id }}" aria-expanded="false">
            Filters <span data-client-selected-count></span>
          </button>
          <span data-collection-count>{{ collection.products_count }} {% if collection.products_count == 1 %}design{% else %}designs{% endif %}</span>
        </div>

        <label class="jk-collection-sort jk-collection-sort--desktop" for="CollectionSort-{{ section.id }}">
          <span>Sort</span>
          <select id="CollectionSort-{{ section.id }}" data-client-sort>
            <option value="featured" {% if current_sort == collection.default_sort_by or current_sort == 'manual' %}selected{% endif %}>Featured</option>
            <option value="newest" {% if current_sort == 'created-descending' %}selected{% endif %}>Newest</option>
            <option value="price-ascending" {% if current_sort == 'price-ascending' %}selected{% endif %}>Price low to high</option>
            <option value="price-descending" {% if current_sort == 'price-descending' %}selected{% endif %}>Price high to low</option>
          </select>
        </label>
      </div>

      <div class="jk-collection-filterbar" aria-label="Collection filters">
        <div class="jk-collection-filterbar__groups">
          {% render 'collection-client-filter-group', label: 'Metal', group_key: 'metal', entries: metal_entries, mode: 'desktop', section_id: section.id %}
          {% render 'collection-client-filter-group', label: 'Ring style', group_key: 'ring-style', entries: ring_style_entries, mode: 'desktop', section_id: section.id %}
          {% render 'collection-client-filter-group', label: 'Diamond shape', group_key: 'diamond-shape', entries: diamond_shape_entries, mode: 'desktop', section_id: section.id %}
          {% render 'collection-client-filter-group', label: 'Setting style', group_key: 'setting-style', entries: setting_style_entries, mode: 'desktop', section_id: section.id %}
          {% render 'collection-client-filter-group', label: 'Band style', group_key: 'band-style', entries: band_style_entries, mode: 'desktop', section_id: section.id %}
          {% render 'collection-client-filter-group', label: 'Carat range', group_key: 'carat', entries: carat_entries, mode: 'desktop', section_id: section.id %}
          {% render 'collection-client-filter-group', label: 'Price range', group_key: 'price', group_type: 'price', mode: 'desktop', section_id: section.id %}
          {% render 'collection-client-filter-group', label: 'Ring size', group_key: 'ring-size', entries: ring_size_entries, mode: 'desktop', section_id: section.id %}
          {% render 'collection-client-filter-group', label: 'Availability', group_key: 'availability', entries: availability_entries, group_type: 'availability', mode: 'desktop', section_id: section.id %}
          {% render 'collection-client-filter-group', label: 'Ready to ship', group_key: 'ready-to-ship', entries: ready_entries, mode: 'desktop', section_id: section.id %}
        </div>
        <button type="button" class="jk-filter-clear" data-client-clear hidden>Clear all</button>
      </div>

      <div class="jk-active-filters" data-client-active-filters aria-label="Active filters" hidden></div>

      <div class="jk-collection-filter-backdrop" data-collection-filter-close></div>
      <aside id="CollectionFiltersPanel-{{ section.id }}" class="jk-collection-filters" data-collection-filter-drawer aria-label="Collection filters">
        <div class="jk-collection-filters__header">
          <div>
            <p class="jk-eyebrow">Refine</p>
            <h2>Filters</h2>
          </div>
          <button type="button" class="jk-filter-close" data-collection-filter-close aria-label="Close filters">×</button>
        </div>

        <label class="jk-collection-sort jk-collection-sort--mobile" for="CollectionSortMobile-{{ section.id }}">
          <span>Sort</span>
          <select id="CollectionSortMobile-{{ section.id }}" data-client-sort>
            <option value="featured" {% if current_sort == collection.default_sort_by or current_sort == 'manual' %}selected{% endif %}>Featured</option>
            <option value="newest" {% if current_sort == 'created-descending' %}selected{% endif %}>Newest</option>
            <option value="price-ascending" {% if current_sort == 'price-ascending' %}selected{% endif %}>Price low to high</option>
            <option value="price-descending" {% if current_sort == 'price-descending' %}selected{% endif %}>Price high to low</option>
          </select>
        </label>

        <div class="jk-collection-filters__form" data-collection-filter-form>
          {% render 'collection-client-filter-group', label: 'Metal', group_key: 'metal', entries: metal_entries, mode: 'mobile', section_id: section.id %}
          {% render 'collection-client-filter-group', label: 'Ring style', group_key: 'ring-style', entries: ring_style_entries, mode: 'mobile', section_id: section.id %}
          {% render 'collection-client-filter-group', label: 'Diamond shape', group_key: 'diamond-shape', entries: diamond_shape_entries, mode: 'mobile', section_id: section.id %}
          {% render 'collection-client-filter-group', label: 'Setting style', group_key: 'setting-style', entries: setting_style_entries, mode: 'mobile', section_id: section.id %}
          {% render 'collection-client-filter-group', label: 'Band style', group_key: 'band-style', entries: band_style_entries, mode: 'mobile', section_id: section.id %}
          {% render 'collection-client-filter-group', label: 'Carat range', group_key: 'carat', entries: carat_entries, mode: 'mobile', section_id: section.id %}
          {% render 'collection-client-filter-group', label: 'Price range', group_key: 'price', group_type: 'price', mode: 'mobile', section_id: section.id %}
          {% render 'collection-client-filter-group', label: 'Ring size', group_key: 'ring-size', entries: ring_size_entries, mode: 'mobile', section_id: section.id %}
          {% render 'collection-client-filter-group', label: 'Availability', group_key: 'availability', entries: availability_entries, group_type: 'availability', mode: 'mobile', section_id: section.id %}
          {% render 'collection-client-filter-group', label: 'Ready to ship', group_key: 'ready-to-ship', entries: ready_entries, mode: 'mobile', section_id: section.id %}
        </div>

        <div class="jk-collection-filters__actions">
          <button type="button" class="jk-button jk-button--secondary" data-client-clear>Clear all</button>
          <button type="button" class="jk-button jk-button--primary" data-collection-filter-close>View designs</button>
        </div>
      </aside>

      <div class="jk-collection-shop__layout">
        <div class="jk-collection-products">
          {% paginate collection.products by section.settings.product_limit %}
            <div class="jk-product-grid jk-product-grid--collection" data-product-grid>
              {% if collection.products.size > 0 %}
                {% for product in collection.products %}
                  {% capture product_filter_text %}
                    {{ product.title }}
                    {{ product.type }}
                    {{ product.vendor }}
                    {% for tag in product.tags %} {{ tag }}{% endfor %}
                    {% for option in product.options_with_values %}
                      {{ option.name }}
                      {% for value in option.values %} {{ value }}{% endfor %}
                    {% endfor %}
                    {% for variant in product.variants %} {{ variant.title }}{% endfor %}
                  {% endcapture %}
                  <article
                    class="jk-product-card{% unless product.available %} jk-product-card--sold-out{% endunless %}"
                    data-product-card
                    data-filter-index="{{ forloop.index0 }}"
                    data-filter-price="{{ product.price_min }}"
                    data-filter-created="{{ product.created_at | date: '%s' }}"
                    data-filter-available="{% if product.available %}available{% else %}sold-out{% endif %}"
                    data-filter-text="{{ product_filter_text | strip_html | downcase | strip | escape }}"
                  >
                    <a class="jk-product-card__media" href="{{ product.url }}">
                      {% if product.featured_media != blank %}
                        {{ product.featured_media | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900, 1100', sizes: '(min-width: 1280px) 25vw, (min-width: 760px) 33vw, 100vw', alt: product.featured_media.alt | default: product.title }}
                      {% elsif section.settings.fallback_product_image != blank %}
                        {% assign fallback_product_alt = section.settings.fallback_product_image_alt | default: product.title %}
                        {{ section.settings.fallback_product_image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900, 1100', sizes: '(min-width: 1280px) 25vw, (min-width: 760px) 33vw, 100vw', alt: fallback_product_alt }}
                      {% else %}
                        <span class="jk-product-placeholder" aria-hidden="true"></span>
                      {% endif %}
                      {% unless product.available %}
                        <span class="jk-product-card__status">{{ 'products.product.sold_out' | t }}</span>
                      {% endunless %}
                      <span class="jk-product-card__quick">View details</span>
                    </a>
                    <div class="jk-product-card__content">
                      {% if product.type != blank %}
                        <p class="jk-product-card__meta">{{ product.type }}</p>
                      {% endif %}
                      <h2 class="jk-product-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h2>
                      <p class="jk-product-card__price">
                        {% if product.price_varies %}
                          {{ 'products.product.from_price_html' | t: price: product.price_min | money }}
                        {% else %}
                          {{ product.price | money }}
                        {% endif %}
                      </p>
                      <a class="jk-product-card__action" href="{{ product.url }}">Select details</a>
                    </div>
                  </article>
                {% endfor %}
              {% else %}
                <div class="jk-collection-empty">
                  <p class="jk-eyebrow">No designs found</p>
                  <h2>Try a softer filter combination</h2>
                  <p>Reset filters or widen your metal, style, stone shape, carat, or price preferences.</p>
                  <a class="jk-button jk-button--secondary" href="{{ collection.url }}">Reset filters</a>
                </div>
              {% endif %}
              <div class="jk-collection-empty jk-collection-empty--client" data-client-empty hidden>
                <p class="jk-eyebrow">No designs found</p>
                <h2>Try a softer filter combination</h2>
                <p>Clear a filter or widen your metal, style, diamond shape, carat, or price preferences.</p>
                <button type="button" class="jk-button jk-button--secondary" data-client-clear>Clear all filters</button>
              </div>
            </div>

            {% if paginate.pages > 1 %}
              <nav class="jk-pagination" aria-label="Collection pagination">
                {{ paginate | default_pagination }}
              </nav>
            {% endif %}
          {% endpaginate %}
        </div>
      </div>
    </div>
  {% else %}
    <div class="jk-product-grid">
    {% if grid_collection != blank and grid_collection.products_count > 0 %}
      {% for product in grid_collection.products limit: section.settings.product_limit %}
        <article class="jk-product-card{% unless product.available %} jk-product-card--sold-out{% endunless %}">
          <a class="jk-product-card__media" href="{{ product.url }}">
            {% if product.featured_media != blank %}
              {{ product.featured_media | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360, 540, 720, 1000', sizes: '(min-width: 1000px) 33vw, (min-width: 640px) 50vw, 100vw', alt: product.featured_media.alt | default: product.title }}
            {% elsif section.settings.fallback_product_image != blank %}
              {% assign fallback_product_alt = section.settings.fallback_product_image_alt | default: product.title %}
              {{ section.settings.fallback_product_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360, 540, 720, 1000', sizes: '(min-width: 1000px) 33vw, (min-width: 640px) 50vw, 100vw', alt: fallback_product_alt }}
            {% else %}
              <span class="jk-product-placeholder" aria-hidden="true"></span>
            {% endif %}
            {% unless product.available %}
              <span class="jk-product-card__status">{{ 'products.product.sold_out' | t }}</span>
            {% endunless %}
            <span class="jk-product-card__quick">View piece</span>
          </a>
          <div class="jk-product-card__content">
            {% if product.type != blank %}
              <p class="jk-product-card__meta">{{ product.type }}</p>
            {% endif %}
            <h2 class="jk-product-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h2>
            <p class="jk-product-card__price">
              {% if product.price_varies %}
                {{ 'products.product.from_price_html' | t: price: product.price_min | money }}
              {% else %}
                {{ product.price | money }}
              {% endif %}
            </p>
            <a class="jk-product-card__action" href="{{ product.url }}">Select details</a>
          </div>
        </article>
      {% endfor %}
    {% else %}
      {% for index in (1..4) %}
        {% liquid
          assign placeholder_image = blank
          assign placeholder_alt = blank
          case index
            when 1
              assign placeholder_image = section.settings.placeholder_image_1
              assign placeholder_alt = section.settings.placeholder_image_1_alt
            when 2
              assign placeholder_image = section.settings.placeholder_image_2
              assign placeholder_alt = section.settings.placeholder_image_2_alt
            when 3
              assign placeholder_image = section.settings.placeholder_image_3
              assign placeholder_alt = section.settings.placeholder_image_3_alt
            when 4
              assign placeholder_image = section.settings.placeholder_image_4
              assign placeholder_alt = section.settings.placeholder_image_4_alt
          endcase
          assign placeholder_alt = placeholder_alt | default: 'Joyari Krafted diamond jewellery placeholder'
        %}
        <article class="jk-product-card jk-product-card--placeholder">
          <div class="jk-product-card__media">
            {% if placeholder_image != blank %}
              {{ placeholder_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360, 540, 720, 1000', sizes: '(min-width: 1000px) 33vw, (min-width: 640px) 50vw, 100vw', alt: placeholder_alt }}
            {% else %}
              <span class="jk-product-placeholder" aria-hidden="true"></span>
            {% endif %}
            <span class="jk-product-card__quick">View piece</span>
          </div>
          <div class="jk-product-card__content">
            <h2 class="jk-product-card__title">Signature diamond piece {{ index }}</h2>
            <p class="jk-product-card__price">$2,400.00</p>
            <span class="jk-product-card__action">Private preview</span>
          </div>
        </article>
      {% endfor %}
    {% endif %}
  </div>
  {% endif %}
</section>

