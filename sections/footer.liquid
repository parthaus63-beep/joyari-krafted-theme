<footer class="jk-footer{% if section.settings.background_image != blank %} jk-footer--image-bg{% endif %}">
  {% if section.settings.background_image != blank %}
    <div class="jk-footer__background" aria-hidden="true">
      {{ section.settings.background_image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '720, 1000, 1400, 1800', sizes: '100vw', alt: '', class: 'jk-footer__background-image' }}
    </div>
  {% endif %}

  <div class="jk-footer__top">
    <div class="jk-footer__brand">
      <a class="jk-brand jk-brand--footer" href="{{ routes.root_url }}">
        <span class="jk-brand__mark" aria-hidden="true">JK</span>
        <span class="jk-brand__name">{{ settings.brand_name | default: shop.name }}</span>
      </a>
      {% if section.settings.brand_image != blank %}
        <div class="jk-footer__image">
          {{ section.settings.brand_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 900px) 34vw, 100vw', alt: section.settings.brand_image_alt }}
        </div>
      {% endif %}
      <p>{{ section.settings.brand_text }}</p>
      <div class="jk-footer__contact">
        {% if settings.support_email != blank %}
          <a href="mailto:{{ settings.support_email }}">{{ settings.support_email }}</a>
        {% endif %}
        {% if settings.support_phone != blank %}
          <a href="tel:{{ settings.support_phone | remove: ' ' }}">{{ settings.support_phone }}</a>
        {% endif %}
      </div>
    </div>

    <div class="jk-footer__newsletter">
      <p class="jk-eyebrow">{{ section.settings.newsletter_eyebrow }}</p>
      <h2>{{ section.settings.newsletter_heading }}</h2>
      <p>{{ section.settings.newsletter_text }}</p>
      {% form 'customer', class: 'jk-newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="FooterNewsletterEmail">{{ 'general.newsletter.label' | t }}</label>
        <input id="FooterNewsletterEmail" type="email" name="contact[email]" autocorrect="off" autocapitalize="off" autocomplete="email" placeholder="{{ 'general.newsletter.label' | t }}" required>
        <button type="submit">{{ 'general.newsletter.button' | t }}</button>
        {% if form.posted_successfully? %}
          <p class="jk-form-message" tabindex="-1">{{ 'general.newsletter.success' | t }}</p>
        {% endif %}
        {% if form.errors %}
          <p class="jk-form-message jk-form-message--error">{{ form.errors | default_errors }}</p>
        {% endif %}
      {% endform %}
    </div>
  </div>

  <div class="jk-footer__assurance" aria-label="Joyari service standards">
    <span>Certified stone guidance</span>
    <span>Secure checkout</span>
    <span>Insured presentation delivery</span>
    <span>Aftercare support</span>
  </div>

  <div class="jk-footer__links">
    <div>
      <h3>{{ section.settings.menu_title }}</h3>
      {% if section.settings.menu != blank and linklists[section.settings.menu].links.size > 0 %}
        {% for link in linklists[section.settings.menu].links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      {% else %}
        <a href="{{ routes.all_products_collection_url }}">Engagement Rings</a>
        <a href="{{ routes.all_products_collection_url }}">Wedding Bands</a>
        <a href="{{ routes.all_products_collection_url }}">Diamond Jewellery</a>
        <a href="/pages/about">The Atelier</a>
      {% endif %}
    </div>
    <div>
      <h3>Client Care</h3>
      <a href="/pages/contact">Contact</a>
      <a href="/pages/shipping-returns">Shipping & Returns</a>
      <span>Sizing and care guidance</span>
    </div>
    <div>
      <h3>The Joyari Standard</h3>
      {% if settings.instagram_url != blank %}
        <a href="{{ settings.instagram_url }}" rel="noopener" target="_blank">Instagram</a>
      {% else %}
        <span>Instagram</span>
      {% endif %}
      <span>Traceable lab-grown diamonds</span>
      <span>Considered made-to-order pieces</span>
    </div>
  </div>

  <div class="jk-footer__bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ settings.brand_name | default: shop.name }}. All rights reserved.</p>
    <p>Traceable lab-grown diamonds, refined settings, and considered care.</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "brand_text",
      "label": "Brand text",
      "default": "Fine lab-grown diamond jewellery designed for modern romantics, meaningful milestones, and everyday brilliance."
    },
    {
      "type": "image_picker",
      "id": "brand_image",
      "label": "Footer brand image"
    },
    {
      "type": "text",
      "id": "brand_image_alt",
      "label": "Footer image alt text",
      "default": "Joyari Krafted jewellery presentation"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Footer texture / background image"
    },
    {
      "type": "text",
      "id": "newsletter_eyebrow",
      "label": "Newsletter eyebrow",
      "default": "Private access"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Receive private design notes and diamond guidance"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter text",
      "default": "Join for collection releases, proposal planning notes, and care advice from Joyari Krafted."
    },
    {
      "type": "text",
      "id": "menu_title",
      "label": "Menu title",
      "default": "Explore"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer menu"
    }
  ]
}
{% endschema %}
