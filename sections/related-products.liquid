{% liquid
  assign source_collection = product.collections.first
  assign shown = 0
%}

<section class="jk-section jk-related-products">
  <div class="jk-section__header jk-section__header--split">
    <div>
      <p class="jk-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    {% if source_collection != blank %}
      <a class="jk-text-link" href="{{ source_collection.url }}">View collection</a>
    {% endif %}
  </div>

  <div class="jk-product-grid jk-product-grid--related">
    {% if source_collection != blank and source_collection.products_count > 1 %}
      {% for related_product in source_collection.products %}
        {% unless related_product.id == product.id %}
          {% if shown < section.settings.product_limit %}
            {% assign shown = shown | plus: 1 %}
            <article class="jk-product-card{% unless related_product.available %} jk-product-card--sold-out{% endunless %}">
              <a class="jk-product-card__media" href="{{ related_product.url }}">
                {% if related_product.featured_media != blank %}
                  {{ related_product.featured_media | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360, 540, 720, 1000', sizes: '(min-width: 900px) 33vw, 50vw', alt: related_product.featured_media.alt | default: related_product.title }}
                {% else %}
                  {% render 'joyari-generated-image', file: 'joyari-product-pear-ring-on-hand.jpg', alt: related_product.title, class: 'jk-product-card__generated-image' %}
                {% endif %}
                {% unless related_product.available %}
                  <span class="jk-product-card__status">{{ 'products.product.sold_out' | t }}</span>
                {% endunless %}
                <span class="jk-product-card__quick">View piece</span>
              </a>
              <div class="jk-product-card__content">
                <h3 class="jk-product-card__title"><a href="{{ related_product.url }}">{{ related_product.title }}</a></h3>
                <p class="jk-product-card__price">{% render 'joyari-product-price', product: related_product %}</p>
                <a class="jk-product-card__action" href="{{ related_product.url }}">Select details</a>
              </div>
            </article>
          {% endif %}
        {% endunless %}
      {% endfor %}
    {% endif %}

    {% if shown == 0 %}
      {% liquid
        assign pathway_titles = 'Engagement Rings||Wedding Bands||Diamond Jewellery||Custom Design' | split: '||'
        assign pathway_meta = 'Bridal Icons||Forever Pieces||Fine Jewellery||Private Design' | split: '||'
        assign pathway_links = '/collections/engagement-rings||/collections/wedding-bands||/collections/fine-jewelry||/pages/custom-design' | split: '||'
      %}
      {% for index in (1..4) %}
        {% liquid
          assign pathway_index = index | minus: 1
          assign pathway_title = pathway_titles[pathway_index]
          assign pathway_badge = pathway_meta[pathway_index]
          assign pathway_link = pathway_links[pathway_index]
        %}
        <article class="jk-product-card jk-product-card--pathway">
          <a class="jk-product-card__media" href="{{ pathway_link }}">
            {% liquid
              assign pathway_asset = 'joyari-collection-engagement-rings-v2.jpg'
              if index == 2
                assign pathway_asset = 'joyari-collection-wedding-bands-v2.jpg'
              elsif index == 3
                assign pathway_asset = 'joyari-collection-diamond-jewellery.jpg'
              elsif index == 4
                assign pathway_asset = 'joyari-custom-design-atelier-v2.jpg'
              endif
            %}
            {% render 'joyari-generated-image', file: pathway_asset, alt: pathway_title, class: 'jk-product-card__generated-image' %}
            <span class="jk-product-card__quick">View piece</span>
          </a>
          <div class="jk-product-card__content">
            <p class="jk-product-card__meta">{{ pathway_badge }}</p>
            <h3 class="jk-product-card__title"><a href="{{ pathway_link }}">{{ pathway_title }}</a></h3>
            <a class="jk-product-card__action" href="{{ pathway_link }}">Explore</a>
          </div>
        </article>
      {% endfor %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Related products",
  "tag": "section",
  "class": "shopify-section--related-products",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Complete the story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also love"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Related products"
    }
  ]
}
{% endschema %}
