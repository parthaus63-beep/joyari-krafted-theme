<section class="jk-section jk-cart">
  <div class="jk-section__header">
    <p class="jk-eyebrow">Secure checkout</p>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subheading }}</p>
  </div>

  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" novalidate class="jk-cart-form">
      <div class="jk-cart-items">
        {% for item in cart.items %}
          <article class="jk-cart-item">
            <a class="jk-cart-item__media" href="{{ item.url }}">
              {% if item.image != blank %}
                {{ item.image | image_url: width: 320 | image_tag: loading: 'lazy', widths: '160, 240, 320', sizes: '120px', alt: item.image.alt | default: item.product.title }}
              {% else %}
                {% render 'joyari-generated-image', file: 'joyari-product-pear-ring-on-hand.jpg', alt: item.product.title, class: 'jk-cart-item__image' %}
              {% endif %}
            </a>
            <div class="jk-cart-item__details">
              <p class="jk-cart-item__eyebrow">Joyari Krafted</p>
              <h2><a href="{{ item.url }}">{{ item.product.title }}</a></h2>
              <div class="jk-cart-item__meta">
                {% unless item.product.has_only_default_variant %}
                  <span>{{ item.variant.title }}</span>
                {% endunless %}
                {% if item.selling_plan_allocation != blank %}
                  <span>{{ item.selling_plan_allocation.selling_plan.name }}</span>
                {% endif %}
              </div>
              {% if item.properties.size > 0 %}
                <dl class="jk-cart-properties">
                  {% for property in item.properties %}
                    {% assign first_character = property.first | slice: 0 %}
                    {% if property.last != blank and first_character != '_' %}
                      <div>
                        <dt>{{ property.first }}</dt>
                        <dd>{{ property.last }}</dd>
                      </div>
                    {% endif %}
                  {% endfor %}
                </dl>
              {% endif %}
              <a class="jk-cart-item__remove" href="{{ item.url_to_remove }}" aria-label="Remove {{ item.product.title | escape }}">{{ 'general.cart.remove' | t }}</a>
            </div>
            <div class="jk-cart-item__quantity">
              <label for="CartQuantity-{{ item.index | plus: 1 }}">Quantity</label>
              <input id="CartQuantity-{{ item.index | plus: 1 }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric">
              <button type="submit" name="update" class="jk-cart-item__update">Update</button>
            </div>
            <p class="jk-cart-item__price">{{ item.final_line_price | money }}</p>
          </article>
        {% endfor %}
      </div>

      <aside class="jk-cart-summary">
        <div class="jk-cart-summary__header">
          <p class="jk-eyebrow">Order summary</p>
          <h2>Prepared with care</h2>
        </div>

        <div class="jk-cart-summary__subtotal">
          <span>Subtotal</span>
          <strong>{{ cart.total_price | money }}</strong>
        </div>

        <p class="jk-cart-summary__copy">Shipping, duties, taxes, and available discounts are calculated at checkout. Your payment remains protected through Shopify checkout.</p>

        <label class="jk-cart-note" for="CartNote">
          <span>Order note <em>optional</em></span>
          <textarea id="CartNote" name="note" rows="4" placeholder="Share sizing notes, delivery timing, or presentation requests.">{{ cart.note }}</textarea>
        </label>

        <div class="jk-cart-trust" aria-label="Cart confidence">
          <span>Secure checkout</span>
          <span>Insured delivery</span>
          <span>Custom made with care</span>
        </div>

        <button type="submit" name="checkout" class="jk-button jk-button--primary jk-cart-checkout">{{ 'general.cart.checkout' | t }}</button>
        <a class="jk-cart-continue" href="{{ routes.all_products_collection_url }}">Continue Shopping</a>
      </aside>
    </form>
  {% else %}
    <div class="jk-empty-cart">
      <p>{{ 'general.cart.empty' | t }}</p>
      <a class="jk-button jk-button--primary" href="{{ routes.all_products_collection_url }}">Explore Joyari jewellery</a>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Cart template",
  "tag": "section",
  "class": "shopify-section--cart-template",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Joyari selection"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Review your jewellery before secure checkout."
    }
  ]
}
{% endschema %}
