<section class="jk-section jk-cart">
  <div class="jk-section__header">
    <p class="jk-eyebrow">Secure checkout</p>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subheading }}</p>
  </div>

  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" novalidate class="jk-cart-form">
      <div class="jk-cart-items">
        {% for item in cart.items %}
          <article class="jk-cart-item">
            <a class="jk-cart-item__media" href="{{ item.url }}">
              {% if item.image != blank %}
                {{ item.image | image_url: width: 320 | image_tag: loading: 'lazy', widths: '160, 240, 320', sizes: '120px', alt: item.image.alt | default: item.product.title }}
              {% else %}
                <span class="jk-product-placeholder" aria-hidden="true"></span>
              {% endif %}
            </a>
            <div class="jk-cart-item__details">
              <h2><a href="{{ item.url }}">{{ item.product.title }}</a></h2>
              {% unless item.product.has_only_default_variant %}
                <p>{{ item.variant.title }}</p>
              {% endunless %}
              {% if item.properties.size > 0 %}
                <dl class="jk-cart-properties">
                  {% for property in item.properties %}
                    {% assign first_character = property.first | slice: 0 %}
                    {% if property.last != blank and first_character != '_' %}
                      <div>
                        <dt>{{ property.first }}</dt>
                        <dd>{{ property.last }}</dd>
                      </div>
                    {% endif %}
                  {% endfor %}
                </dl>
              {% endif %}
              <a class="jk-text-link" href="{{ item.url_to_remove }}">{{ 'general.cart.remove' | t }}</a>
            </div>
            <div class="jk-cart-item__quantity">
              <label for="CartQuantity-{{ item.index | plus: 1 }}">Quantity</label>
              <input id="CartQuantity-{{ item.index | plus: 1 }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0">
            </div>
            <p class="jk-cart-item__price">{{ item.final_line_price | money }}</p>
          </article>
        {% endfor %}
      </div>

      <aside class="jk-cart-summary">
        <div>
          <span>Subtotal</span>
          <strong>{{ cart.total_price | money }}</strong>
        </div>
        <p>Shipping, duties, and taxes are calculated at checkout. Secure payment and order support are included.</p>
        <button type="submit" name="checkout" class="jk-button jk-button--primary">{{ 'general.cart.checkout' | t }}</button>
      </aside>
    </form>
  {% else %}
    <div class="jk-empty-cart">
      <p>{{ 'general.cart.empty' | t }}</p>
      <a class="jk-button jk-button--primary" href="{{ routes.all_products_collection_url }}">Explore Joyari jewellery</a>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Cart template",
  "tag": "section",
  "class": "shopify-section--cart-template",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Joyari selection"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Review your jewellery before secure checkout."
    }
  ]
}
{% endschema %}
