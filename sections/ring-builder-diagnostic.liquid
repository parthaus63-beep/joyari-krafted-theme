<section
  style="
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
    position: relative !important;
    z-index: 2147483647 !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 24px !important;
    background: #fff1f1 !important;
    color: #140000 !important;
    border: 8px solid #e00000 !important;
    box-shadow: 0 0 0 6px #ffffff inset !important;
    font-family: Arial, Helvetica, sans-serif !important;
    text-align: left !important;
  "
>
  <h1
    style="
      display: block !important;
      margin: 0 0 16px !important;
      color: #e00000 !important;
      font-family: Arial, Helvetica, sans-serif !important;
      font-size: 32px !important;
      font-weight: 900 !important;
      line-height: 1.15 !important;
      letter-spacing: 0 !important;
      text-transform: uppercase !important;
    "
  >
    RING BUILDER TEST VISIBLE — DEFAULT PRODUCT TEMPLATE IS WORKING
  </h1>

  <div
    style="
      display: grid !important;
      gap: 8px !important;
      margin: 0 !important;
      color: #140000 !important;
      font-size: 18px !important;
      font-weight: 700 !important;
      line-height: 1.35 !important;
    "
  >
    <p style="display:block !important; margin:0 !important; color:#140000 !important;">
      Product title: {{ product.title | default: 'No product object detected' }}
    </p>
    <p style="display:block !important; margin:0 !important; color:#140000 !important;">
      Product ID: {{ product.id | default: 'No product ID detected' }}
    </p>
    <p style="display:block !important; margin:0 !important; color:#140000 !important;">
      Selected variant ID: {{ product.selected_or_first_available_variant.id | default: 'No selected variant detected' }}
    </p>
    <p style="display:block !important; margin:0 !important; color:#140000 !important;">
      Template name: {{ template.name | default: 'unknown' }}{% if template.suffix != blank %}.{{ template.suffix }}{% endif %}
    </p>
    <p style="display:block !important; margin:0 !important; color:#140000 !important;">
      Request page type: {{ request.page_type | default: 'unknown' }}
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Ring builder diagnostic",
  "tag": "section",
  "class": "shopify-section--ring-builder-diagnostic",
  "settings": []
}
{% endschema %}
