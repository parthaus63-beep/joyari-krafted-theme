{% liquid
  assign has_hero_media = true
  if section.settings.hero_video != blank or section.settings.hero_video_url != blank or section.settings.hero_image != blank
    assign has_hero_media = true
  endif
%}

<section class="jk-hero section-{{ section.id }}{% if has_hero_media %} jk-hero--image-led{% endif %}">
  <div class="jk-hero__media" aria-hidden="true">
    {% if section.settings.hero_video != blank %}
      {{ section.settings.hero_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '2200x', class: 'jk-hero__video' }}
    {% elsif section.settings.hero_video_url != blank %}
      {{ section.settings.hero_video_url | external_video_tag: class: 'jk-hero__video jk-hero__video--external' }}
    {% elsif section.settings.hero_image != blank %}
      {{ section.settings.hero_image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '900, 1200, 1600, 2000, 2400', sizes: '100vw', alt: section.settings.hero_image_alt, class: 'jk-hero__image' }}
    {% else %}
      {% render 'joyari-generated-image',
        file: 'joyari-home-hero-ring-on-hand.jpg',
        alt: section.settings.hero_image_alt,
        class: 'jk-hero__image',
        loading: 'eager'
      %}
    {% endif %}
  </div>

  <div class="jk-hero__content">
    {% if section.settings.eyebrow != blank %}
      <p class="jk-eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h1>{{ section.settings.heading }}</h1>
    <p class="jk-hero__copy">{{ section.settings.subheading }}</p>
    {% if section.settings.primary_label != blank or section.settings.secondary_label != blank %}
      <div class="jk-hero__actions">
        {% if section.settings.primary_label != blank %}
          <a class="jk-button jk-button--primary" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label }}</a>
        {% endif %}
        {% if section.settings.secondary_label != blank %}
          <a class="jk-button jk-button--secondary" href="{{ section.settings.secondary_link | default: routes.all_products_collection_url }}">{{ section.settings.secondary_label }}</a>
        {% endif %}
      </div>
    {% endif %}
    <div class="jk-hero__trust" aria-label="Trust information">
      <span></span>
      <p>{{ section.settings.trust_text }}</p>
    </div>
  </div>

  <div class="jk-hero__caption">
    <span>{{ section.settings.caption_label }}</span>
    <strong>{{ section.settings.caption_heading }}</strong>
  </div>
</section>

{% schema %}
{
  "name": "Luxury hero",
  "tag": "section",
  "class": "shopify-section--luxury-hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Fine lab-grown diamond jewellery"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Joyari Krafted"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Luxury engagement rings and diamond jewellery crafted for the moment love becomes forever."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "video",
      "id": "hero_video",
      "label": "Hero video"
    },
    {
      "type": "video_url",
      "id": "hero_video_url",
      "label": "Hero video URL",
      "accept": [
        "youtube",
        "vimeo"
      ]
    },
    {
      "type": "text",
      "id": "hero_image_alt",
      "label": "Hero image alt text",
      "default": "Joyari Krafted diamond jewellery editorial image"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Explore Engagement Rings"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Design Your Own Ring"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "textarea",
      "id": "trust_text",
      "label": "Trust message",
      "default": "Certified diamonds, considered craftsmanship, and insured delivery on every made-to-order piece."
    },
    {
      "type": "text",
      "id": "caption_label",
      "label": "Image caption label",
      "default": "Lab-grown centre stones"
    },
    {
      "type": "text",
      "id": "caption_heading",
      "label": "Image caption heading",
      "default": "Designed for lifetime wear"
    }
  ],
  "presets": [
    {
      "name": "Luxury hero"
    }
  ]
}
{% endschema %}
