<section class="jk-hero section-{{ section.id }}">
  <div class="jk-hero__content">
    {% if section.settings.eyebrow != blank %}
      <p class="jk-eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h1>{{ section.settings.heading }}</h1>
    <p class="jk-hero__copy">{{ section.settings.subheading }}</p>
    <div class="jk-hero__actions">
      <a class="jk-button jk-button--primary" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label }}</a>
      <a class="jk-button jk-button--secondary" href="{{ section.settings.secondary_link | default: routes.all_products_collection_url }}">{{ section.settings.secondary_label }}</a>
    </div>
    <div class="jk-hero__trust" aria-label="Trust information">
      <span></span>
      <p>{{ section.settings.trust_text }}</p>
    </div>
  </div>

  <div class="jk-hero__visual" aria-hidden="true">
    <div class="jk-ring-stage">
      <svg class="jk-ring-svg" viewBox="0 0 620 620" role="img" aria-label="">
        <defs>
          <linearGradient id="ringGold-{{ section.id }}" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#fff6d7"></stop>
            <stop offset="45%" stop-color="#c7a35a"></stop>
            <stop offset="100%" stop-color="#8d6d2d"></stop>
          </linearGradient>
          <radialGradient id="diamondGlow-{{ section.id }}" cx="50%" cy="42%" r="50%">
            <stop offset="0%" stop-color="#ffffff"></stop>
            <stop offset="55%" stop-color="#dcecf0"></stop>
            <stop offset="100%" stop-color="#8fa7af"></stop>
          </radialGradient>
        </defs>
        <circle cx="310" cy="360" r="180" fill="none" stroke="url(#ringGold-{{ section.id }})" stroke-width="34"></circle>
        <circle cx="310" cy="360" r="130" fill="none" stroke="rgba(255,255,255,.38)" stroke-width="2"></circle>
        <path d="M252 192 310 112l58 80-58 74-58-74Z" fill="url(#diamondGlow-{{ section.id }})"></path>
        <path d="M252 192h116M310 112v154M252 192l116 0M282 192l28 74 28-74" fill="none" stroke="rgba(23,21,18,.28)" stroke-width="2"></path>
        <path d="M236 220c48 44 100 44 148 0" fill="none" stroke="url(#ringGold-{{ section.id }})" stroke-width="12" stroke-linecap="round"></path>
      </svg>
      <div class="jk-hero__caption">
        <span>Lab-grown centre stones</span>
        <strong>Designed for lifetime wear</strong>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Luxury hero",
  "tag": "section",
  "class": "shopify-section--luxury-hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Fine lab-grown diamond jewellery"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Joyari Krafted"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Luxury engagement rings and diamond jewellery crafted for the moment love becomes forever."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Explore Engagement Rings"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Design Your Own Ring"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "textarea",
      "id": "trust_text",
      "label": "Trust message",
      "default": "Certified diamonds, considered craftsmanship, and insured delivery on every made-to-order piece."
    }
  ],
  "presets": [
    {
      "name": "Luxury hero"
    }
  ]
}
{% endschema %}
