<section class="jk-section jk-testimonials{% if section.settings.background_image != blank %} jk-testimonials--image-bg{% endif %}">
  {% if section.settings.background_image != blank %}
    <div class="jk-testimonials__background" aria-hidden="true">
      {{ section.settings.background_image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '720, 1000, 1400, 1800', sizes: '100vw', alt: '', class: 'jk-testimonials__background-image' }}
    </div>
  {% endif %}

  <div class="jk-section__header">
    {% if section.settings.eyebrow != blank %}
      <p class="jk-eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2>{{ section.settings.heading }}</h2>
  </div>

  <div class="jk-testimonial-grid">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        {% assign testimonial_image_alt = block.settings.image_alt | default: block.settings.name %}
        {% assign testimonial_initial = block.settings.name | slice: 0, 1 %}
        <figure class="jk-testimonial" {{ block.shopify_attributes }}>
          <div class="jk-testimonial__media">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '180, 280, 420, 640', sizes: '(min-width: 900px) 31vw, 100vw', alt: testimonial_image_alt, class: 'jk-testimonial__image' }}
            {% else %}
              <span aria-hidden="true">{{ testimonial_initial }}</span>
            {% endif %}
          </div>
          <blockquote>{{ block.settings.quote }}</blockquote>
          <figcaption>
            <strong>{{ block.settings.name }}</strong>
            <span>{{ block.settings.detail }}</span>
          </figcaption>
        </figure>
      {% endfor %}
    {% else %}
      <figure class="jk-testimonial">
        <div class="jk-testimonial__media">
          <span aria-hidden="true">A</span>
        </div>
        <blockquote>The design process felt calm, personal, and genuinely special from the first message.</blockquote>
        <figcaption><strong>Amelia</strong><span>Custom engagement ring</span></figcaption>
      </figure>
      <figure class="jk-testimonial">
        <div class="jk-testimonial__media">
          <span aria-hidden="true">S</span>
        </div>
        <blockquote>I understood every decision before buying, which made the final ring feel even more meaningful.</blockquote>
        <figcaption><strong>Sofia</strong><span>Oval lab-grown diamond ring</span></figcaption>
      </figure>
      <figure class="jk-testimonial">
        <div class="jk-testimonial__media">
          <span aria-hidden="true">M</span>
        </div>
        <blockquote>The packaging, sparkle, and support all felt beautifully considered.</blockquote>
        <figcaption><strong>Maya</strong><span>Diamond earrings</span></figcaption>
      </figure>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "shopify-section--testimonials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Client notes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Chosen for the most meaningful yes"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Testimonial background image"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The design process felt calm, personal, and genuinely special from the first message."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Amelia"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Detail",
          "default": "Custom engagement ring"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Client / testimonial image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}
{% endschema %}
