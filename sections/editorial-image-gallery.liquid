<section class="jk-section jk-editorial-gallery">
  <div class="jk-section__header">
    {% if section.settings.eyebrow != blank %}
      <p class="jk-eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2>{{ section.settings.heading }}</h2>
    {% if section.settings.subheading != blank %}
      <p>{{ section.settings.subheading }}</p>
    {% endif %}
  </div>

  <div class="jk-editorial-gallery__grid">
    {% for block in section.blocks %}
      {% assign editorial_image_alt = block.settings.image_alt | default: block.settings.title %}
      {% liquid
        assign editorial_asset = 'joyari-product-pear-ring-on-hand.jpg'
        case forloop.index
          when 2
            assign editorial_asset = 'joyari-diamond-macro-pear.jpg'
          when 3
            assign editorial_asset = 'joyari-proposal-lifestyle.jpg'
          when 4
            assign editorial_asset = 'joyari-atelier-craftsmanship.jpg'
          when 5
            assign editorial_asset = 'joyari-packaging-certificate.jpg'
          when 6
            assign editorial_asset = 'joyari-private-consultation.jpg'
        endcase
      %}
      <article class="jk-editorial-card jk-editorial-card--{{ forloop.index }}" {{ block.shopify_attributes }}>
        <div class="jk-editorial-card__media">
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 1300 | image_tag: loading: 'lazy', widths: '420, 640, 820, 1100, 1300', sizes: '(min-width: 1100px) 33vw, (min-width: 700px) 50vw, 100vw', alt: editorial_image_alt }}
          {% else %}
            {% render 'joyari-generated-image', file: editorial_asset, alt: editorial_image_alt, class: 'jk-editorial-card__image' %}
          {% endif %}
        </div>
        <div class="jk-editorial-card__content">
          {% if block.settings.eyebrow != blank %}
            <p class="jk-card-badge">{{ block.settings.eyebrow }}</p>
          {% endif %}
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Editorial image gallery",
  "tag": "section",
  "class": "shopify-section--editorial-image-gallery",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Joyari moments"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A visual story of modern diamond luxury"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Bridal, diamond, atelier, and packaging moments give Joyari Krafted a rich editorial world."
    }
  ],
  "blocks": [
    {
      "type": "editorial_image",
      "name": "Editorial image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Editorial / lifestyle image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Editorial"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Ring on hand"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "A quiet, intimate moment designed to help clients imagine the piece in real life."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial image gallery",
      "blocks": [
        {
          "type": "editorial_image",
          "settings": {
            "eyebrow": "Bridal",
            "title": "Ring on hand",
            "text": "Close, tactile imagery that shows scale, sparkle, and wearability."
          }
        },
        {
          "type": "editorial_image",
          "settings": {
            "eyebrow": "Diamond detail",
            "title": "Diamond close-up",
            "text": "Macro imagery for brilliance, facet detail, and stone confidence."
          }
        },
        {
          "type": "editorial_image",
          "settings": {
            "eyebrow": "Proposal",
            "title": "Couple lifestyle",
            "text": "Emotional imagery for proposals, anniversaries, and meaningful milestones."
          }
        },
        {
          "type": "editorial_image",
          "settings": {
            "eyebrow": "Atelier",
            "title": "Craftsmanship",
            "text": "Bench, sketch, and finishing moments that make the process feel considered."
          }
        },
        {
          "type": "editorial_image",
          "settings": {
            "eyebrow": "Presentation",
            "title": "Packaging and luxury box",
            "text": "A refined reveal moment for gifting, proposals, and keepsake presentation."
          }
        }
      ]
    }
  ]
}
{% endschema %}
