    }

    .jk-product-builder-main .jk-product-gallery--with-thumbs {
      grid-template-columns: 1fr !important;
    }

    .jk-product-builder-main .jk-product-gallery__main,
    .jk-product-builder-main .jk-product-gallery--with-thumbs .jk-product-gallery__main {
      grid-column: 1 !important;
      grid-row: 1 !important;
    }

    .jk-product-builder-main .jk-product-gallery--with-thumbs .jk-product-gallery__thumbs {
      grid-column: 1 !important;
      grid-row: 2 !important;
      grid-template-columns: repeat(5, minmax(66px, 1fr)) !important;
      grid-auto-rows: auto !important;
      max-height: none !important;
      overflow-x: auto !important;
      position: static !important;
      padding-bottom: 6px !important;
    }

    .jk-product-builder-main .jk-product-media {
      min-height: 0 !important;
      aspect-ratio: 1 / 1 !important;
    }
