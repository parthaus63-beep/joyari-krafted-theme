{% liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign product_form_id = 'JoyariProductBuilderForm-' | append: section.id
  assign product_type_downcase = product.type | downcase
  assign product_title_downcase = product.title | downcase
  assign is_ring_product = false
  assign is_non_ring_jewellery = false

  if product_type_downcase contains 'earring' or product_type_downcase contains 'necklace' or product_type_downcase contains 'bracelet' or product_type_downcase contains 'pendant'
    assign is_non_ring_jewellery = true
  endif

  if product_title_downcase contains 'earring' or product_title_downcase contains 'necklace' or product_title_downcase contains 'bracelet' or product_title_downcase contains 'pendant'
    assign is_non_ring_jewellery = true
  endif

  unless is_non_ring_jewellery
    if product_type_downcase contains 'ring' or product_title_downcase contains 'ring'
      assign is_ring_product = true
    endif
  endunless

  for collection in product.collections
    assign collection_handle_downcase = collection.handle | downcase
    assign collection_title_downcase = collection.title | downcase
    if collection_handle_downcase contains 'earring' or collection_handle_downcase contains 'necklace' or collection_handle_downcase contains 'bracelet' or collection_handle_downcase contains 'pendant' or collection_title_downcase contains 'earring' or collection_title_downcase contains 'necklace' or collection_title_downcase contains 'bracelet' or collection_title_downcase contains 'pendant'
      assign is_non_ring_jewellery = true
    elsif collection_handle_downcase contains 'ring' or collection_title_downcase contains 'ring'
      assign is_ring_product = true
    endif
  endfor

  for tag in product.tags
    assign tag_downcase = tag | downcase
    if tag_downcase contains 'earring' or tag_downcase contains 'necklace' or tag_downcase contains 'bracelet' or tag_downcase contains 'pendant'
      assign is_non_ring_jewellery = true
    elsif tag_downcase == 'ring' or tag_downcase contains 'ring' or tag_downcase == 'requires-ring-size'
      assign is_ring_product = true
    endif
  endfor

  assign show_ring_size_selector = true
  if section.settings.show_ring_size_on_all_products == false
    assign show_ring_size_selector = false
    if is_ring_product and is_non_ring_jewellery == false
      assign show_ring_size_selector = true
    endif
  endif

  assign has_product_model = false
  for media in product.media
    if media.media_type == 'model'
      assign has_product_model = true
    endif
  endfor
%}

{% if has_product_model %}
  <script type="module" src="{{ 'model-viewer.min.js' | asset_url }}"></script>
{% endif %}

<section class="jk-product-template jk-product-builder-main" data-product-builder data-quarter-premium="{{ section.settings.carat_quarter_premium }}" data-base-carat="1">
  {% if product != blank %}
    <script type="application/json" data-product-json>{{ product | json }}</script>

    <div class="jk-product-layout jk-product-layout--builder">
      <div class="jk-product-gallery{% if product.media.size > 1 %} jk-product-gallery--with-thumbs{% endif %}" data-product-gallery>
        <div class="jk-product-gallery__main">
          {% if product.media.size > 0 %}
            {% for media in product.media %}
              <figure class="jk-product-media jk-product-media--{{ media.media_type }}{% if forloop.first %} is-active{% endif %}" data-media-id="{{ media.id }}" data-image-id="{{ media.preview_image.id | default: media.id }}" data-media-type="{{ media.media_type }}">
                {% render 'product-media', media: media, product: product, mode: 'main' %}
              </figure>
            {% endfor %}
            {% if product.media.size > 1 %}
              <div class="jk-product-gallery__arrows" aria-label="Product media navigation">
                <button type="button" class="jk-product-gallery__arrow jk-product-gallery__arrow--prev" data-media-previous aria-label="Previous product media">
                  <span aria-hidden="true">&lsaquo;</span>
                </button>
                <button type="button" class="jk-product-gallery__arrow jk-product-gallery__arrow--next" data-media-next aria-label="Next product media">
                  <span aria-hidden="true">&rsaquo;</span>
                </button>
              </div>
            {% endif %}
          {% else %}
            <figure class="jk-product-media is-active">
              <div class="jk-product-placeholder jk-product-placeholder--large" aria-hidden="true"></div>
            </figure>
          {% endif %}
        </div>

        {% if product.media.size > 1 %}
          <div class="jk-product-gallery__thumbs" aria-label="Product media">
            {% for media in product.media %}
              <button type="button" class="jk-media-thumb jk-media-thumb--{{ media.media_type }}{% if forloop.first %} is-active{% endif %}" data-media-trigger="{{ media.id }}" data-image-trigger="{{ media.preview_image.id | default: media.id }}" aria-label="View media {{ forloop.index }}">
                {% render 'product-media', media: media, product: product, mode: 'thumbnail' %}
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="jk-product-panel">
        <div class="jk-product-panel__inner jk-product-panel__inner--builder">
          <div class="jk-product-panel__header">
            <p class="jk-eyebrow">Joyari fine jewellery</p>
            <h1>{{ product.title }}</h1>
            <p class="jk-product-subtitle">
              {% if product.type != blank %}
                {{ product.type }}
              {% else %}
                Made-to-order fine jewellery
              {% endif %}
            </p>

            {% assign product_summary = product.description | strip_html | replace: '\n', ' ' | truncate: 150 %}
            {% if product_summary != blank %}
              <p class="jk-product-short-description">{{ product_summary }}</p>
            {% endif %}

            <div class="jk-product-review-placeholder" aria-label="Client review placeholder">
              <span class="jk-product-review-placeholder__stars" aria-hidden="true">Reviews</span>
              <span>Client reviews coming soon</span>
            </div>

            <div class="jk-product-metal-palette" aria-label="Available metal tones">
              <span class="jk-product-metal-palette__label">Metal tones</span>
              <span class="jk-product-metal-dot jk-product-metal-dot--platinum" title="Platinum"></span>
              <span class="jk-product-metal-dot jk-product-metal-dot--yellow" title="18K Yellow Gold"></span>
              <span class="jk-product-metal-dot jk-product-metal-dot--white" title="18K White Gold"></span>
              <span class="jk-product-metal-dot jk-product-metal-dot--rose" title="Rose Gold"></span>
            </div>

            <div class="jk-product-price-row">
              <p class="jk-product-price" data-variant-price>{{ selected_variant.price | money }}</p>
              {% if selected_variant.compare_at_price > selected_variant.price %}
                <p class="jk-product-compare" data-variant-compare>{{ selected_variant.compare_at_price | money }}</p>
              {% else %}
                <p class="jk-product-compare is-hidden" data-variant-compare></p>
              {% endif %}
            </div>

            <p class="jk-availability" data-availability>
              {% if selected_variant.available %}
                Available for secure checkout
              {% else %}
                This configuration is currently unavailable
              {% endif %}
            </p>
          </div>

          {% form 'product', product, id: product_form_id, class: 'jk-product-form', data-product-form: 'product' %}
            <input type="hidden" name="id" value="{{ selected_variant.id }}" data-variant-id-input>

            <div class="jk-ring-builder-card jk-ring-builder-card--product">
              <div class="jk-builder-card__header">
                <div>
                  <p class="jk-eyebrow">Simple selection</p>
                  <h2>{{ section.settings.builder_heading }}</h2>
                  <p class="jk-builder-subcopy">Choose the available Shopify option for checkout. For a different metal, size, diamond shape, engraving, or personal detail, send a custom request below.</p>
                </div>
              </div>

              {% unless product.has_only_default_variant %}
                <div class="jk-builder-step jk-product-variant-group">
                  <div class="jk-builder-step__header">
                    <span class="jk-builder-step__number">01</span>
                    <div>
                      <h3>Available options</h3>
                      <p>These are the real Shopify variants for this product, often kept to a simple choice such as carat size.</p>
                    </div>
                  </div>

                  {% for option in product.options_with_values %}
                    {% assign selected_value = option.selected_value %}
                    {% assign option_key = 'option' | append: forloop.index %}
                    {% if selected_value == blank %}
                      {% assign selected_value = selected_variant[option_key] %}
                    {% endif %}

                    <fieldset class="jk-option-fieldset" data-option-position="{{ forloop.index }}" data-option-name="{{ option.name | escape }}">
                      <legend>{{ option.name }}</legend>
                      <div class="jk-swatch-row">
                        {% for value in option.values %}
                          {% assign option_id = 'BuilderOption-' | append: section.id | append: '-' | append: option.position | append: '-' | append: value | handleize %}
                          <input
                            id="{{ option_id }}"
                            type="radio"
                            name="options[{{ option.name | escape }}]"
                            value="{{ value | escape }}"
                            data-option-input
                            data-option-position="{{ forloop.parentloop.index }}"
                            {% if value == selected_value %}checked{% endif %}
                          >
                          <label for="{{ option_id }}">{{ value }}</label>
                        {% endfor %}
                      </div>
                    </fieldset>
                  {% endfor %}
                </div>
              {% endunless %}

              <div class="jk-builder-step jk-builder-step--design-preferences">
                <div class="jk-builder-step__header">
                  <span class="jk-builder-step__number">{% if product.has_only_default_variant %}01{% else %}02{% endif %}</span>
                  <div>
                    <h3>Design preferences</h3>
                    <p>Choose your preferred metal, diamond shape, and carat presence. These details are saved with your order request while Shopify variants stay simple.</p>
                  </div>
                </div>

                <fieldset class="jk-option-fieldset jk-option-fieldset--metal">
                  <legend>Metal selector</legend>
                  <div class="jk-swatch-row jk-swatch-row--metal">
                    {% assign metals = 'Platinum,18K Yellow Gold,18K White Gold,Rose Gold' | split: ',' %}
                    {% for metal in metals %}
                      {% assign metal_id = 'MetalPreference-' | append: section.id | append: '-' | append: metal | handleize %}
                      {% liquid
                        assign metal_swatch = 'platinum'
                        if metal contains 'Yellow'
                          assign metal_swatch = 'yellow'
                        elsif metal contains 'White'
                          assign metal_swatch = 'white'
                        elsif metal contains 'Rose'
                          assign metal_swatch = 'rose'
                        endif
                      %}
                      <input id="{{ metal_id }}" type="radio" name="properties[Metal Preference]" value="{{ metal | escape }}" {% if forloop.first %}checked{% endif %}>
                      <label for="{{ metal_id }}"><span class="jk-metal-swatch jk-metal-swatch--{{ metal_swatch }}" aria-hidden="true"></span>{{ metal }}</label>
                    {% endfor %}
                  </div>
                </fieldset>

                <fieldset class="jk-option-fieldset jk-option-fieldset--shape">
                  <legend>Diamond shape selector</legend>
                  <div class="jk-shape-row">
                    {% assign shapes = 'Round,Oval,Emerald,Pear,Cushion' | split: ',' %}
                    {% for shape in shapes %}
                      {% assign shape_id = 'DiamondShapePreference-' | append: section.id | append: '-' | append: shape | handleize %}
                      <input id="{{ shape_id }}" type="radio" name="properties[Diamond Shape]" value="{{ shape | escape }}" {% if forloop.first %}checked{% endif %}>
                      <label for="{{ shape_id }}"><span class="jk-shape-chip"><span class="jk-shape-icon jk-shape-icon--{{ shape | handleize }}" aria-hidden="true"></span>{{ shape }}</span></label>
                    {% endfor %}
                  </div>
                </fieldset>

                <div class="jk-builder-field jk-builder-field--carat-preference">
                  <label for="CaratPreference-{{ section.id }}">Carat selector</label>
                  <select id="CaratPreference-{{ section.id }}" name="properties[Carat Preference]">
                    <option value="0.50 ct">0.50 ct</option>
                    <option value="1.00 ct" selected>1.00 ct</option>
                    <option value="1.50 ct">1.50 ct</option>
                    <option value="2.00 ct">2.00 ct</option>
                    <option value="2.50 ct">2.50 ct</option>
                    <option value="3.00 ct">3.00 ct</option>
                    <option value="Private guidance">Private guidance</option>
                  </select>
                </div>
              </div>

              {% if show_ring_size_selector %}
                <div class="jk-builder-step jk-builder-step--ring-size">
                  <div class="jk-builder-step__header">
                    <span class="jk-builder-step__number">{% if product.has_only_default_variant %}02{% else %}03{% endif %}</span>
                    <div>
                      <h3>Ring size</h3>
                      <p>Select your preferred fit. This is saved with the order and does not change the Shopify variant.</p>
                    </div>
                  </div>

                  {% liquid
                    assign ring_size_select_id = 'RingSize-' | append: section.id
                    assign ring_size_modal_id = 'RingSizeGuide-' | append: section.id
                  %}
                  {% render 'ring-size-selector', select_id: ring_size_select_id, modal_id: ring_size_modal_id %}
                </div>
              {% endif %}

              <div class="jk-builder-step jk-builder-step--custom-nudge">
                <div class="jk-builder-step__header">
                  <span class="jk-builder-step__number">
                    {% if show_ring_size_selector %}
                      {% if product.has_only_default_variant %}03{% else %}04{% endif %}
                    {% else %}
                      {% if product.has_only_default_variant %}02{% else %}03{% endif %}
                    {% endif %}
                  </span>
                  <div>
                    <h3>Need a custom version?</h3>
                    <p>Prefer a different metal, size, diamond shape or personal detail? Share your vision and our team will guide you.</p>
                  </div>
                </div>
                <a class="jk-text-link" href="#JoyariCustomRequest-{{ section.id }}">Request a Custom Version</a>
              </div>

              <div class="jk-product-actions">
                <button type="submit" name="add" class="jk-button jk-button--primary jk-add-to-cart" data-add-to-cart {% unless selected_variant.available %}disabled{% endunless %}>
                  {% if selected_variant.available %}
                    {{ 'products.product.add_to_cart' | t }}
                  {% else %}
                    {{ 'products.product.sold_out' | t }}
                  {% endif %}
                </button>
                <p class="jk-availability" data-availability>
                  {% if selected_variant.available %}
                    Available for secure checkout
                  {% else %}
                    This configuration is currently unavailable
                  {% endif %}
                </p>
                <a class="jk-button jk-button--secondary jk-product-enquiry-button" href="/pages/contact">Enquire or book appointment</a>
              </div>
            </div>
          {% endform %}

          <div class="jk-builder-trust-grid" aria-label="Joyari trust badges">
            <span class="jk-trust-badge">Lab-grown diamonds</span>
            <span class="jk-trust-badge">Certified stones</span>
            <span class="jk-trust-badge">Worldwide shipping</span>
            <span class="jk-trust-badge">Custom handcrafted jewellery</span>
          </div>

          <div class="jk-accordions jk-product-info-accordions" aria-label="Product service information">
            <details open>
              <summary>Product details</summary>
              <p>Review the product description below for setting notes, metal information, proportions, and the design details that make this piece feel personal.</p>
            </details>
            <details>
              <summary>Diamond details</summary>
              <p>Eligible designs can be paired with certified lab-grown diamonds selected for brilliance, proportion, colour, clarity, and documentation.</p>
            </details>
            <details>
              <summary>Shipping &amp; returns</summary>
              <p>Each Joyari Krafted piece is prepared with insured delivery and careful presentation. Made-to-order timelines and return eligibility are confirmed before dispatch.</p>
            </details>
            <details>
              <summary>Customisation</summary>
              <p>For a different metal, diamond shape, engraving, hidden halo, band profile, or private design detail, request a custom version and our team will guide the next step.</p>
            </details>
            <details>
              <summary>Ring size guide</summary>
              <p>Use the size guide beside the ring-size selector to compare AUS/UK, US/Canada, EU, inside diameter, and circumference. Wider bands may need a half size up.</p>
            </details>
          </div>
        </div>
      </div>
    </div>

    {% liquid
      assign custom_request_id = 'JoyariCustomRequest-' | append: section.id
    %}
    {% render 'product-custom-request', request_id: custom_request_id %}

    <div class="jk-product-description">
      <div>
        <p class="jk-eyebrow">Product details</p>
        <h2>Designed for brilliance, comfort, and permanence</h2>
      </div>
      <div class="rte">
        {% if product.description != blank %}
          {{ product.description }}
        {% else %}
          <p>Use this space for diamond specifications, metal details, setting notes, certification information, and the story behind the piece.</p>
        {% endif %}
      </div>
    </div>

    <div class="jk-mobile-atc" data-mobile-atc>
      <div>
        <span>{{ product.title }}</span>
        <strong data-estimate-total>{{ selected_variant.price | money }}</strong>
      </div>
      <button type="submit" name="add" form="{{ product_form_id }}" class="jk-button jk-button--primary" data-add-to-cart {% unless selected_variant.available %}disabled{% endunless %}>
        {% if selected_variant.available %}
          {{ 'products.product.add_to_cart' | t }}
        {% else %}
          {{ 'products.product.sold_out' | t }}
        {% endif %}
      </button>
    </div>
  {% else %}
    <div class="jk-section__header">
      <p class="jk-eyebrow">Joyari Krafted</p>
      <h1>Product details</h1>
      <p>Add product information in Shopify admin to complete this fine jewellery page.</p>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Product builder main",
  "tag": "section",
  "class": "shopify-section--product-builder-main",
  "settings": [
    {
      "type": "text",
      "id": "builder_heading",
      "label": "Builder heading",
      "default": "Design your Joyari piece"
    },
    {
      "type": "checkbox",
      "id": "show_ring_size_on_all_products",
      "label": "Show ring size selector on all products temporarily",
      "default": true
    },
    {
      "type": "number",
      "id": "carat_quarter_premium",
      "label": "Estimate increase per 0.25ct above 1ct, in cents",
      "default": 18500
    }
  ]
}
{% endschema %}
