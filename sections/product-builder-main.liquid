<style>
  .jk-product-builder-main .jk-product-media {
    display: none !important;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity .32s var(--jk-ease), transform .32s var(--jk-ease);
  }

  .jk-product-builder-main .jk-product-media.is-active {
    display: grid !important;
    opacity: 1;
    transform: translateY(0);
  }

  .jk-product-builder-main .jk-product-media img,
  .jk-product-builder-main .jk-product-media video,
  .jk-product-builder-main .jk-product-media iframe,
  .jk-product-builder-main .jk-product-media model-viewer {
    width: 100%;
    height: 100%;
    display: block;
    border: 0;
  }

  .jk-product-builder-main .jk-product-gallery__main {
    min-width: 0;
  }

  .jk-product-builder-main .jk-media-thumb {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid rgba(198, 167, 105, .24);
    background: #FFFFFF;
    cursor: pointer;
  }

  .jk-product-builder-main .jk-product-panel__inner--builder {
    border: 1px solid rgba(198, 167, 105, .22);
    box-shadow: 0 24px 70px rgba(17, 17, 17, .06);
  }

  .jk-product-builder-main .jk-ring-builder-card--product {
    display: grid;
    gap: 22px;
    padding: clamp(18px, 2vw, 28px);
    border: 1px solid rgba(198, 167, 105, .24);
    border-radius: 8px;
  }

  .jk-product-builder-main .jk-builder-step {
    display: grid;
    gap: 16px;
    padding-top: 20px;
    border-top: 1px solid rgba(198, 167, 105, .24);
  }

  .jk-product-builder-main .jk-builder-step__header {
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr);
    gap: 12px;
  }

  .jk-product-builder-main .jk-builder-step__number {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid rgba(198, 167, 105, .5);
    border-radius: 50%;
    color: #8A713A;
    font-size: .78rem;
    font-weight: 900;
    letter-spacing: .08em;
  }

  .jk-product-builder-main .jk-option-fieldset {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .jk-product-builder-main .jk-option-fieldset legend,
  .jk-product-builder-main .jk-builder-field label {
    margin: 0 0 10px;
    color: #111111;
    font-size: .78rem;
    font-weight: 900;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .jk-product-builder-main .jk-option-fieldset--shape .jk-shape-row {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px !important;
  }

  .jk-product-builder-main .jk-option-fieldset--shape input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .jk-product-builder-main .jk-option-fieldset--shape .jk-shape-row label {
    min-height: 68px !important;
    padding: 10px 12px !important;
    border: 1px solid rgba(198, 167, 105, .44) !important;
    border-radius: 8px !important;
    background: #FFFFFF !important;
    color: #111111 !important;
  }

  .jk-product-builder-main .jk-option-fieldset--shape .jk-shape-chip {
    width: 100%;
    grid-template-columns: 34px minmax(0, 1fr) !important;
    gap: 10px !important;
    justify-items: start;
    color: #111111;
    font-size: .8rem !important;
    font-weight: 850;
    letter-spacing: .04em !important;
    text-transform: none;
  }

  .jk-product-builder-main .jk-diamond-shape-icon {
    width: 34px !important;
    height: 34px !important;
    min-width: 34px !important;
    color: #0F3D2E !important;
    stroke-width: 2.35 !important;
  }

  .jk-product-builder-main .jk-option-fieldset--shape .jk-shape-row input:checked + label {
    border-color: #C6A769 !important;
    background: #F8F6F1 !important;
    box-shadow: 0 14px 32px rgba(198, 167, 105, .2), inset 0 0 0 1px rgba(198, 167, 105, .28) !important;
  }

  .jk-product-builder-main .jk-option-fieldset--shape .jk-shape-row input:focus-visible + label {
    outline: 2px solid rgba(15, 61, 46, .42);
    outline-offset: 3px;
  }

  .jk-product-builder-main .jk-builder-field--carat-preference select {
    width: 100%;
    border-radius: 8px !important;
  }

  @media (max-width: 680px) {
    .jk-product-builder-main .jk-ring-builder-card--product {
      padding: 16px;
    }

    .jk-product-builder-main .jk-option-fieldset--shape .jk-shape-row {
      grid-template-columns: 1fr 1fr;
      gap: 8px !important;
    }

    .jk-product-builder-main .jk-option-fieldset--shape .jk-shape-row label {
      min-height: 62px !important;
      padding: 9px !important;
    }

    .jk-product-builder-main .jk-option-fieldset--shape .jk-shape-chip {
      grid-template-columns: 30px minmax(0, 1fr) !important;
      gap: 8px !important;
      font-size: .72rem !important;
    }

    .jk-product-builder-main .jk-diamond-shape-icon {
      width: 30px !important;
      height: 30px !important;
      min-width: 30px !important;
    }
  }
</style>

<section class="jk-product-template jk-product-builder-main" data-product-builder data-quarter-premium="{{ section.settings.carat_quarter_premium }}" data-base-carat="1">
  {% if product != blank %}
    <script type="application/json" data-product-json>{{ product | json }}</script>

    <div class="jk-product-layout jk-product-layout--builder">
      <div class="jk-product-gallery{% if product_gallery_media_count > 1 %} jk-product-gallery--with-thumbs{% endif %}" data-product-gallery>
        <div class="jk-product-gallery__main">
          {% if product_gallery_media_count > 0 %}
            {% if section.settings.gallery_image != blank %}
              <figure class="jk-product-media jk-product-media--support is-active" data-media-id="joyari-gallery-image" data-media-type="image">
                {{ section.settings.gallery_image | image_url: width: 1800 | image_tag: loading: 'eager', sizes: '(min-width: 1080px) 62vw, 100vw', widths: '640, 900, 1200, 1600, 1800', alt: section.settings.gallery_image_alt }}
                <figcaption class="jk-product-media__caption">Hero visual</figcaption>
              </figure>
            {% endif %}

            {% for media in product.media %}
              <figure class="jk-product-media jk-product-media--{{ media.media_type }}{% if forloop.first and section.settings.gallery_image == blank %} is-active{% endif %}" data-media-id="{{ media.id }}" data-image-id="{{ media.preview_image.id | default: media.id }}" data-media-type="{{ media.media_type }}">
                {% render 'product-media', media: media, product: product, mode: 'main' %}
              </figure>
            {% endfor %}

            {% assign support_media_index = product.media.size %}
            {% if section.settings.ring_on_hand_image != blank %}
              {% assign support_media_index = support_media_index | plus: 1 %}
              <figure class="jk-product-media jk-product-media--support{% if product.media.size == 0 and section.settings.gallery_image == blank %} is-active{% endif %}" data-media-id="joyari-ring-on-hand" data-media-type="image">
                {{ section.settings.ring_on_hand_image | image_url: width: 1800 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 62vw, 100vw', widths: '640, 900, 1200, 1600, 1800', alt: section.settings.ring_on_hand_alt }}
                <figcaption class="jk-product-media__caption">Ring on hand</figcaption>
              </figure>
            {% endif %}

            {% if section.settings.diamond_closeup_image != blank %}
              {% assign support_media_index = support_media_index | plus: 1 %}
              <figure class="jk-product-media jk-product-media--support{% if product.media.size == 0 and section.settings.gallery_image == blank and section.settings.ring_on_hand_image == blank %} is-active{% endif %}" data-media-id="joyari-diamond-closeup" data-media-type="image">
                {{ section.settings.diamond_closeup_image | image_url: width: 1800 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 62vw, 100vw', widths: '640, 900, 1200, 1600, 1800', alt: section.settings.diamond_closeup_alt }}
                <figcaption class="jk-product-media__caption">Diamond detail</figcaption>
              </figure>
            {% endif %}

            {% if section.settings.product_video_url != blank or section.settings.product_video_file_url != blank %}
              {% assign support_media_index = support_media_index | plus: 1 %}
              <figure class="jk-product-media jk-product-media--video{% if product.media.size == 0 and section.settings.gallery_image == blank and section.settings.ring_on_hand_image == blank and section.settings.diamond_closeup_image == blank %} is-active{% endif %}" data-media-id="joyari-product-video" data-media-type="video">
                {% if section.settings.product_video_file_url != blank %}
                  <video controls playsinline preload="metadata">
                    <source src="{{ section.settings.product_video_file_url }}" type="video/mp4">
                  </video>
                {% else %}
                  {{ section.settings.product_video_url | external_video_tag }}
                {% endif %}
                <figcaption class="jk-product-media__caption">Product video</figcaption>
              </figure>
            {% endif %}

            {% if product_gallery_media_count > 1 %}
              <div class="jk-product-gallery__arrows" aria-label="Product media navigation">
                <button type="button" class="jk-product-gallery__arrow jk-product-gallery__arrow--prev" data-media-previous aria-label="Previous product media">
                  <span aria-hidden="true">&lsaquo;</span>
                </button>
                <button type="button" class="jk-product-gallery__arrow jk-product-gallery__arrow--next" data-media-next aria-label="Next product media">
                  <span aria-hidden="true">&rsaquo;</span>
                </button>
              </div>
            {% endif %}
          {% else %}
            <figure class="jk-product-media is-active">
              {% render 'joyari-visual-placeholder', type: 'ring' %}
            </figure>
          {% endif %}
        </div>

        {% if product_gallery_media_count > 1 %}
          <div class="jk-product-gallery__thumbs" aria-label="Product media">
            {% if section.settings.gallery_image != blank %}
              <button type="button" class="jk-media-thumb jk-media-thumb--support is-active" data-media-trigger="joyari-gallery-image" aria-label="View hero visual">
                {{ section.settings.gallery_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', alt: section.settings.gallery_image_alt }}
              </button>
            {% endif %}
            {% for media in product.media %}
              <button type="button" class="jk-media-thumb jk-media-thumb--{{ media.media_type }}{% if forloop.first and section.settings.gallery_image == blank %} is-active{% endif %}" data-media-trigger="{{ media.id }}" data-image-trigger="{{ media.preview_image.id | default: media.id }}" aria-label="View media {{ forloop.index }}">
                {% render 'product-media', media: media, product: product, mode: 'thumbnail' %}
              </button>
            {% endfor %}
            {% if section.settings.ring_on_hand_image != blank %}
              <button type="button" class="jk-media-thumb jk-media-thumb--support{% if product.media.size == 0 and section.settings.gallery_image == blank %} is-active{% endif %}" data-media-trigger="joyari-ring-on-hand" aria-label="View ring on hand visual">
                {{ section.settings.ring_on_hand_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', alt: section.settings.ring_on_hand_alt }}
              </button>
            {% endif %}
            {% if section.settings.diamond_closeup_image != blank %}
              <button type="button" class="jk-media-thumb jk-media-thumb--support{% if product.media.size == 0 and section.settings.gallery_image == blank and section.settings.ring_on_hand_image == blank %} is-active{% endif %}" data-media-trigger="joyari-diamond-closeup" aria-label="View diamond close-up visual">
                {{ section.settings.diamond_closeup_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', alt: section.settings.diamond_closeup_alt }}
              </button>
            {% endif %}
            {% if section.settings.product_video_url != blank or section.settings.product_video_file_url != blank %}
              <button type="button" class="jk-media-thumb jk-media-thumb--support" data-media-trigger="joyari-product-video" aria-label="View product video">
                <span class="jk-media-thumb__play" aria-hidden="true">▶</span>
              </button>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <div class="jk-product-panel">
        <div class="jk-product-panel__inner jk-product-panel__inner--builder">
          <div class="jk-product-panel__header">
            <p class="jk-eyebrow">Joyari fine jewellery</p>
            <h1>{{ product.title }}</h1>
            <p class="jk-product-subtitle">
              {% if product.type != blank %}
                {{ product.type }}
              {% else %}
                Made-to-order fine jewellery
              {% endif %}
            </p>

            {% assign product_summary = product.description | strip_html | replace: '\n', ' ' | truncate: 150 %}
            {% if product_summary != blank %}
              <p class="jk-product-short-description">{{ product_summary }}</p>
            {% endif %}

            <div class="jk-product-review-placeholder" aria-label="Private product guidance">
              <span class="jk-product-review-placeholder__stars" aria-hidden="true">Private guidance</span>
              <span>One-to-one support for sizing, stone selection, and design details.</span>
            </div>

            <div class="jk-product-metal-palette" aria-label="Available metal tones">
              <span class="jk-product-metal-palette__label">Metal tones</span>
              <span class="jk-product-metal-dot jk-product-metal-dot--platinum" title="Platinum"></span>
              <span class="jk-product-metal-dot jk-product-metal-dot--yellow" title="18K Yellow Gold"></span>
              <span class="jk-product-metal-dot jk-product-metal-dot--white" title="18K White Gold"></span>
              <span class="jk-product-metal-dot jk-product-metal-dot--rose" title="Rose Gold"></span>
            </div>

            <div class="jk-product-price-row">
              <p class="jk-product-price" data-variant-price>{{ selected_variant.price | money }}</p>
              {% if selected_variant.compare_at_price > selected_variant.price %}
                <p class="jk-product-compare" data-variant-compare>{{ selected_variant.compare_at_price | money }}</p>
              {% else %}
                <p class="jk-product-compare is-hidden" data-variant-compare></p>
              {% endif %}
            </div>

            <p class="jk-availability" data-availability>
              {% if selected_variant.available %}
                Available for secure checkout
              {% else %}
                This configuration is currently unavailable
              {% endif %}
            </p>
          </div>

          {% form 'product', product, id: product_form_id, class: 'jk-product-form', data-product-form: 'product' %}
            <input type="hidden" name="id" value="{{ selected_variant.id }}" data-variant-id-input>

            <div class="jk-ring-builder-card jk-ring-builder-card--product">
              <div class="jk-builder-card__header">
                <div>
                  <p class="jk-eyebrow">Simple selection</p>
                  <h2>{{ section.settings.builder_heading }}</h2>
                  <p class="jk-builder-subcopy">Select the available Shopify option for checkout, then add private design preferences for the Joyari team.</p>
                </div>
              </div>

              <div class="jk-builder-support-visuals" aria-label="Joyari product visual guidance">
                <div class="jk-builder-support-card">
                  {% if section.settings.metal_selector_image != blank %}
                    {{ section.settings.metal_selector_image | image_url: width: 680 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 12vw, 50vw', widths: '320, 480, 680', alt: section.settings.metal_selector_alt }}
                  {% elsif fallback_product_image_1 != blank %}
                    {{ fallback_product_image_1 | image_url: width: 680 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 12vw, 50vw', widths: '320, 480, 680', alt: product.title }}
                  {% else %}
                    {% render 'joyari-visual-placeholder', type: 'ring' %}
                  {% endif %}
                  <span>Metal tone</span>
                </div>
                <div class="jk-builder-support-card">
                  {% if section.settings.diamond_shape_image != blank %}
                    {{ section.settings.diamond_shape_image | image_url: width: 680 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 12vw, 50vw', widths: '320, 480, 680', alt: section.settings.diamond_shape_alt }}
                  {% elsif fallback_product_image_2 != blank %}
                    {{ fallback_product_image_2 | image_url: width: 680 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 12vw, 50vw', widths: '320, 480, 680', alt: product.title }}
                  {% elsif fallback_product_image_1 != blank %}
                    {{ fallback_product_image_1 | image_url: width: 680 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 12vw, 50vw', widths: '320, 480, 680', alt: product.title }}
                  {% else %}
                    {% render 'joyari-visual-placeholder', type: 'diamond' %}
                  {% endif %}
                  <span>Diamond shape</span>
                </div>
                <div class="jk-builder-support-card">
                  {% if section.settings.carat_size_image != blank %}
                    {{ section.settings.carat_size_image | image_url: width: 680 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 12vw, 50vw', widths: '320, 480, 680', alt: section.settings.carat_size_alt }}
                  {% elsif fallback_product_image_3 != blank %}
                    {{ fallback_product_image_3 | image_url: width: 680 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 12vw, 50vw', widths: '320, 480, 680', alt: product.title }}
                  {% elsif fallback_product_image_1 != blank %}
                    {{ fallback_product_image_1 | image_url: width: 680 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 12vw, 50vw', widths: '320, 480, 680', alt: product.title }}
                  {% else %}
                    {% render 'joyari-visual-placeholder', type: 'hand' %}
                  {% endif %}
                  <span>Carat &amp; fit</span>
                </div>
              </div>

              {% unless product.has_only_default_variant %}
                <div class="jk-builder-step jk-product-variant-group">
                  <div class="jk-builder-step__header">
                    <span class="jk-builder-step__number">01</span>
                    <div>
                      <h3>Available options</h3>
                      <p>Select the real Shopify variant for checkout.</p>
                    </div>
                  </div>

                  {% for option in product.options_with_values %}
                    {% assign selected_value = option.selected_value %}
                    {% assign option_key = 'option' | append: forloop.index %}
                    {% if selected_value == blank %}
                      {% assign selected_value = selected_variant[option_key] %}
                    {% endif %}

                    <fieldset class="jk-option-fieldset" data-option-position="{{ forloop.index }}" data-option-name="{{ option.name | escape }}">
                      <legend>{{ option.name }}</legend>
                      <div class="jk-swatch-row">
                        {% for value in option.values %}
                          {% assign option_id = 'BuilderOption-' | append: section.id | append: '-' | append: option.position | append: '-' | append: value | handleize %}
                          <input
                            id="{{ option_id }}"
                            type="radio"
                            name="options[{{ option.name | escape }}]"
                            value="{{ value | escape }}"
                            data-option-input
                            data-option-position="{{ forloop.parentloop.index }}"
                            {% if value == selected_value %}checked{% endif %}
                          >
                          <label for="{{ option_id }}">{{ value }}</label>
                        {% endfor %}
                      </div>
                    </fieldset>
                  {% endfor %}
                </div>
              {% endunless %}

              <div class="jk-builder-step jk-builder-step--design-preferences">
                <div class="jk-builder-step__header">
                  <span class="jk-builder-step__number">{% if product.has_only_default_variant %}01{% else %}02{% endif %}</span>
                  <div>
                    <h3>Design preferences</h3>
                    <p>Saved with your order request as custom details.</p>
                  </div>
                </div>

                <fieldset class="jk-option-fieldset jk-option-fieldset--metal">
                  <legend>Metal selector</legend>
                  <div class="jk-swatch-row jk-swatch-row--metal">
                    {% assign metals = 'Platinum,18K Yellow Gold,18K White Gold,Rose Gold' | split: ',' %}
                    {% for metal in metals %}
                      {% assign metal_id = 'MetalPreference-' | append: section.id | append: '-' | append: metal | handleize %}
                      {% liquid
                        assign metal_swatch = 'platinum'
                        if metal contains 'Yellow'
                          assign metal_swatch = 'yellow'
                        elsif metal contains 'White'
                          assign metal_swatch = 'white'
                        elsif metal contains 'Rose'
                          assign metal_swatch = 'rose'
                        endif
                      %}
                      <input id="{{ metal_id }}" type="radio" name="properties[Metal Preference]" value="{{ metal | escape }}" {% if forloop.first %}checked{% endif %}>
                      <label for="{{ metal_id }}"><span class="jk-metal-swatch jk-metal-swatch--{{ metal_swatch }}" aria-hidden="true"></span>{{ metal }}</label>
                    {% endfor %}
                  </div>
                </fieldset>

                <fieldset class="jk-option-fieldset jk-option-fieldset--shape">
                  <legend>Diamond shape selector</legend>
                  <div class="jk-shape-row">
                    {% assign shapes = 'Round,Oval,Emerald,Pear,Cushion,Princess,Marquise,Radiant' | split: ',' %}
                    {% for shape in shapes %}
                      {% assign shape_id = 'DiamondShapePreference-' | append: section.id | append: '-' | append: shape | handleize %}
                      {% assign shape_handle = shape | handleize %}
                      <input id="{{ shape_id }}" type="radio" name="properties[Diamond Shape]" value="{{ shape | escape }}" {% if forloop.first %}checked{% endif %}>
                      <label for="{{ shape_id }}">
                        <span class="jk-shape-chip">
                          <svg
                            class="jk-shape-icon jk-diamond-shape-icon jk-diamond-shape-icon--{{ shape_handle }}"
                            viewBox="0 0 64 64"
                            role="img"
                            aria-label="{{ shape | escape }} diamond cut icon"
                            focusable="false"
                            xmlns="http://www.w3.org/2000/svg"
                          >
                            {% case shape_handle %}
                              {% when 'round' %}
                                <circle cx="32" cy="32" r="25"></circle>
                                <circle cx="32" cy="32" r="13"></circle>
                                <path d="M32 7v12M32 45v12M7 32h12M45 32h12M14.4 14.4l8.5 8.5M41.1 41.1l8.5 8.5M49.6 14.4l-8.5 8.5M22.9 41.1l-8.5 8.5"></path>
                                <path d="M19 32l13-13 13 13-13 13Z"></path>
                              {% when 'oval' %}
                                <ellipse cx="32" cy="32" rx="20" ry="27"></ellipse>
                                <ellipse cx="32" cy="32" rx="10" ry="15"></ellipse>
                                <path d="M32 5v12M32 47v12M14 18l10 8M50 18l-10 8M14 46l10-8M50 46l-10-8M12 32h40"></path>
                                <path d="M24 26l8-9 8 9-8 21Z"></path>
                              {% when 'emerald' %}
                                <path d="M18 7h28l11 11v28L46 57H18L7 46V18Z"></path>
                                <path d="M22 16h20l6 6v20l-6 6H22l-6-6V22Z"></path>
                                <path d="M18 7l4 9M46 7l-4 9M57 18l-9 4M57 46l-9-4M46 57l-4-9M18 57l4-9M7 46l9-4M7 18l9 4"></path>
                                <path d="M22 32h20M32 16v32"></path>
                              {% when 'pear' %}
                                <path d="M32 5C18 19 11 31 13 43c1.7 10 9.7 16 19 16s17.3-6 19-16C53 31 46 19 32 5Z"></path>
                                <path d="M32 5v54M18 40l14-17 14 17M21 50l11-10 11 10"></path>
                                <path d="M20 24l12 16 12-16"></path>
                              {% when 'cushion' %}
                                <path d="M20 7h24c7 0 13 6 13 13v24c0 7-6 13-13 13H20c-7 0-13-6-13-13V20C7 13 13 7 20 7Z"></path>
                                <path d="M22 16h20c4.5 0 6 1.5 6 6v20c0 4.5-1.5 6-6 6H22c-4.5 0-6-1.5-6-6V22c0-4.5 1.5-6 6-6Z"></path>
                                <path d="M16 22l16 10 16-10M16 42l16-10 16 10M22 16l10 16 10-16M22 48l10-16 10 16"></path>
                              {% when 'princess' %}
                                <path d="M10 10h44v44H10Z"></path>
                                <path d="M18 18h28v28H18Z"></path>
                                <path d="M10 10l22 22 22-22M10 54l22-22 22 22M10 10l44 44M54 10L10 54"></path>
                                <path d="M32 10v44M10 32h44"></path>
                              {% when 'marquise' %}
                                <path d="M5 32c8.5-14 17.5-21 27-21s18.5 7 27 21c-8.5 14-17.5 21-27 21S13.5 46 5 32Z"></path>
                                <path d="M5 32h54M32 11v42M17 22l15 10 15-10M17 42l15-10 15 10"></path>
                                <path d="M13 32l19-21 19 21-19 21Z"></path>
                              {% when 'radiant' %}
                                <path d="M17 7h30l10 10v30L47 57H17L7 47V17Z"></path>
                                <path d="M20 17h24l3 3v24l-3 3H20l-3-3V20Z"></path>
                                <path d="M17 7l15 25 15-25M17 57l15-25 15 25M7 17l25 15L57 17M7 47l25-15 25 15"></path>
                                <path d="M32 7v50M7 32h50"></path>
                              {% else %}
                                <circle cx="32" cy="32" r="25"></circle>
                                <circle cx="32" cy="32" r="13"></circle>
                                <path d="M32 7v12M32 45v12M7 32h12M45 32h12M14.4 14.4l8.5 8.5M41.1 41.1l8.5 8.5M49.6 14.4l-8.5 8.5M22.9 41.1l-8.5 8.5"></path>
                                <path d="M19 32l13-13 13 13-13 13Z"></path>
                            {% endcase %}
                          </svg>
                          <span>{{ shape }}</span>
                        </span>
                      </label>
                    {% endfor %}
                  </div>
                </fieldset>

                <div class="jk-builder-field jk-builder-field--carat-preference">
                  <label for="CaratPreference-{{ section.id }}">Carat selector</label>
                  <select id="CaratPreference-{{ section.id }}" name="properties[Carat Preference]">
                    <option value="0.50 ct">0.50 ct</option>
                    <option value="1.00 ct" selected>1.00 ct</option>
                    <option value="1.50 ct">1.50 ct</option>
                    <option value="2.00 ct">2.00 ct</option>
                    <option value="2.50 ct">2.50 ct</option>
                    <option value="3.00 ct">3.00 ct</option>
                    <option value="Private guidance">Private guidance</option>
                  </select>
                </div>
              </div>

              {% if show_ring_size_selector %}
                <div class="jk-builder-step jk-builder-step--ring-size">
                  <div class="jk-builder-step__header">
                    <span class="jk-builder-step__number">{% if product.has_only_default_variant %}02{% else %}03{% endif %}</span>
                    <div>
                      <h3>Ring size</h3>
                      <p>Saved as a line item property, not a variant.</p>
                    </div>
                  </div>

                  {% liquid
                    assign ring_size_select_id = 'RingSize-' | append: section.id
                    assign ring_size_modal_id = 'RingSizeGuide-' | append: section.id
                  %}
                  {% render 'ring-size-selector', select_id: ring_size_select_id, modal_id: ring_size_modal_id %}
                </div>
              {% endif %}

              <div class="jk-builder-step jk-builder-step--custom-nudge">
                <div class="jk-builder-step__header">
                  <span class="jk-builder-step__number">
                    {% if show_ring_size_selector %}
                      {% if product.has_only_default_variant %}03{% else %}04{% endif %}
                    {% else %}
                      {% if product.has_only_default_variant %}02{% else %}03{% endif %}
                    {% endif %}
                  </span>
                  <div>
                    <h3>Need a custom version?</h3>
                    <p>Prefer a different metal, size, diamond shape or personal detail? Share your vision and our team will guide you.</p>
                  </div>
                </div>
                <a class="jk-text-link" href="#JoyariCustomRequest-{{ section.id }}">Request a Custom Version</a>
              </div>

              <div class="jk-product-actions">
                <button type="submit" name="add" class="jk-button jk-button--primary jk-add-to-cart" data-add-to-cart {% unless selected_variant.available %}disabled{% endunless %}>
                  {% if selected_variant.available %}
                    {{ 'products.product.add_to_cart' | t }}
                  {% else %}
                    {{ 'products.product.sold_out' | t }}
                  {% endif %}
                </button>
                <p class="jk-availability" data-availability>
                  {% if selected_variant.available %}
                    Available for secure checkout
                  {% else %}
                    This configuration is currently unavailable
                  {% endif %}
                </p>
                <a class="jk-button jk-button--secondary jk-product-enquiry-button" href="/pages/contact">Enquire or book appointment</a>
              </div>
            </div>
          {% endform %}

          <div class="jk-builder-trust-grid" aria-label="Joyari trust badges">
            <span class="jk-trust-badge">Lab-grown diamonds</span>
            <span class="jk-trust-badge">Certified stones</span>
            <span class="jk-trust-badge">Worldwide shipping</span>
            <span class="jk-trust-badge">Custom handcrafted jewellery</span>
          </div>

          <div class="jk-accordions jk-product-info-accordions" aria-label="Product service information">
            <details open>
              <summary>Product details</summary>
              <p>Review the product description below for setting notes, metal information, proportions, and the design details that make this piece feel personal.</p>
            </details>
            <details>
              <summary>Diamond details</summary>
              <p>Eligible designs can be paired with certified lab-grown diamonds selected for brilliance, proportion, colour, clarity, and documentation.</p>
            </details>
            <details>
              <summary>Shipping &amp; returns</summary>
              <p>Each Joyari Krafted piece is prepared with insured delivery and careful presentation. Made-to-order timelines and return eligibility are confirmed before dispatch.</p>
            </details>
            <details>
              <summary>Customisation</summary>
              <p>For a different metal, diamond shape, engraving, hidden halo, band profile, or private design detail, request a custom version and our team will guide the next step.</p>
            </details>
            <details>
              <summary>Ring size guide</summary>
              <p>Use the size guide beside the ring-size selector to compare AUS/UK, US/Canada, EU, inside diameter, and circumference. Wider bands may need a half size up.</p>
            </details>
          </div>
        </div>
      </div>
    </div>

    {% liquid
      assign custom_request_id = 'JoyariCustomRequest-' | append: section.id
    %}
    {% render 'product-custom-request', request_id: custom_request_id %}

    <div class="jk-product-description">
      <div>
        <p class="jk-eyebrow">Product details</p>
        <h2>Designed for brilliance, comfort, and permanence</h2>
      </div>
      <div class="rte">
        {% if product.description != blank %}
          {{ product.description }}
        {% else %}
          <p>This Joyari Krafted piece is presented with attention to diamond presence, metal finish, comfort, and long-term wear. Contact our team for stone documentation, setting guidance, and customisation details before ordering.</p>
        {% endif %}
      </div>
    </div>

    <div class="jk-product-editorial-visuals" aria-label="Joyari craftsmanship and presentation visuals">
      <article class="jk-product-editorial-card">
        <div class="jk-product-editorial-card__media">
          {% if section.settings.craftsmanship_image != blank %}
            {{ section.settings.craftsmanship_image | image_url: width: 1100 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 31vw, 100vw', widths: '480, 720, 960, 1100', alt: section.settings.craftsmanship_alt }}
          {% elsif fallback_product_image_4 != blank %}
            {{ fallback_product_image_4 | image_url: width: 1100 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 31vw, 100vw', widths: '480, 720, 960, 1100', alt: product.title }}
          {% elsif fallback_product_image_1 != blank %}
            {{ fallback_product_image_1 | image_url: width: 1100 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 31vw, 100vw', widths: '480, 720, 960, 1100', alt: product.title }}
          {% else %}
            {% render 'joyari-visual-placeholder', type: 'craft' %}
          {% endif %}
        </div>
        <div class="jk-product-editorial-card__body">
          <span>The atelier</span>
          <h3>Crafted with quiet precision</h3>
          <p>Use this visual slot for bench work, stone setting, polishing, or a close detail of the finished piece.</p>
        </div>
      </article>

      <article class="jk-product-editorial-card">
        <div class="jk-product-editorial-card__media">
          {% if section.settings.packaging_image != blank %}
            {{ section.settings.packaging_image | image_url: width: 1100 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 31vw, 100vw', widths: '480, 720, 960, 1100', alt: section.settings.packaging_alt }}
          {% elsif fallback_product_image_5 != blank %}
            {{ fallback_product_image_5 | image_url: width: 1100 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 31vw, 100vw', widths: '480, 720, 960, 1100', alt: product.title }}
          {% elsif fallback_product_image_2 != blank %}
            {{ fallback_product_image_2 | image_url: width: 1100 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 31vw, 100vw', widths: '480, 720, 960, 1100', alt: product.title }}
          {% elsif fallback_product_image_1 != blank %}
            {{ fallback_product_image_1 | image_url: width: 1100 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 31vw, 100vw', widths: '480, 720, 960, 1100', alt: product.title }}
          {% else %}
            {% render 'joyari-visual-placeholder', type: 'box' %}
          {% endif %}
        </div>
        <div class="jk-product-editorial-card__body">
          <span>The reveal</span>
          <h3>Presented with ceremony</h3>
          <p>Show the box, certificate, care card, or unboxing moment that helps clients feel confident before purchase.</p>
        </div>
      </article>

      <article class="jk-product-editorial-card">
        <div class="jk-product-editorial-card__media">
          {% if section.settings.cta_image != blank %}
            {{ section.settings.cta_image | image_url: width: 1100 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 31vw, 100vw', widths: '480, 720, 960, 1100', alt: section.settings.cta_image_alt }}
          {% elsif fallback_product_image_6 != blank %}
            {{ fallback_product_image_6 | image_url: width: 1100 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 31vw, 100vw', widths: '480, 720, 960, 1100', alt: product.title }}
          {% elsif fallback_product_image_3 != blank %}
            {{ fallback_product_image_3 | image_url: width: 1100 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 31vw, 100vw', widths: '480, 720, 960, 1100', alt: product.title }}
          {% elsif fallback_product_image_1 != blank %}
            {{ fallback_product_image_1 | image_url: width: 1100 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 31vw, 100vw', widths: '480, 720, 960, 1100', alt: product.title }}
          {% else %}
            {% render 'joyari-visual-placeholder', type: 'hand' %}
          {% endif %}
        </div>
        <div class="jk-product-editorial-card__body">
          <span>Private guidance</span>
          <h3>Refine the ring with us</h3>
          <p>Use this space for a proposal, hand model, styling image, or appointment-led custom design moment.</p>
        </div>
      </article>
    </div>

    <div class="jk-mobile-atc" data-mobile-atc>
      <div>
        <span>{{ product.title }}</span>
        <strong data-estimate-total>{{ selected_variant.price | money }}</strong>
      </div>
      <button type="submit" name="add" form="{{ product_form_id }}" class="jk-button jk-button--primary" data-add-to-cart {% unless selected_variant.available %}disabled{% endunless %}>
        {% if selected_variant.available %}
          {{ 'products.product.add_to_cart' | t }}
        {% else %}
          {{ 'products.product.sold_out' | t }}
        {% endif %}
      </button>
    </div>
  {% else %}
    <div class="jk-section__header">
      <p class="jk-eyebrow">Joyari Krafted</p>
      <h1>Product details</h1>
      <p>Add product information in Shopify admin to complete this fine jewellery page.</p>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Product builder main",
  "tag": "section",
  "class": "shopify-section--product-builder-main",
  "settings": [
    {
      "type": "text",
      "id": "builder_heading",
      "label": "Builder heading",
      "default": "Design your Joyari piece"
    },
    {
      "type": "header",
      "content": "Product gallery visuals"
    },
    {
      "type": "image_picker",
      "id": "gallery_image",
      "label": "Hero/product gallery image"
    },
    {
      "type": "text",
      "id": "gallery_image_alt",
      "label": "Hero/product gallery image alt text",
      "default": "Joyari Krafted diamond ring"
    },
    {
      "type": "image_picker",
      "id": "ring_on_hand_image",
      "label": "Ring on hand image"
    },
