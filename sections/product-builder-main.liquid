  }

  .jk-product-builder-main .jk-builder-field--quality-select select,
  .jk-product-builder-main .jk-builder-field--engraving input {
    width: 100% !important;
    min-height: 48px !important;
    padding: 0 13px !important;
    border: 1px solid rgba(17, 17, 17, .22) !important;
    border-radius: 2px !important;
    background: #FFFFFF !important;
    color: #111111 !important;
    font-family: var(--jk-font-body, Inter, Arial, sans-serif) !important;
    font-size: .94rem !important;
    font-weight: 400 !important;
    box-shadow: none !important;
  }

  @media (max-width: 680px) {
    .jk-product-builder-main .jk-builder-quality-grid {
      grid-template-columns: 1fr !important;
      gap: 0 !important;
    }
  }
</style>

<section class="jk-product-template jk-product-builder-main" data-product-builder data-quarter-premium="{{ section.settings.carat_quarter_premium }}" data-base-carat="1">
  {% if product != blank %}
    <script type="application/json" data-product-json>{{ product | json }}</script>

    <div class="jk-product-layout jk-product-layout--builder">
      <div class="jk-product-gallery{% if product_gallery_media_count > 1 %} jk-product-gallery--with-thumbs{% endif %}" data-product-gallery>
        <div class="jk-product-gallery__main">
          {% if product_gallery_media_count > 0 %}
            {% if section.settings.gallery_image != blank %}
              <figure class="jk-product-media jk-product-media--support is-active" data-media-id="joyari-gallery-image" data-media-type="image">
                {{ section.settings.gallery_image | image_url: width: 1800 | image_tag: loading: 'eager', sizes: '(min-width: 1080px) 62vw, 100vw', widths: '640, 900, 1200, 1600, 1800', alt: section.settings.gallery_image_alt }}
                <figcaption class="jk-product-media__caption">Hero visual</figcaption>
              </figure>
            {% endif %}

            {% for media in product.media %}
              <figure class="jk-product-media jk-product-media--{{ media.media_type }}{% if forloop.first and section.settings.gallery_image == blank %} is-active{% endif %}" data-media-id="{{ media.id }}" data-image-id="{{ media.preview_image.id | default: media.id }}" data-media-type="{{ media.media_type }}">
                {% render 'product-media', media: media, product: product, mode: 'main' %}
              </figure>
            {% endfor %}

            {% assign support_media_index = product.media.size %}
            {% if section.settings.ring_on_hand_image != blank or has_generated_ring_on_hand %}
              {% assign support_media_index = support_media_index | plus: 1 %}
              <figure class="jk-product-media jk-product-media--support{% if product.media.size == 0 and section.settings.gallery_image == blank %} is-active{% endif %}" data-media-id="joyari-ring-on-hand" data-media-type="image">
                {% if section.settings.ring_on_hand_image != blank %}
                  {{ section.settings.ring_on_hand_image | image_url: width: 1800 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 62vw, 100vw', widths: '640, 900, 1200, 1600, 1800', alt: section.settings.ring_on_hand_alt }}
                {% else %}
                  {% render 'joyari-generated-image', file: 'joyari-product-pear-ring-on-hand.jpg', alt: section.settings.ring_on_hand_alt, class: 'jk-product-media__image' %}
                {% endif %}
                <figcaption class="jk-product-media__caption">Ring on hand</figcaption>
              </figure>
            {% endif %}

            {% if section.settings.diamond_closeup_image != blank or has_generated_diamond_closeup %}
              {% assign support_media_index = support_media_index | plus: 1 %}
              <figure class="jk-product-media jk-product-media--support" data-media-id="joyari-diamond-closeup" data-media-type="image">
                {% if section.settings.diamond_closeup_image != blank %}
                  {{ section.settings.diamond_closeup_image | image_url: width: 1800 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 62vw, 100vw', widths: '640, 900, 1200, 1600, 1800', alt: section.settings.diamond_closeup_alt }}
                {% else %}
                  {% render 'joyari-generated-image', file: 'joyari-diamond-macro-pear.jpg', alt: section.settings.diamond_closeup_alt, class: 'jk-product-media__image' %}
                {% endif %}
                <figcaption class="jk-product-media__caption">Diamond detail</figcaption>
              </figure>
            {% endif %}

            {% if section.settings.product_video_url != blank or section.settings.product_video_file_url != blank %}
              {% assign support_media_index = support_media_index | plus: 1 %}
              <figure class="jk-product-media jk-product-media--video{% if product.media.size == 0 and section.settings.gallery_image == blank and section.settings.ring_on_hand_image == blank and section.settings.diamond_closeup_image == blank %} is-active{% endif %}" data-media-id="joyari-product-video" data-media-type="video">
                {% if section.settings.product_video_file_url != blank %}
                  <video controls playsinline preload="metadata">
                    <source src="{{ section.settings.product_video_file_url }}" type="video/mp4">
                  </video>
                {% else %}
                  {{ section.settings.product_video_url | external_video_tag }}
                {% endif %}
                <figcaption class="jk-product-media__caption">Product video</figcaption>
              </figure>
            {% endif %}

            {% if product_gallery_media_count > 1 %}
              <div class="jk-product-gallery__arrows" aria-label="Product media navigation">
                <button type="button" class="jk-product-gallery__arrow jk-product-gallery__arrow--prev" data-media-previous aria-label="Previous product media">
                  <span aria-hidden="true">&lsaquo;</span>
                </button>
                <button type="button" class="jk-product-gallery__arrow jk-product-gallery__arrow--next" data-media-next aria-label="Next product media">
                  <span aria-hidden="true">&rsaquo;</span>
                </button>
              </div>
            {% endif %}
          {% else %}
            <figure class="jk-product-media is-active">
              {% render 'joyari-generated-image', file: 'joyari-product-pear-ring-on-hand.jpg', alt: product.title, class: 'jk-product-media__image', loading: 'eager' %}
            </figure>
          {% endif %}
        </div>

        {% if product_gallery_media_count > 1 %}
          <div class="jk-product-gallery__thumbs" aria-label="Product media">
            {% if section.settings.gallery_image != blank %}
              <button type="button" class="jk-media-thumb jk-media-thumb--support is-active" data-media-trigger="joyari-gallery-image" aria-label="View hero visual">
                {{ section.settings.gallery_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', alt: section.settings.gallery_image_alt }}
              </button>
            {% endif %}
            {% for media in product.media %}
              <button type="button" class="jk-media-thumb jk-media-thumb--{{ media.media_type }}{% if forloop.first and section.settings.gallery_image == blank %} is-active{% endif %}" data-media-trigger="{{ media.id }}" data-image-trigger="{{ media.preview_image.id | default: media.id }}" aria-label="View media {{ forloop.index }}">
                {% render 'product-media', media: media, product: product, mode: 'thumbnail' %}
              </button>
            {% endfor %}
            {% if section.settings.ring_on_hand_image != blank or has_generated_ring_on_hand %}
              <button type="button" class="jk-media-thumb jk-media-thumb--support{% if product.media.size == 0 and section.settings.gallery_image == blank %} is-active{% endif %}" data-media-trigger="joyari-ring-on-hand" aria-label="View ring on hand visual">
                {% if section.settings.ring_on_hand_image != blank %}
                  {{ section.settings.ring_on_hand_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', alt: section.settings.ring_on_hand_alt }}
                {% else %}
                  {% render 'joyari-generated-image', file: 'joyari-product-pear-ring-on-hand.jpg', alt: section.settings.ring_on_hand_alt, class: 'jk-media-thumb__image' %}
                {% endif %}
              </button>
            {% endif %}
            {% if section.settings.diamond_closeup_image != blank or has_generated_diamond_closeup %}
              <button type="button" class="jk-media-thumb jk-media-thumb--support" data-media-trigger="joyari-diamond-closeup" aria-label="View diamond close-up visual">
                {% if section.settings.diamond_closeup_image != blank %}
                  {{ section.settings.diamond_closeup_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', alt: section.settings.diamond_closeup_alt }}
                {% else %}
                  {% render 'joyari-generated-image', file: 'joyari-diamond-macro-pear.jpg', alt: section.settings.diamond_closeup_alt, class: 'jk-media-thumb__image' %}
                {% endif %}
              </button>
            {% endif %}
            {% if section.settings.product_video_url != blank or section.settings.product_video_file_url != blank %}
              <button type="button" class="jk-media-thumb jk-media-thumb--support" data-media-trigger="joyari-product-video" aria-label="View product video">
                <span class="jk-media-thumb__play" aria-hidden="true">▶</span>
              </button>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <div class="jk-product-panel">
        <div class="jk-product-panel__inner jk-product-panel__inner--builder">
          <div class="jk-product-panel__header">
            <p class="jk-eyebrow">Joyari fine jewellery</p>
            <h1>{{ product.title }}</h1>
            <p class="jk-product-subtitle">
              {% if product.type != blank %}
                {{ product.type }}
              {% else %}
                Made-to-order fine jewellery
              {% endif %}
            </p>

            <div class="jk-product-price-row">
              <p class="jk-product-price" data-variant-price>AUD ${{ selected_variant.price | money_without_currency | replace: '.00', '' }}</p>
              {% if selected_variant.compare_at_price > selected_variant.price %}
                <p class="jk-product-compare" data-variant-compare>AUD ${{ selected_variant.compare_at_price | money_without_currency | replace: '.00', '' }}</p>
              {% else %}
                <p class="jk-product-compare is-hidden" data-variant-compare></p>
              {% endif %}
            </div>

            <div class="jk-product-review-placeholder" aria-label="Reviews and product guidance">
              <span class="jk-product-review-placeholder__stars" aria-hidden="true">★★★★★</span>
              <span>Private guidance for sizing, stone selection, and design details.</span>
            </div>

            {% assign product_summary = product.description | strip_html | replace: '\n', ' ' | truncate: 170 %}
            {% if product_summary != blank %}
              <p class="jk-product-short-description">{{ product_summary }}</p>
            {% else %}
              <p class="jk-product-short-description">A refined Joyari Krafted piece designed around luminous stones, considered proportions, and a calm made-to-order experience.</p>
            {% endif %}

            <p class="jk-availability" data-availability>
              {% if selected_variant.available %}
                Available for secure checkout
              {% else %}
                This configuration is currently unavailable
              {% endif %}
            </p>
          </div>

          {% form 'product', product, id: product_form_id, class: 'jk-product-form', data-product-form: 'product' %}
            <input type="hidden" name="id" value="{{ selected_variant.id }}" data-variant-id-input>

            <div class="jk-ring-builder-card jk-ring-builder-card--product">
              {% if show_builder_flow %}
                <nav class="jk-builder-flow-tabs" aria-label="Build your ring flow">
                  <span class="is-active" aria-current="step">Setting</span>
                  {% if show_gemstone_step %}
                    <span>Gemstone</span>
                  {% endif %}
                  <span>Personalise</span>
                  <span>Add To Cart</span>
                </nav>
              {% endif %}

              <div class="jk-builder-step jk-builder-step--design-preferences">
                <div class="jk-builder-step__header">
                  <div>
                    <h3>Setting</h3>
                    <p>Select the metal and size details for your setting. These choices are saved privately with your order.</p>
                  </div>
                </div>

                <div class="jk-builder-field jk-builder-field--metal-select">
                  <label for="MetalPreference-{{ section.id }}">Metal</label>
                  <select id="MetalPreference-{{ section.id }}" name="properties[Metal]" data-metal-select>
                    {% assign metals = '10K Yellow Gold,10K White Gold,10K Rose Gold,14K Yellow Gold,14K White Gold,14K Rose Gold,18K Yellow Gold,18K White Gold,18K Rose Gold,Platinum' | split: ',' %}
                    {% for metal in metals %}
                      <option value="{{ metal | escape }}" {% if forloop.first %}selected{% endif %}>{{ metal }}</option>
                    {% endfor %}
                  </select>
                </div>

                {% if show_ring_size_selector %}
                  {% liquid
                    assign ring_size_select_id = 'RingSize-' | append: section.id
                    assign ring_size_modal_id = 'RingSizeGuide-' | append: section.id
                  %}
                  {% render 'ring-size-selector', select_id: ring_size_select_id, modal_id: ring_size_modal_id %}
                {% endif %}

                <div class="jk-builder-field jk-builder-field--quality-select jk-builder-field--stone-type">
                  <label for="StoneTypePreference-{{ section.id }}">Stone type</label>
                  <select id="StoneTypePreference-{{ section.id }}" name="properties[Stone Type]" data-stone-type-select>
                    <option value="Lab-Grown Diamond" selected>Lab-Grown Diamond</option>
                    <option value="Moissanite">Moissanite</option>
                    <option value="Coloured Lab-Grown Diamond">Coloured Lab-Grown Diamond</option>
                  </select>
                </div>

                {% if show_gemstone_step == false %}
                  <div class="jk-builder-quality-grid" aria-label="Stone quality preferences" data-stone-quality-fields>
                    <div class="jk-builder-field jk-builder-field--quality-select">
                      <label for="ColourPreference-{{ section.id }}">Colour</label>
                      <select id="ColourPreference-{{ section.id }}" name="properties[Colour]" data-colour-select>
                        {% assign colour_options = 'D,E,F,G' | split: ',' %}
                        {% for colour in colour_options %}
                          <option value="{{ colour | escape }}" {% if forloop.first %}selected{% endif %}>{{ colour }}</option>
                        {% endfor %}
                      </select>
                    </div>

                    <div class="jk-builder-field jk-builder-field--quality-select">
                      <label for="ClarityPreference-{{ section.id }}">Clarity</label>
                      <select id="ClarityPreference-{{ section.id }}" name="properties[Clarity]">
                        {% assign clarity_options = 'VVS1,VVS2,VS1,VS2' | split: ',' %}
                        {% for clarity in clarity_options %}
                          <option value="{{ clarity | escape }}" {% if forloop.first %}selected{% endif %}>{{ clarity }}</option>
                        {% endfor %}
                      </select>
                    </div>
                  </div>
                {% endif %}

                <div class="jk-builder-field jk-builder-field--engraving">
                  <label for="EngravingPreference-{{ section.id }}">Free engraving</label>
                  <input
                    id="EngravingPreference-{{ section.id }}"
                    type="text"
                    name="properties[Engraving]"
                    maxlength="40"
                    placeholder="Initials, date, or short message"
                  >
                </div>

                {% if show_gemstone_step %}
                  <a class="jk-button jk-button--primary jk-builder-continue-button" href="/pages/custom-design?activeTab=Lab+Grown&amp;queryLabGrown=true">Choose Your Stone</a>
                {% endif %}
              </div>

              {% unless product.has_only_default_variant %}
                {% liquid
                  assign visible_variant_option_count = 0
                  for option in product.options_with_values
                    assign option_name_downcase = option.name | downcase
                    unless option_name_downcase contains 'setting' or option_name_downcase contains 'metal' or option_name_downcase contains 'material'
                      assign visible_variant_option_count = visible_variant_option_count | plus: 1
                    endunless
                  endfor
                %}
                <div class="jk-builder-step jk-product-variant-group{% if visible_variant_option_count == 0 %} jk-product-variant-group--hidden{% endif %}"{% if visible_variant_option_count == 0 %} hidden aria-hidden="true"{% endif %}>
                  <div class="jk-builder-step__header">
                    <span class="jk-builder-step__number">02</span>
                    <div>
                      <h3>Choose available product option</h3>
                      <p>Select the real Shopify variant for checkout, such as carat size or material.</p>
                    </div>
                  </div>

                  {% for option in product.options_with_values %}
                    {% assign selected_value = option.selected_value %}
                    {% assign option_key = 'option' | append: forloop.index %}
                    {% assign option_name_downcase = option.name | downcase %}
                    {% assign hide_setting_option = false %}
                    {% if selected_value == blank %}
                      {% assign selected_value = selected_variant[option_key] %}
                    {% endif %}
                    {% if option_name_downcase contains 'setting' or option_name_downcase contains 'metal' or option_name_downcase contains 'material' %}
                      {% assign hide_setting_option = true %}
                    {% endif %}

                    <fieldset class="jk-option-fieldset{% if hide_setting_option %} jk-option-fieldset--hidden-setting{% endif %}" data-option-position="{{ forloop.index }}" data-option-name="{{ option.name | escape }}"{% if hide_setting_option %} hidden aria-hidden="true"{% endif %}>
                      <legend>{{ option.name }}</legend>
                      <div class="jk-swatch-row">
                        {% for value in option.values %}
                          {% assign option_id = 'BuilderOption-' | append: section.id | append: '-' | append: option.position | append: '-' | append: value | handleize %}
                          <input
                            id="{{ option_id }}"
                            type="radio"
                            name="options[{{ option.name | escape }}]"
                            value="{{ value | escape }}"
                            data-option-input
                            data-option-position="{{ forloop.parentloop.index }}"
                            {% if value == selected_value %}checked{% endif %}
                          >
                          <label for="{{ option_id }}">{{ value }}</label>
                        {% endfor %}
                      </div>
                    </fieldset>
                  {% endfor %}
                </div>
              {% endunless %}

              <div class="jk-product-actions">
                <button type="submit" name="add" class="jk-button jk-button--primary jk-add-to-cart" data-add-to-cart {% unless selected_variant.available %}disabled{% endunless %}>
                  {% if selected_variant.available %}
                    {{ 'products.product.add_to_cart' | t }}
                  {% else %}
                    {{ 'products.product.sold_out' | t }}
                  {% endif %}
                </button>
                <p class="jk-availability" data-availability>
                  {% if selected_variant.available %}
                    Available for secure checkout
                  {% else %}
                    This configuration is currently unavailable
                  {% endif %}
                </p>
                <a class="jk-button jk-button--secondary jk-product-enquiry-button" href="/pages/contact">Enquire or Book Appointment</a>
                <div class="jk-product-text-links" aria-label="Product enquiry links">
                  <a href="/pages/contact">Send a hint</a>
                  <a href="/pages/contact">Make an enquiry</a>
                </div>
              </div>
            </div>
          {% endform %}

          <div class="jk-builder-trust-grid" aria-label="Joyari trust badges">
            <span class="jk-trust-badge">
              <span class="jk-trust-badge__icon" aria-hidden="true">∞</span>
              Lifetime Warranty
            </span>
            <span class="jk-trust-badge">
              <span class="jk-trust-badge__icon" aria-hidden="true">↕</span>
              Free Resizing
            </span>
            <span class="jk-trust-badge">
              <span class="jk-trust-badge__icon" aria-hidden="true">✓</span>
              Free Express &amp; Insured Delivery
            </span>
          </div>

          <div class="jk-accordions jk-product-info-accordions" aria-label="Product service information">
            <details open>
              <summary>Product details</summary>
              <p>Review the product description below for setting notes, metal information, proportions, and the design details that make this piece feel personal.</p>
            </details>
            <details>
              <summary>Diamond details</summary>
              <p>Eligible designs can be paired with certified lab-grown diamonds selected for brilliance, proportion, colour, clarity, and documentation.</p>
            </details>
            <details>
              <summary>Shipping &amp; returns</summary>
              <p>Each Joyari Krafted piece is prepared with insured delivery and careful presentation. Made-to-order timelines and return eligibility are confirmed before dispatch.</p>
            </details>
            <details>
              <summary>Customisation</summary>
              <p>For a different metal, diamond shape, engraving, hidden halo, band profile, or private design detail, request a custom version and our team will guide the next step.</p>
            </details>
            <details>
              <summary>Ring size guide</summary>
              <p>Use the size guide beside the ring-size selector to compare AUS/UK, US/Canada, EU, inside diameter, and circumference. Wider bands may need a half size up.</p>
            </details>
          </div>
        </div>
      </div>
    </div>

    {% liquid
      assign custom_request_id = 'JoyariCustomRequest-' | append: section.id
    %}
    {% render 'product-custom-request', request_id: custom_request_id %}

    <div class="jk-product-description">
      <div>
        <p class="jk-eyebrow">Product details</p>
        <h2>Designed for brilliance, comfort, and permanence</h2>
      </div>
      <div class="rte">
        {% if product.description != blank %}
          {{ product.description }}
        {% else %}
          <p>This Joyari Krafted piece is presented with attention to diamond presence, metal finish, comfort, and long-term wear. Contact our team for stone documentation, setting guidance, and customisation details before ordering.</p>
        {% endif %}
      </div>
    </div>

    <div class="jk-product-editorial-visuals" aria-label="Joyari craftsmanship and presentation visuals">
      <article class="jk-product-editorial-card">
        <div class="jk-product-editorial-card__media">
          {% if section.settings.craftsmanship_image != blank %}
            {{ section.settings.craftsmanship_image | image_url: width: 1100 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 31vw, 100vw', widths: '480, 720, 960, 1100', alt: section.settings.craftsmanship_alt }}
          {% elsif fallback_product_image_4 != blank %}
            {{ fallback_product_image_4 | image_url: width: 1100 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 31vw, 100vw', widths: '480, 720, 960, 1100', alt: product.title }}
          {% elsif fallback_product_image_1 != blank %}
            {{ fallback_product_image_1 | image_url: width: 1100 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 31vw, 100vw', widths: '480, 720, 960, 1100', alt: product.title }}
          {% else %}
            {% render 'joyari-generated-image', file: 'joyari-atelier-craftsmanship.jpg', alt: section.settings.craftsmanship_alt, class: 'jk-product-editorial-card__image' %}
          {% endif %}
        </div>
        <div class="jk-product-editorial-card__body">
          <span>The atelier</span>
          <h3>Crafted with quiet precision</h3>
          <p>Use this visual slot for bench work, stone setting, polishing, or a close detail of the finished piece.</p>
        </div>
      </article>

      <article class="jk-product-editorial-card">
        <div class="jk-product-editorial-card__media">
          {% if section.settings.packaging_image != blank %}
            {{ section.settings.packaging_image | image_url: width: 1100 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 31vw, 100vw', widths: '480, 720, 960, 1100', alt: section.settings.packaging_alt }}
          {% elsif fallback_product_image_5 != blank %}
            {{ fallback_product_image_5 | image_url: width: 1100 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 31vw, 100vw', widths: '480, 720, 960, 1100', alt: product.title }}
          {% elsif fallback_product_image_2 != blank %}
            {{ fallback_product_image_2 | image_url: width: 1100 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 31vw, 100vw', widths: '480, 720, 960, 1100', alt: product.title }}
          {% elsif fallback_product_image_1 != blank %}
            {{ fallback_product_image_1 | image_url: width: 1100 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 31vw, 100vw', widths: '480, 720, 960, 1100', alt: product.title }}
          {% else %}
            {% render 'joyari-generated-image', file: 'joyari-packaging-certificate.jpg', alt: section.settings.packaging_alt, class: 'jk-product-editorial-card__image' %}
          {% endif %}
        </div>
        <div class="jk-product-editorial-card__body">
          <span>The reveal</span>
          <h3>Presented with ceremony</h3>
          <p>Show the box, certificate, care card, or unboxing moment that helps clients feel confident before purchase.</p>
        </div>
      </article>

      <article class="jk-product-editorial-card">
        <div class="jk-product-editorial-card__media">
          {% if section.settings.cta_image != blank %}
            {{ section.settings.cta_image | image_url: width: 1100 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 31vw, 100vw', widths: '480, 720, 960, 1100', alt: section.settings.cta_image_alt }}
          {% elsif fallback_product_image_6 != blank %}
            {{ fallback_product_image_6 | image_url: width: 1100 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 31vw, 100vw', widths: '480, 720, 960, 1100', alt: product.title }}
          {% elsif fallback_product_image_3 != blank %}
            {{ fallback_product_image_3 | image_url: width: 1100 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 31vw, 100vw', widths: '480, 720, 960, 1100', alt: product.title }}
          {% elsif fallback_product_image_1 != blank %}
            {{ fallback_product_image_1 | image_url: width: 1100 | image_tag: loading: 'lazy', sizes: '(min-width: 1080px) 31vw, 100vw', widths: '480, 720, 960, 1100', alt: product.title }}
          {% else %}
            {% render 'joyari-generated-image', file: 'joyari-private-consultation.jpg', alt: section.settings.cta_image_alt, class: 'jk-product-editorial-card__image' %}
          {% endif %}
        </div>
        <div class="jk-product-editorial-card__body">
          <span>Private guidance</span>
          <h3>Refine the ring with us</h3>
          <p>Use this space for a proposal, hand model, styling image, or appointment-led custom design moment.</p>
        </div>
      </article>
    </div>

    <div class="jk-mobile-atc" data-mobile-atc>
      <div>
        <span>{{ product.title }}</span>
        <strong data-estimate-total>AUD ${{ selected_variant.price | money_without_currency | replace: '.00', '' }}</strong>
      </div>
      <button type="submit" name="add" form="{{ product_form_id }}" class="jk-button jk-button--primary" data-add-to-cart {% unless selected_variant.available %}disabled{% endunless %}>
        {% if selected_variant.available %}
          {{ 'products.product.add_to_cart' | t }}
        {% else %}
          {{ 'products.product.sold_out' | t }}
        {% endif %}
      </button>
    </div>
  {% else %}
    <div class="jk-section__header">
      <p class="jk-eyebrow">Joyari Krafted</p>
      <h1>Product details</h1>
      <p>Add product information in Shopify admin to complete this fine jewellery page.</p>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Product builder main",
  "tag": "section",
  "class": "shopify-section--product-builder-main",
  "settings": [
    {
      "type": "text",
      "id": "builder_heading",
      "label": "Builder heading",
      "default": "Design your Joyari piece"
    },
    {
      "type": "checkbox",
      "id": "enable_gemstone_step",
      "label": "Enable gemstone step",
      "default": false
    },
    {
      "type": "header",
      "content": "Product gallery visuals"
    },
    {
      "type": "image_picker",
      "id": "gallery_image",
      "label": "Hero/product gallery image"
    },
    {
      "type": "text",
      "id": "gallery_image_alt",
      "label": "Hero/product gallery image alt text",
      "default": "Joyari Krafted diamond ring"
    },
    {
      "type": "image_picker",
      "id": "ring_on_hand_image",
      "label": "Ring on hand image"
    },
    {
      "type": "text",
      "id": "ring_on_hand_alt",
      "label": "Ring on hand image alt text",
      "default": "Joyari Krafted ring worn on hand"
    },
    {
      "type": "image_picker",
      "id": "diamond_closeup_image",
      "label": "Close-up diamond image"
    },
    {
      "type": "text",
      "id": "diamond_closeup_alt",
      "label": "Close-up diamond image alt text",
      "default": "Close-up diamond detail"
    },
    {
      "type": "video_url",
      "id": "product_video_url",
      "label": "External product video",
      "accept": [
        "youtube",
        "vimeo"
      ]
    },
    {
      "type": "url",
      "id": "product_video_file_url",
      "label": "Shopify-hosted MP4 video URL"
    },
    {
      "type": "header",
      "content": "Builder support visuals"
    },
    {
      "type": "image_picker",
      "id": "metal_selector_image",
      "label": "Metal selector support image"
    },
    {
      "type": "text",
      "id": "metal_selector_alt",
      "label": "Metal selector image alt text",
      "default": "Joyari Krafted metal tone detail"
    },
    {
      "type": "image_picker",
      "id": "diamond_shape_image",
      "label": "Diamond shape support image"
    },
    {
      "type": "text",
      "id": "diamond_shape_alt",
      "label": "Diamond shape image alt text",
      "default": "Diamond shape comparison detail"
    },
    {
      "type": "image_picker",
      "id": "carat_size_image",
      "label": "Carat and ring size guide visual"
    },
    {
      "type": "text",
      "id": "carat_size_alt",
      "label": "Carat and size visual alt text",
      "default": "Ring size and diamond proportion guide"
    },
    {
      "type": "header",
      "content": "Editorial product visuals"
    },
    {
      "type": "image_picker",
      "id": "craftsmanship_image",
      "label": "Craftsmanship image"
    },
    {
      "type": "text",
      "id": "craftsmanship_alt",
      "label": "Craftsmanship image alt text",
      "default": "Joyari Krafted atelier craftsmanship"
    },
    {
      "type": "image_picker",
      "id": "packaging_image",
      "label": "Packaging image"
    },
    {
      "type": "text",
      "id": "packaging_alt",
      "label": "Packaging image alt text",
      "default": "Joyari Krafted luxury packaging"
    },
    {
      "type": "image_picker",
      "id": "cta_image",
      "label": "CTA image"
    },
    {
      "type": "text",
      "id": "cta_image_alt",
      "label": "CTA image alt text",
      "default": "Joyari Krafted private consultation"
    },
    {
      "type": "checkbox",
      "id": "show_ring_size_on_all_products",
      "label": "Show ring size selector on all products temporarily",
      "default": true
    },
    {
      "type": "number",
      "id": "carat_quarter_premium",
      "label": "Estimate increase per 0.25ct above 1ct, in cents",
      "default": 18500
    }
  ]
}
{% endschema %}
