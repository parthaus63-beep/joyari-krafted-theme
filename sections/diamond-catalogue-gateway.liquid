{% liquid
  assign loose_diamonds_url = routes.collections_url | append: '/loose-diamonds'
  assign lab_diamonds_url = routes.collections_url | append: '/lab-grown-diamonds'
  assign natural_diamonds_url = routes.collections_url | append: '/natural-diamonds'
  assign ready_to_ship_url = routes.collections_url | append: '/ready-to-ship'
  assign design_ring_url = '/pages/design-your-ring'
%}

<section class="jk-section jk-diamond-gateway">
  <div class="jk-section__header jk-section__header--split">
    <div>
      {% if section.settings.eyebrow != blank %}
        <p class="jk-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}
        <p>{{ section.settings.subheading }}</p>
      {% endif %}
    </div>
    {% if section.settings.button_label != blank %}
      <a class="jk-text-link" href="{{ section.settings.button_link | default: loose_diamonds_url }}">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>

  <div class="jk-diamond-gateway__grid">
    {% for block in section.blocks %}
      {% liquid
        assign card_url = block.settings.link
        if card_url == blank
          case block.settings.destination
            when 'loose'
              assign card_url = loose_diamonds_url
            when 'lab'
              assign card_url = lab_diamonds_url
            when 'natural'
              assign card_url = natural_diamonds_url
            when 'ready'
              assign card_url = ready_to_ship_url
            when 'design'
              assign card_url = design_ring_url
            else
              assign card_url = loose_diamonds_url
          endcase
        endif
      %}

      <article class="jk-diamond-gateway-card" {{ block.shopify_attributes }}>
        <a href="{{ card_url }}" aria-label="{{ block.settings.title | escape }}">
          <span class="jk-card-badge">{{ block.settings.badge }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
          <span class="jk-diamond-gateway-card__line" aria-hidden="true"></span>
        </a>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Diamond catalogue gateway",
  "tag": "section",
  "class": "shopify-section--diamond-catalogue-gateway",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Diamond concierge"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore stones in a dedicated diamond experience"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "The homepage stays editorial and brand-led, while diamond search, Nivoda-synced catalogues, and ready pieces live in focused destination pages."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View Loose Diamonds"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "catalogue_link",
      "name": "Catalogue link",
      "settings": [
        {
          "type": "select",
          "id": "destination",
          "label": "Default destination",
          "default": "loose",
          "options": [
            {
              "value": "loose",
              "label": "Loose Diamonds"
            },
            {
              "value": "lab",
              "label": "Lab Grown"
            },
            {
              "value": "natural",
              "label": "Natural Diamonds"
            },
            {
              "value": "design",
              "label": "Design Your Ring"
            },
            {
              "value": "ready",
              "label": "Ready To Ship"
            }
          ]
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional override link"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "Catalogue"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Loose Diamonds"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Browse stones in a focused diamond search experience away from the editorial homepage."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Diamond catalogue gateway",
      "blocks": [
        {
          "type": "catalogue_link",
          "settings": {
            "destination": "loose",
            "badge": "Stone search",
            "title": "Loose Diamonds",
            "text": "Compare individual stones with more clarity and less homepage clutter."
          }
        },
        {
          "type": "catalogue_link",
          "settings": {
            "destination": "lab",
            "badge": "Traceable brilliance",
            "title": "Lab Grown Diamonds",
            "text": "A dedicated catalogue for modern lab-grown stones and certified options."
          }
        },
        {
          "type": "catalogue_link",
          "settings": {
            "destination": "natural",
            "badge": "Classic provenance",
            "title": "Natural Diamonds",
            "text": "A focused destination for natural diamonds and client-guided selection."
          }
        }
      ]
    }
  ]
}
{% endschema %}
