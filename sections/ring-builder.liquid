<section id="joyari-ring-builder" class="jk-section jk-builder-showcase" data-builder-showcase data-quarter-premium="{{ section.settings.carat_quarter_premium }}" data-base-price="{{ section.settings.base_price }}">
  <div class="jk-builder-showcase__content">
    {% if section.settings.eyebrow != blank %}
      <p class="jk-eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>
    <div class="jk-builder-showcase__trust">
      <span>Native Shopify-friendly preferences</span>
      <span>Mobile-first ring design flow</span>
      <span>Built without external apps</span>
    </div>
    <a class="jk-button jk-button--secondary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
  </div>

  <div class="jk-builder-console">
    <div class="jk-builder-console__preview{% if section.settings.preview_image != blank %} jk-builder-console__preview--image{% endif %}">
      {% if section.settings.preview_image != blank %}
        {{ section.settings.preview_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360, 540, 720, 1000', sizes: '(min-width: 900px) 38vw, 100vw', alt: section.settings.preview_image_alt, class: 'jk-builder-console__image' }}
      {% endif %}
      <div class="jk-stone-preview jk-stone-preview--large" data-stone-preview data-shape="oval">
        <span></span>
      </div>
      <p data-showcase-summary>Oval lab-grown diamond in 18k yellow gold</p>
    </div>

    <div class="jk-builder-console__controls">
      <fieldset class="jk-builder-field">
        <legend>Diamond shape</legend>
        <div class="jk-shape-row">
          {% assign shapes = 'Oval,Round,Emerald,Pear,Cushion,Marquise' | split: ',' %}
          {% for shape in shapes %}
            <label>
              <input type="radio" name="showcase-shape-{{ section.id }}" value="{{ shape }}" data-builder-choice data-shape-choice="{{ shape | handleize }}" {% if forloop.first %}checked{% endif %}>
              <span>{{ shape }}</span>
            </label>
          {% endfor %}
        </div>
      </fieldset>

      <fieldset class="jk-builder-field">
        <legend>Metal tone</legend>
        <div class="jk-choice-grid jk-choice-grid--metal">
          <label><input type="radio" name="showcase-metal-{{ section.id }}" value="18k yellow gold" data-builder-choice checked><span>Yellow</span></label>
          <label><input type="radio" name="showcase-metal-{{ section.id }}" value="18k white gold" data-builder-choice><span>White</span></label>
          <label><input type="radio" name="showcase-metal-{{ section.id }}" value="18k rose gold" data-builder-choice><span>Rose</span></label>
          <label><input type="radio" name="showcase-metal-{{ section.id }}" value="platinum" data-builder-choice data-price-adjustment="55000"><span>Platinum</span></label>
        </div>
      </fieldset>

      <fieldset class="jk-builder-field">
        <legend>Diamond type</legend>
        <div class="jk-choice-grid">
          <label><input type="radio" name="showcase-diamond-{{ section.id }}" value="lab-grown diamond" data-builder-choice checked><span>Lab-grown</span></label>
          <label><input type="radio" name="showcase-diamond-{{ section.id }}" value="premium lab-grown diamond" data-builder-choice data-price-adjustment="75000"><span>Premium lab</span></label>
        </div>
      </fieldset>

      <div class="jk-builder-field">
        <label for="ShowcaseCarat-{{ section.id }}">Carat preference</label>
        <div class="jk-range-row">
          <input id="ShowcaseCarat-{{ section.id }}" type="range" min="0.5" max="4" step="0.25" value="1.5" data-carat-input data-builder-choice>
          <output for="ShowcaseCarat-{{ section.id }}" data-carat-output>1.50 ct</output>
        </div>
      </div>

      <div class="jk-builder-total">
        <span>Design estimate</span>
        <strong data-estimate-total>{{ section.settings.base_price | money }}</strong>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ring builder",
  "tag": "section",
  "class": "shopify-section--ring-builder",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Design your own ring"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shape a ring around your story"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Choose your diamond shape, metal tone, carat preference, and finish, then bring the design to life with a Joyari consultation."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Start with a setting"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "preview_image",
      "label": "Builder preview lifestyle image"
    },
    {
      "type": "text",
      "id": "preview_image_alt",
      "label": "Builder preview image alt text",
      "default": "Joyari Krafted custom ring design preview"
    },
    {
      "type": "number",
      "id": "base_price",
      "label": "Showcase base price, in cents",
      "default": 280000
    },
    {
      "type": "number",
      "id": "carat_quarter_premium",
      "label": "Estimate increase per 0.25ct above 1ct, in cents",
      "default": 18500
    }
  ],
  "presets": [
    {
      "name": "Ring builder"
    }
  ]
}
{% endschema %}
