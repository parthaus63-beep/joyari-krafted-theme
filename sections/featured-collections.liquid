<section class="jk-section jk-featured-collections">
  <div class="jk-section__header">
    {% if section.settings.eyebrow != blank %}
      <p class="jk-eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2>{{ section.settings.heading }}</h2>
    {% if section.settings.subheading != blank %}
      <p>{{ section.settings.subheading }}</p>
    {% endif %}
  </div>

  <div class="jk-collection-grid">
    {% for block in section.blocks %}
      {% assign card_collection = block.settings.collection %}
      {% liquid
        assign category_image = blank
        assign category_image_alt = blank
        case forloop.index
          when 1
            assign category_image = section.settings.engagement_image
            assign category_image_alt = section.settings.engagement_image_alt
          when 2
            assign category_image = section.settings.wedding_image
            assign category_image_alt = section.settings.wedding_image_alt
          when 3
            assign category_image = section.settings.diamond_jewellery_image
            assign category_image_alt = section.settings.diamond_jewellery_image_alt
          when 4
            assign category_image = section.settings.custom_design_image
            assign category_image_alt = section.settings.custom_design_image_alt
        endcase
        if category_image == blank
          assign category_image = block.settings.image
        endif
        assign card_image_alt = category_image_alt | default: block.settings.image_alt | default: block.settings.title
        assign category_asset = 'joyari-collection-engagement-rings-v2.jpg'
        case forloop.index
          when 2
            assign category_asset = 'joyari-collection-wedding-bands-v2.jpg'
          when 3
            assign category_asset = 'joyari-collection-diamond-jewellery.jpg'
          when 4
            assign category_asset = 'joyari-custom-design-atelier-v2.jpg'
        endcase
      %}
      <article class="jk-collection-card" {{ block.shopify_attributes }}>
        <a class="jk-collection-card__media" href="{{ card_collection.url | default: routes.all_products_collection_url }}" aria-label="{{ block.settings.title | escape }}">
          {% if category_image != blank %}
            {{ category_image | image_url: width: 1300 | image_tag: loading: 'lazy', widths: '420, 640, 820, 1100, 1300', sizes: '(min-width: 1100px) 25vw, (min-width: 700px) 50vw, 100vw', alt: card_image_alt }}
          {% elsif card_collection.featured_image != blank %}
            {{ card_collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 900px) 33vw, 100vw', alt: block.settings.title }}
          {% else %}
            {% render 'joyari-generated-image', file: category_asset, alt: card_image_alt, class: 'jk-collection-card__image' %}
          {% endif %}
        </a>
        <div class="jk-collection-card__content">
          {% if block.settings.badge != blank %}
            <p class="jk-card-badge">{{ block.settings.badge }}</p>
          {% endif %}
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
          <a class="jk-text-link" href="{{ card_collection.url | default: routes.all_products_collection_url }}">Explore</a>
        </div>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Featured collections",
  "tag": "section",
  "class": "shopify-section--featured-collections",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Curated collections"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Begin with the piece that feels like you"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore signature categories designed for proposals, milestones, and luminous everyday wear."
    },
    {
      "type": "header",
      "content": "Named category images"
    },
    {
      "type": "image_picker",
      "id": "engagement_image",
      "label": "Engagement ring category image"
    },
    {
      "type": "text",
      "id": "engagement_image_alt",
      "label": "Engagement image alt text",
      "default": "Joyari Krafted engagement ring"
    },
    {
      "type": "image_picker",
      "id": "wedding_image",
      "label": "Wedding band category image"
    },
    {
      "type": "text",
      "id": "wedding_image_alt",
      "label": "Wedding band image alt text",
      "default": "Joyari Krafted wedding bands"
    },
    {
      "type": "image_picker",
      "id": "diamond_jewellery_image",
      "label": "Diamond jewellery category image"
    },
    {
      "type": "text",
      "id": "diamond_jewellery_image_alt",
      "label": "Diamond jewellery image alt text",
      "default": "Joyari Krafted diamond jewellery"
    },
    {
      "type": "image_picker",
      "id": "custom_design_image",
      "label": "Custom design category image"
    },
    {
      "type": "text",
      "id": "custom_design_image_alt",
      "label": "Custom design image alt text",
      "default": "Joyari Krafted custom design jewellery"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Lifestyle image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Engagement Rings"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Refined diamond settings with luminous proportions and bridal emotion."
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "Bridal Icons"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured collections",
      "blocks": [
        {
          "type": "collection_card"
        },
        {
          "type": "collection_card"
        },
        {
          "type": "collection_card"
        },
        {
          "type": "collection_card"
        }
      ]
    }
  ]
}
{% endschema %}
