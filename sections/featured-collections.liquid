<section class="jk-section jk-featured-collections">
  <div class="jk-section__header">
    {% if section.settings.eyebrow != blank %}
      <p class="jk-eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2>{{ section.settings.heading }}</h2>
    {% if section.settings.subheading != blank %}
      <p>{{ section.settings.subheading }}</p>
    {% endif %}
  </div>

  <div class="jk-collection-grid">
    {% for block in section.blocks %}
      {% assign card_collection = block.settings.collection %}
      <article class="jk-collection-card" {{ block.shopify_attributes }}>
        <a class="jk-collection-card__media" href="{{ card_collection.url | default: routes.all_products_collection_url }}" aria-label="{{ block.settings.title | escape }}">
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900, 1100', sizes: '(min-width: 1100px) 25vw, (min-width: 700px) 50vw, 100vw', alt: block.settings.image_alt | default: block.settings.title }}
          {% elsif card_collection.featured_image != blank %}
            {{ card_collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 900px) 33vw, 100vw', alt: block.settings.title }}
          {% else %}
            <span class="jk-placeholder-ring jk-placeholder-ring--{{ forloop.index }}" aria-hidden="true"></span>
          {% endif %}
        </a>
        <div class="jk-collection-card__content">
          {% if block.settings.badge != blank %}
            <p class="jk-card-badge">{{ block.settings.badge }}</p>
          {% endif %}
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
          <a class="jk-text-link" href="{{ card_collection.url | default: routes.all_products_collection_url }}">Explore</a>
        </div>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Featured collections",
  "tag": "section",
  "class": "shopify-section--featured-collections",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Curated collections"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Begin with the piece that feels like you"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore signature categories designed for proposals, milestones, and luminous everyday wear."
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Lifestyle image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Engagement Rings"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Refined diamond settings with luminous proportions and bridal emotion."
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "Bridal Icons"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured collections",
      "blocks": [
        {
          "type": "collection_card"
        },
        {
          "type": "collection_card"
        },
        {
          "type": "collection_card"
        },
        {
          "type": "collection_card"
        }
      ]
    }
  ]
}
{% endschema %}
