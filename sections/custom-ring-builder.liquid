{{ 'custom-ring-builder.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-ring-builder.js' | asset_url }}" defer></script>

{% liquid
  assign builder_product = section.settings.checkout_product
  assign selected_variant = blank
  if builder_product != blank
    assign selected_variant = builder_product.selected_or_first_available_variant
  endif
  assign checkout_variant_id = section.settings.checkout_variant_id | strip
  assign base_price = section.settings.base_price | default: 280000
%}

<section
  class="jkb"
  data-custom-ring-builder
  data-base-price="{{ base_price }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-section-id="{{ section.id }}"
>
  <div class="jkb__progress" aria-label="Design your ring progress">
    <div class="is-active"><strong>1</strong><span>Choose a Setting</span><i aria-hidden="true"></i></div>
    <div><strong>2</strong><span>Choose a Diamond</span><i aria-hidden="true"></i></div>
    <div><strong>3</strong><span>Complete Ring</span><i aria-hidden="true"></i></div>
  </div>

  <div class="jkb__workspace" id="JoyariRingBuilder-{{ section.id }}">
    <div class="jkb__gallery-column">
      <div class="jkb__gallery-tools">
        <a href="{{ section.settings.back_link | default: routes.all_products_collection_url }}" class="jkb__back-link">
          <span aria-hidden="true">‹</span> Back to Gallery
        </a>
        <button type="button" class="jkb__share" data-builder-share aria-label="Share this ring design">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V3m0 0L7 8m5-5 5 5M5 13v7h14v-7"></path></svg>
          Share
        </button>
      </div>

      {% liquid
        assign first_sequence_frame = section.settings.sequence_frame_1
        assign viewer_fallback = section.settings.gallery_image_1
      %}
      <div class="jkb__viewer" data-360-viewer aria-label="Interactive ring view">
        <div class="jkb__viewer-stage" data-360-stage>
          {% if first_sequence_frame != blank %}
            {{ first_sequence_frame | image_url: width: 1600 | image_tag: class: 'jkb__viewer-image', loading: 'eager', sizes: '(min-width: 990px) 62vw, 100vw', widths: '480, 720, 960, 1200, 1600', alt: section.settings.preview_image_alt }}
          {% elsif viewer_fallback != blank %}
            {{ viewer_fallback | image_url: width: 1600 | image_tag: class: 'jkb__viewer-image', loading: 'eager', sizes: '(min-width: 990px) 62vw, 100vw', widths: '480, 720, 960, 1200, 1600', alt: section.settings.preview_image_alt }}
          {% else %}
            <img class="jkb__viewer-image" src="{{ 'joyari-product-pear-ring-on-hand.jpg' | asset_url }}" width="1600" height="1800" loading="eager" alt="{{ section.settings.preview_image_alt | escape }}">
          {% endif %}

          <div class="jkb__viewer-frames" hidden>
            {% for index in (1..6) %}
              {% assign frame_key = 'sequence_frame_' | append: index %}
              {% assign sequence_frame = section.settings[frame_key] %}
              {% if sequence_frame != blank %}
                <span data-360-frame="{{ sequence_frame | image_url: width: 1600 }}"></span>
              {% endif %}
            {% endfor %}
          </div>

          <span class="jkb__viewer-badge" aria-hidden="true">
            <svg viewBox="0 0 32 32"><path d="M5 12c2.4-5 7-8 12.6-8 5.1 0 9.4 2.5 12 6.5"></path><path d="m25 5 4.8 5.7-7.3 1.1"></path><path d="M27 20c-2.4 5-7 8-12.6 8-5.1 0-9.4-2.5-12-6.5"></path><path d="m7 27-4.8-5.7 7.3-1.1"></path></svg>
            360°
          </span>
          <button type="button" class="jkb__viewer-arrow jkb__viewer-arrow--previous" data-360-previous aria-label="Previous angle">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7"></path></svg>
          </button>
          <button type="button" class="jkb__viewer-arrow jkb__viewer-arrow--next" data-360-next aria-label="Next angle">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"></path></svg>
          </button>
          <div class="jkb__viewer-instruction">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 11V7a2 2 0 0 1 4 0v4-6a2 2 0 0 1 4 0v7l1-1a2 2 0 0 1 3 2l-2 5a4 4 0 0 1-4 2h-3a5 5 0 0 1-4-2l-3-4a2 2 0 0 1 3-2l1 1"></path></svg>
            <span data-360-instruction>Drag to rotate</span>
          </div>
        </div>
      </div>

      <div class="jkb__gallery" aria-label="Joyari custom ring gallery">
        {% for index in (1..4) %}
          {% liquid
            assign gallery_key = 'gallery_image_' | append: index
            assign gallery_image = section.settings[gallery_key]
            assign frame_key = 'sequence_frame_' | append: index
            assign frame_image = section.settings[frame_key]
          %}
          <figure class="jkb__gallery-item{% if forloop.first %} is-primary{% endif %}">
            {% if gallery_image != blank %}
              {{ gallery_image | image_url: width: 1500 | image_tag: loading: 'eager', sizes: '(min-width: 990px) 34vw, 100vw', widths: '480, 720, 960, 1200, 1500', alt: section.settings.preview_image_alt }}
            {% elsif frame_image != blank %}
              {{ frame_image | image_url: width: 1500 | image_tag: loading: 'eager', sizes: '(min-width: 990px) 34vw, 100vw', widths: '480, 720, 960, 1200, 1500', alt: section.settings.preview_image_alt }}
            {% elsif index == 1 %}
              <img src="{{ 'joyari-product-pear-ring-on-hand.jpg' | asset_url }}" width="1500" height="1688" loading="eager" alt="Joyari Krafted engagement ring side view">
            {% elsif index == 2 %}
              <img src="{{ 'joyari-home-hero-ring-on-hand.jpg' | asset_url }}" width="1500" height="1688" loading="lazy" alt="Joyari Krafted engagement ring on hand">
            {% elsif index == 3 %}
              <img src="{{ 'joyari-collection-engagement-rings-v2.jpg' | asset_url }}" width="1500" height="1688" loading="lazy" alt="Joyari Krafted engagement ring front view">
            {% else %}
              <img src="{{ 'joyari-diamond-macro-pear.jpg' | asset_url }}" width="1500" height="1688" loading="lazy" alt="Joyari Krafted diamond close-up">
            {% endif %}
          </figure>
        {% endfor %}
      </div>
    </div>

    <aside class="jkb__panel" aria-label="Custom ring setting options">
      <header class="jkb__product-head">
        <p class="jkb__eyebrow">Joyari Krafted custom design</p>
        <h1>Joyari Custom Engagement Ring</h1>
        <div class="jkb__price-row">
          <strong data-estimate-price>{{ base_price | money }}</strong>
          <span>Setting price</span>
        </div>
        <p>Build a considered setting around your preferred centre-stone silhouette, head, metal, and band.</p>
      </header>

      <section class="jkb__group" aria-labelledby="DiamondPreview-{{ section.id }}">
        <div class="jkb__group-heading">
          <h2 id="DiamondPreview-{{ section.id }}">Diamond Preview</h2>
          <span title="Preview proportions before choosing your certified centre stone.">i</span>
        </div>
        <p class="jkb__selected-line">Preview Shape: <strong data-selected-label="Preview Shape">Round</strong></p>
        <div class="jkb__shape-grid">
          {% assign shape_titles = 'Round|Princess|Cushion|Emerald|Pear|Oval|Radiant|Asscher|Marquise|Heart' | split: '|' %}
          {% assign shape_handles = 'round|princess|cushion|emerald|pear|oval|radiant|asscher|marquise|heart' | split: '|' %}
          {% for title in shape_titles %}
            {% assign handle = shape_handles[forloop.index0] %}
            <button type="button" class="jkb__visual-card jkb__shape-card{% if forloop.first %} is-selected{% endif %}" data-option-button data-group="Preview Shape" data-value="{{ title }}" data-handle="{{ handle }}" data-price="0">
              <svg viewBox="0 0 64 64" aria-hidden="true">
                {% case handle %}
                  {% when 'round' %}<circle cx="32" cy="32" r="21"></circle><path d="M17 17l30 30M47 17 17 47M32 11v42M11 32h42"></path>
                  {% when 'princess' %}<path d="M13 13h38v38H13z"></path><path d="M13 13l38 38M51 13 13 51M32 13v38M13 32h38"></path>
                  {% when 'cushion' %}<rect x="12" y="12" width="40" height="40" rx="12"></rect><path d="M20 20h24v24H20zM32 12v40M12 32h40"></path>
                  {% when 'emerald' %}<path d="M21 9h22l12 12v22L43 55H21L9 43V21Z"></path><path d="M21 9v46M43 9v46M9 21h46M9 43h46"></path>
                  {% when 'pear' %}<path d="M32 7C19 20 14 30 16 41c2 10 8 16 16 16s14-6 16-16C50 30 45 20 32 7Z"></path><path d="M32 7v50M21 27l22 22M43 27 21 49"></path>
                  {% when 'oval' %}<ellipse cx="32" cy="32" rx="16" ry="24"></ellipse><path d="M22 12l20 40M42 12 22 52M32 8v48"></path>
                  {% when 'radiant' %}<path d="M20 9h24l11 11v24L44 55H20L9 44V20Z"></path><path d="M20 9l24 46M44 9 20 55M9 20h46M9 44h46"></path>
                  {% when 'asscher' %}<path d="M18 8h28l10 10v28L46 56H18L8 46V18Z"></path><path d="M22 15h20l7 7v20l-7 7H22l-7-7V22Z"></path>
                  {% when 'marquise' %}<path d="M6 32s13-21 26-21 26 21 26 21-13 21-26 21S6 32 6 32Z"></path><path d="M6 32h52M22 16l20 32M42 16 22 48"></path>
                  {% else %}<path d="M32 55 12 34C1 22 9 8 21 10c5 1 9 5 11 9 2-4 6-8 11-9 12-2 20 12 9 24Z"></path><path d="M12 20h40M20 12l12 43M44 12 32 55"></path>
                {% endcase %}
              </svg>
              <span>{{ title }}</span>
            </button>
          {% endfor %}
        </div>

        <p class="jkb__selected-line jkb__size-heading">Preview Size: <strong data-selected-label="Preview Size">2 ct</strong></p>
        <div class="jkb__size-grid">
          {% assign preview_sizes = '1 ct|1.5 ct|2 ct|2.5 ct' | split: '|' %}
          {% assign preview_prices = '-90000|0|135000|260000' | split: '|' %}
          {% for size in preview_sizes %}
            <button type="button" class="jkb__size-card{% if size == '2 ct' %} is-selected{% endif %}" data-option-button data-group="Preview Size" data-value="{{ size }}" data-price="{{ preview_prices[forloop.index0] }}">{{ size }}</button>
          {% endfor %}
        </div>
      </section>

      <section class="jkb__group" aria-labelledby="HeadHeading-{{ section.id }}">
        <div class="jkb__group-heading">
          <h2 id="HeadHeading-{{ section.id }}">Head</h2>
          <span title="The head secures and presents the centre stone.">i</span>
        </div>
        <p class="jkb__selected-line">Select Style: <strong data-selected-label="Head Style">Diamond Tulip</strong></p>
        <div class="jkb__style-grid">
          {% assign head_titles = '4-Prong Nouveau|6-Prong Nouveau|Classic Basket|Diamond Basket|Surprise Diamond|6-Prong Diamond|Diamond Tulip|Classic Halo|Floral Halo|Hidden Halo|Dual Halo|Fancy Halo|Clustered Diamond|Vintage Trefoil|Classic Bezel' | split: '|' %}
          {% for title in head_titles %}
            <button type="button" class="jkb__visual-card jkb__style-card{% if title == 'Diamond Tulip' %} is-selected{% endif %}" data-option-button data-group="Head Style" data-value="{{ title }}" data-price="{% if title contains 'Halo' or title contains 'Diamond' %}28000{% else %}0{% endif %}">
              <svg viewBox="0 0 72 72" aria-hidden="true">
                {% case title %}
                  {% when '4-Prong Nouveau' %}<path d="M18 24 36 12l18 12-8 27H26Z"></path><path d="M18 24h36M27 24l9 27 9-27M23 18l5 9M49 18l-5 9"></path><circle cx="36" cy="12" r="3"></circle>
                  {% when '6-Prong Nouveau' %}<path d="M17 25 36 11l19 14-8 27H25Z"></path><path d="M17 25h38M26 18l5 12M46 18l-5 12M28 25l8 27 8-27"></path><circle cx="36" cy="11" r="3"></circle><circle cx="18" cy="25" r="2"></circle><circle cx="54" cy="25" r="2"></circle>
                  {% when 'Classic Basket' %}<path d="M16 26h40l-7 22H23Z"></path><path d="M21 32h30M26 26v22M46 26v22M30 18 36 9l6 9"></path><path d="M24 20h24"></path>
                  {% when 'Diamond Basket' %}<path d="M15 27h42l-8 22H23Z"></path><path d="M22 34h28M27 27v22M45 27v22M29 19 36 9l7 10"></path><circle cx="20" cy="32" r="2"></circle><circle cx="52" cy="32" r="2"></circle><circle cx="36" cy="48" r="2"></circle>
                  {% when 'Surprise Diamond' %}<path d="M18 25h36l-7 25H25Z"></path><path d="M26 25l10 25 10-25M29 18 36 9l7 9"></path><circle cx="36" cy="34" r="4"></circle><path d="m33 34 3-3 3 3-3 3Z"></path>
                  {% when '6-Prong Diamond' %}<path d="M17 25 36 11l19 14-8 26H25Z"></path><path d="M24 19l7 11M48 19l-7 11M28 25l8 26 8-26"></path><circle cx="17" cy="25" r="2"></circle><circle cx="55" cy="25" r="2"></circle><circle cx="36" cy="50" r="2"></circle>
                  {% when 'Diamond Tulip' %}<path d="M17 24c8 1 13 7 19 27 6-20 11-26 19-27"></path><path d="M24 18c5 5 9 10 12 33 3-23 7-28 12-33M24 18 36 9l12 9"></path><circle cx="19" cy="26" r="2"></circle><circle cx="53" cy="26" r="2"></circle><circle cx="36" cy="50" r="2"></circle>
                  {% when 'Classic Halo' %}<ellipse cx="36" cy="31" rx="20" ry="17"></ellipse><ellipse cx="36" cy="31" rx="13" ry="11"></ellipse><path d="M26 48 36 61l10-13"></path><circle cx="16" cy="31" r="2"></circle><circle cx="56" cy="31" r="2"></circle><circle cx="36" cy="14" r="2"></circle>
                  {% when 'Floral Halo' %}<path d="M36 10c4 7 8 10 15 8-2 7 1 11 8 14-7 3-10 7-8 14-7-2-11 1-15 8-4-7-8-10-15-8 2-7-1-11-8-14 7-3 10-7 8-14 7 2 11-1 15-8Z"></path><ellipse cx="36" cy="32" rx="11" ry="14"></ellipse>
                  {% when 'Hidden Halo' %}<path d="M18 22h36M22 27c4 5 8 12 14 25 6-13 10-20 14-25"></path><ellipse cx="36" cy="22" rx="18" ry="6"></ellipse><path d="M25 16 36 8l11 8"></path><circle cx="22" cy="23" r="1.8"></circle><circle cx="50" cy="23" r="1.8"></circle>
                  {% when 'Dual Halo' %}<ellipse cx="36" cy="31" rx="22" ry="19"></ellipse><ellipse cx="36" cy="31" rx="16" ry="13"></ellipse><ellipse cx="36" cy="31" rx="10" ry="8"></ellipse><path d="M28 50 36 61l8-11"></path>
                  {% when 'Fancy Halo' %}<path d="M36 8 56 23l-7 27-13 12-13-12-7-27Z"></path><path d="M36 16 48 26l-4 17-8 8-8-8-4-17Z"></path><circle cx="36" cy="8" r="2"></circle><circle cx="55" cy="24" r="2"></circle><circle cx="17" cy="24" r="2"></circle>
                  {% when 'Clustered Diamond' %}<circle cx="36" cy="29" r="10"></circle><circle cx="24" cy="25" r="6"></circle><circle cx="48" cy="25" r="6"></circle><circle cx="29" cy="40" r="6"></circle><circle cx="43" cy="40" r="6"></circle><path d="M29 47 36 61l7-14"></path>
                  {% when 'Vintage Trefoil' %}<circle cx="36" cy="24" r="10"></circle><circle cx="25" cy="32" r="8"></circle><circle cx="47" cy="32" r="8"></circle><path d="M28 40 36 59l8-19M21 45h30"></path><circle cx="36" cy="24" r="3"></circle>
                  {% else %}<path d="M25 11h22l11 11v20L47 53H25L14 42V22Z"></path><path d="M28 17h16l8 8v14l-8 8H28l-8-8V25Z"></path><path d="M29 53 36 62l7-9"></path>
                {% endcase %}
              </svg>
              <span>{{ title }}</span>
            </button>
          {% endfor %}
        </div>
      </section>

      <section class="jkb__group" aria-labelledby="MetalHeading-{{ section.id }}">
        <div class="jkb__group-heading">
          <h2 id="MetalHeading-{{ section.id }}">Select Metal</h2>
        </div>
        <p class="jkb__selected-line">Selected: <strong data-selected-label="Metal">14K White Gold</strong></p>
        <div class="jkb__metal-grid">
          {% assign metal_titles = 'Silver|10K Yellow Gold|10K White Gold|10K Rose Gold|14K Yellow Gold|14K White Gold|14K Rose Gold|18K Yellow Gold|18K White Gold|18K Rose Gold' | split: '|' %}
          {% assign metal_handles = 'silver|10k-yellow-gold|10k-white-gold|10k-rose-gold|14k-yellow-gold|14k-white-gold|14k-rose-gold|18k-yellow-gold|18k-white-gold|18k-rose-gold' | split: '|' %}
          {% assign metal_prices = '-45000|-20000|-12000|-8000|-8000|0|4000|12000|18000|22000' | split: '|' %}
          {% for title in metal_titles %}
            <button type="button" class="jkb__metal-card{% if title == '14K White Gold' %} is-selected{% endif %}" data-option-button data-group="Metal" data-value="{{ title }}" data-handle="{{ metal_handles[forloop.index0] }}" data-price="{{ metal_prices[forloop.index0] }}">
              <span class="jkb__metal-swatch jkb__metal-swatch--{{ metal_handles[forloop.index0] }}" aria-hidden="true"></span>
              <span>{{ title }}</span>
            </button>
          {% endfor %}
        </div>
      </section>

      <section class="jkb__group" aria-labelledby="BandHeading-{{ section.id }}">
        <div class="jkb__group-heading">
          <h2 id="BandHeading-{{ section.id }}">Band</h2>
          <span title="Select the profile and detailing around the band.">i</span>
        </div>
        <p class="jkb__selected-line">Select Style: <strong data-selected-label="Band Style">Knife Edge Solitaire</strong></p>
        <div class="jkb__style-grid">
          {% assign band_titles = 'Solitaire|Knife Edge Solitaire|Split Ring Solitaire|French Pavé|Cathedral Pavé|Triple Row Pavé|Round Channel|Baguette Channel|Floating Station|Alternating Marquise|Three Stone|Knife Edge Pavé|Floral Bypass|Twist Pavé|Alternating Baguette' | split: '|' %}
          {% for title in band_titles %}
            <button type="button" class="jkb__visual-card jkb__style-card jkb__band-card{% if title == 'Knife Edge Solitaire' %} is-selected{% endif %}" data-option-button data-group="Band Style" data-value="{{ title }}" data-price="{% if title contains 'Pavé' or title contains 'Channel' or title contains 'Baguette' or title contains 'Three Stone' %}32000{% else %}0{% endif %}">
              <svg viewBox="0 0 72 72" aria-hidden="true">
                {% case title %}
                  {% when 'Solitaire' %}<path d="M8 56c10-36 46-36 56 0"></path><path d="M15 56c9-25 33-25 42 0"></path><path d="M34 26h4"></path>
                  {% when 'Knife Edge Solitaire' %}<path d="M8 57c11-38 45-38 56 0"></path><path d="M15 57c9-25 33-25 42 0"></path><path d="M36 24v33M30 28l6-7 6 7"></path>
                  {% when 'Split Ring Solitaire' %}<path d="M7 57c9-35 37-39 58-5"></path><path d="M15 57c7-23 27-29 42-5M12 50c13-23 34-26 49-4"></path><path d="M34 24h4"></path>
                  {% when 'French Pavé' %}<path d="M8 57c10-36 46-36 56 0M15 57c9-25 33-25 42 0"></path><path d="M20 43h32" stroke-dasharray="1 5"></path><path d="m23 40 3 6 3-6 3 6 3-6 3 6 3-6 3 6"></path>
                  {% when 'Cathedral Pavé' %}<path d="M7 57c10-35 47-35 58 0M15 57c8-23 34-23 42 0"></path><path d="M20 46c4-13 10-19 16-22 6 3 12 9 16 22"></path><path d="M23 44h26" stroke-dasharray="1 5"></path>
                  {% when 'Triple Row Pavé' %}<path d="M7 58c10-38 48-38 58 0M12 58c10-31 38-31 48 0M17 58c9-23 29-23 38 0"></path><path d="M20 45h32" stroke-dasharray="1 4"></path>
                  {% when 'Round Channel' %}<path d="M8 57c10-36 46-36 56 0M15 57c9-25 33-25 42 0"></path><circle cx="23" cy="43" r="2"></circle><circle cx="30" cy="38" r="2"></circle><circle cx="36" cy="37" r="2"></circle><circle cx="42" cy="38" r="2"></circle><circle cx="49" cy="43" r="2"></circle>
                  {% when 'Baguette Channel' %}<path d="M8 57c10-36 46-36 56 0M15 57c9-25 33-25 42 0"></path><path d="m21 42 4-2 2 5-4 2Zm9-5h5v6h-5Zm10 0h5v6h-5Zm7 3 4 2-2 5-4-2Z"></path>
                  {% when 'Floating Station' %}<path d="M8 57c10-36 46-36 56 0M15 57c9-25 33-25 42 0"></path><circle cx="21" cy="45" r="3"></circle><circle cx="36" cy="36" r="3"></circle><circle cx="51" cy="45" r="3"></circle>
                  {% when 'Alternating Marquise' %}<path d="M8 57c10-36 46-36 56 0M15 57c9-25 33-25 42 0"></path><path d="M20 45s4-5 7 0c-3 5-7 0-7 0Zm12-8s4-5 8 0c-4 5-8 0-8 0Zm13 8s4-5 7 0c-3 5-7 0-7 0Z"></path>
                  {% when 'Three Stone' %}<path d="M8 57c10-36 46-36 56 0M15 57c9-25 33-25 42 0"></path><circle cx="27" cy="32" r="5"></circle><circle cx="36" cy="27" r="7"></circle><circle cx="45" cy="32" r="5"></circle>
                  {% when 'Knife Edge Pavé' %}<path d="M8 57c10-36 46-36 56 0M15 57c9-25 33-25 42 0M36 25v32"></path><path d="M20 44h32" stroke-dasharray="1 5"></path>
                  {% when 'Floral Bypass' %}<path d="M8 57c14-35 29-20 38-35M64 57C50 22 35 37 26 22"></path><path d="M28 25c2-8 14-8 16 0-2 8-14 8-16 0Z"></path><circle cx="36" cy="25" r="3"></circle>
                  {% when 'Twist Pavé' %}<path d="M8 57c16-34 38-13 56-35M8 22c18 22 40 2 56 35"></path><path d="M18 43c8-7 12-8 20-4" stroke-dasharray="1 4"></path>
                  {% else %}<path d="M8 57c10-36 46-36 56 0M15 57c9-25 33-25 42 0"></path><path d="m20 44 5-3 3 6 5-5 4 6 5-6 4 6 5-5"></path>
                {% endcase %}
              </svg>
              <span>{{ title }}</span>
            </button>
          {% endfor %}
        </div>
      </section>

      <div class="jkb__trust-list" aria-label="Joyari service assurances">
        <div><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16v12H4zM8 7V5h8v2M4 11h16"></path></svg><span><strong>12–15 business days</strong>Made to order for you</span></div>
        <div><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v10H3zM14 10h4l3 3v4h-7zM7 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm10 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"></path></svg><span><strong>Insured delivery</strong>Tracked from atelier to arrival</span></div>
        <div><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9M12 7v5l3 2M18 3v5h5"></path></svg><span><strong>Free resizing</strong>Thoughtful aftercare included</span></div>
        <div><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h9l3 3v15H6zM15 3v4h4M9 12l2 2 4-4"></path></svg><span><strong>IGI/GIA certificate</strong>Available with eligible stones</span></div>
        <div><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v14H4zM8 9h8M8 13h5M16 16l2 2 3-4"></path></svg><span><strong>CAD preview</strong>Approve proportions before production</span></div>
      </div>

      {% if builder_product != blank and selected_variant != blank %}
        {% form 'product', builder_product, class: 'jkb__form', data-builder-form: '' %}
          <input type="hidden" name="id" value="{{ selected_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <input type="hidden" name="properties[Preview Shape]" value="Round" data-property-input="Preview Shape">
          <input type="hidden" name="properties[Preview Size]" value="2 ct" data-property-input="Preview Size">
          <input type="hidden" name="properties[Head Style]" value="Diamond Tulip" data-property-input="Head Style">
          <input type="hidden" name="properties[Metal]" value="14K White Gold" data-property-input="Metal">
          <input type="hidden" name="properties[Band Style]" value="Knife Edge Solitaire" data-property-input="Band Style">
          <input type="hidden" name="properties[Production Time]" value="12–15 business days">
          <input type="hidden" name="properties[Configured Price]" value="{{ base_price | money }}" data-property-input="Configured Price">
          <button type="submit" name="add" class="jkb__primary-cta">Select This Setting</button>
        {% endform %}
      {% elsif checkout_variant_id != blank %}
        <form method="post" action="{{ routes.cart_add_url }}" class="jkb__form" data-builder-form>
          <input type="hidden" name="id" value="{{ checkout_variant_id | escape }}">
          <input type="hidden" name="quantity" value="1">
          <input type="hidden" name="properties[Preview Shape]" value="Round" data-property-input="Preview Shape">
          <input type="hidden" name="properties[Preview Size]" value="2 ct" data-property-input="Preview Size">
          <input type="hidden" name="properties[Head Style]" value="Diamond Tulip" data-property-input="Head Style">
          <input type="hidden" name="properties[Metal]" value="14K White Gold" data-property-input="Metal">
          <input type="hidden" name="properties[Band Style]" value="Knife Edge Solitaire" data-property-input="Band Style">
          <input type="hidden" name="properties[Production Time]" value="12–15 business days">
          <input type="hidden" name="properties[Configured Price]" value="{{ base_price | money }}" data-property-input="Configured Price">
          <button type="submit" name="add" class="jkb__primary-cta">Select This Setting</button>
        </form>
      {% else %}
        <a class="jkb__primary-cta" href="{{ section.settings.request_link | default: '/pages/contact' }}">Select This Setting</a>
      {% endif %}
      <a class="jkb__secondary-cta" href="{{ section.settings.consultation_link | default: '/pages/contact' }}">Chat With an Expert</a>
    </aside>
  </div>

  <div class="jkb__mobile-cta">
    <div><span>Setting price</span><strong data-estimate-price>{{ base_price | money }}</strong></div>
    <a href="#JoyariRingBuilder-{{ section.id }}">Select This Setting</a>
  </div>
</section>

{% schema %}
{
  "name": "Custom ring builder",
  "tag": "section",
  "class": "shopify-section--custom-ring-builder",
  "settings": [
    { "type": "product", "id": "checkout_product", "label": "Checkout product", "info": "Selections are saved as line item properties." },
    { "type": "text", "id": "checkout_variant_id", "label": "Fallback checkout variant ID" },
    { "type": "number", "id": "base_price", "label": "Setting price, in cents", "default": 280000 },
    { "type": "url", "id": "back_link", "label": "Back to gallery link" },
    { "type": "url", "id": "consultation_link", "label": "Expert chat link" },
    { "type": "url", "id": "request_link", "label": "Setting request link" },
    { "type": "text", "id": "preview_image_alt", "label": "Gallery image alt text", "default": "Joyari Krafted custom engagement ring" },
    { "type": "header", "content": "Product gallery" },
    { "type": "image_picker", "id": "gallery_image_1", "label": "Gallery image 1" },
    { "type": "image_picker", "id": "gallery_image_2", "label": "Gallery image 2" },
    { "type": "image_picker", "id": "gallery_image_3", "label": "Gallery image 3" },
    { "type": "image_picker", "id": "gallery_image_4", "label": "Gallery image 4" },
    { "type": "header", "content": "Existing uploaded frames" },
    { "type": "image_picker", "id": "sequence_frame_1", "label": "Frame 1 fallback" },
    { "type": "image_picker", "id": "sequence_frame_2", "label": "Frame 2 fallback" },
    { "type": "image_picker", "id": "sequence_frame_3", "label": "Frame 3 fallback" },
    { "type": "image_picker", "id": "sequence_frame_4", "label": "Frame 4 fallback" },
    { "type": "image_picker", "id": "sequence_frame_5", "label": "Frame 5 fallback" },
    { "type": "image_picker", "id": "sequence_frame_6", "label": "Frame 6 fallback" }
  ],
  "presets": [{ "name": "Custom ring builder" }]
}
{% endschema %}
