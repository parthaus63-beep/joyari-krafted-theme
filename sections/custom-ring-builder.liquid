{{ 'custom-ring-builder.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-ring-builder.js' | asset_url }}" defer></script>
{% assign initial_model_url = section.settings.default_model_url %}
{% if initial_model_url == blank %}
  {% assign initial_model_url = section.settings.round_model_url %}
{% endif %}
{% if initial_model_url == blank %}
  {% assign initial_model_url = section.settings.oval_model_url %}
{% endif %}
{% if initial_model_url == blank %}
  {% assign initial_model_url = section.settings.emerald_model_url %}
{% endif %}
{% if initial_model_url == blank %}
  {% assign initial_model_url = section.settings.pear_model_url %}
{% endif %}
{% if initial_model_url == blank %}
  {% assign initial_model_url = section.settings.cushion_model_url %}
{% endif %}
{% if initial_model_url != blank %}
  <script type="module" src="{{ 'model-viewer.min.js' | asset_url }}"></script>
{% endif %}
{% assign sequence_frame_1 = section.settings.sequence_frame_1 %}
{% if sequence_frame_1 != blank %}
  {% assign sequence_frame_1_url = sequence_frame_1 | image_url: width: 1600 %}
