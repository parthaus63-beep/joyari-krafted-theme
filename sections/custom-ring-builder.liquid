  {% assign sequence_frame_8_url = sequence_frame_8 | image_url: width: 1600 %}
{% endif %}
{% assign sequence_count = 0 %}
{% if sequence_frame_1_url != blank %}{% assign sequence_count = sequence_count | plus: 1 %}{% endif %}
{% if sequence_frame_2_url != blank %}{% assign sequence_count = sequence_count | plus: 1 %}{% endif %}
{% if sequence_frame_3_url != blank %}{% assign sequence_count = sequence_count | plus: 1 %}{% endif %}
{% if sequence_frame_4_url != blank %}{% assign sequence_count = sequence_count | plus: 1 %}{% endif %}
{% if sequence_frame_5_url != blank %}{% assign sequence_count = sequence_count | plus: 1 %}{% endif %}
{% if sequence_frame_6_url != blank %}{% assign sequence_count = sequence_count | plus: 1 %}{% endif %}
{% if sequence_frame_7_url != blank %}{% assign sequence_count = sequence_count | plus: 1 %}{% endif %}
{% if sequence_frame_8_url != blank %}{% assign sequence_count = sequence_count | plus: 1 %}{% endif %}

<section
  id="CustomRingBuilder-{{ section.id }}"
  class="jkrb{% if initial_model_url != blank %} jkrb--has-model-source{% endif %}{% if initial_model_url != blank and sequence_count == 0 %} jkrb--has-active-model{% endif %}{% if sequence_count > 0 %} jkrb--has-sequence jkrb--sequence-ready{% endif %}{% if sequence_count <= 1 %} jkrb--single-image-mode{% endif %}"
  data-custom-ring-builder
  data-api-ready="true"
  data-base-price="{{ section.settings.base_price }}"
  data-base-carat="{{ section.settings.base_carat }}"
  data-quarter-premium="{{ section.settings.carat_quarter_premium }}"
  data-model-default="{{ section.settings.default_model_url | escape }}"
  data-model-round="{{ section.settings.round_model_url | escape }}"
  data-model-oval="{{ section.settings.oval_model_url | escape }}"
  data-model-emerald="{{ section.settings.emerald_model_url | escape }}"
  data-model-pear="{{ section.settings.pear_model_url | escape }}"
  data-model-cushion="{{ section.settings.cushion_model_url | escape }}"
  data-sequence-count="{{ sequence_count }}"
  data-sequence-interval="120"
  data-gallery-view="main"
  data-current-shape="round"
  data-current-setting="solitaire"
  data-current-metal="platinum"
>
  <div class="jkrb-hero">
    <div class="jkrb-hero__media" aria-hidden="true">
      {% if section.settings.hero_image != blank %}
        {{ section.settings.hero_image | image_url: width: 2200 | image_tag: loading: 'eager', widths: '900, 1200, 1600, 2200', sizes: '100vw', alt: section.settings.hero_image_alt, class: 'jkrb-hero__image' }}
      {% else %}
        <div class="jkrb-hero__fallback">
          <span class="jkrb-hero__ring"></span>
          <span class="jkrb-hero__stone"></span>
          <span class="jkrb-hero__glow jkrb-hero__glow--one"></span>
          <span class="jkrb-hero__glow jkrb-hero__glow--two"></span>
        </div>
      {% endif %}
    </div>

    <div class="jkrb-hero__content">
      {% if section.settings.eyebrow != blank %}
        <p class="jkrb-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h1>{{ section.settings.heading }}</h1>
      {% if section.settings.subheading != blank %}
        <p>{{ section.settings.subheading }}</p>
      {% endif %}
      <div class="jkrb-hero__actions">
        {% if section.settings.primary_label != blank %}
          <a class="jkrb-button jkrb-button--dark" href="#RingBuilderSteps-{{ section.id }}">{{ section.settings.primary_label }}</a>
        {% endif %}
        {% if section.settings.secondary_label != blank %}
          <a class="jkrb-button jkrb-button--light" href="{{ section.settings.consultation_link | default: '/pages/contact' }}">{{ section.settings.secondary_label }}</a>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="jkrb-shell" id="RingBuilderSteps-{{ section.id }}">
    <div class="jkrb-intro">
      <p class="jkrb-eyebrow">Private ring studio</p>
      <h2>Create a first design direction</h2>
      <p>Refine the silhouette, setting, metal, and carat presence. This demo studio is structured for future live diamond and setting data while keeping the experience calm and premium today.</p>
    </div>

    <div class="jkrb-layout">
      <div class="jkrb-controls">
        <fieldset class="jkrb-step" data-jkrb-step>
          <legend><span>01</span> Choose shape</legend>
          <div class="jkrb-choice-grid jkrb-choice-grid--shape">
            {% assign shapes = 'Round:round,Oval:oval,Pear:pear,Emerald:emerald,Cushion:cushion' | split: ',' %}
            {% for item in shapes %}
              {% assign shape = item | split: ':' %}
              <label class="jkrb-card{% if forloop.first %} is-selected{% endif %}" data-jkrb-card>
                <input type="radio" name="custom-shape-{{ section.id }}" value="{{ shape[0] }}" data-jkrb-choice data-jkrb-shape="{{ shape[1] }}" data-price-adjustment="0" {% if forloop.first %}checked{% endif %}>
                <span class="jkrb-stone-icon jkrb-stone-icon--{{ shape[1] }}" aria-hidden="true"></span>
                <span class="jkrb-card__title">{{ shape[0] }}</span>
              </label>
            {% endfor %}
          </div>
        </fieldset>

        <fieldset class="jkrb-step" data-jkrb-step>
          <legend><span>02</span> Choose setting</legend>
          <div class="jkrb-choice-grid jkrb-choice-grid--setting">
            <label class="jkrb-card is-selected" data-jkrb-card>
              <input type="radio" name="custom-setting-{{ section.id }}" value="Solitaire" data-jkrb-choice data-jkrb-setting="solitaire" data-price-adjustment="0" checked>
              <span class="jkrb-setting-icon jkrb-setting-icon--solitaire" aria-hidden="true"></span>
              <span class="jkrb-card__title">Solitaire</span>
              <small>Clean, timeless centre-stone focus.</small>
            </label>
            <label class="jkrb-card" data-jkrb-card>
              <input type="radio" name="custom-setting-{{ section.id }}" value="Hidden Halo" data-jkrb-choice data-jkrb-setting="hidden-halo" data-price-adjustment="35000">
              <span class="jkrb-setting-icon jkrb-setting-icon--hidden-halo" aria-hidden="true"></span>
              <span class="jkrb-card__title">Hidden Halo</span>
              <small>Subtle sparkle tucked below the crown.</small>
            </label>
            <label class="jkrb-card" data-jkrb-card>
              <input type="radio" name="custom-setting-{{ section.id }}" value="Halo" data-jkrb-choice data-jkrb-setting="halo" data-price-adjustment="50000">
              <span class="jkrb-setting-icon jkrb-setting-icon--halo" aria-hidden="true"></span>
              <span class="jkrb-card__title">Halo</span>
              <small>A luminous frame around the stone.</small>
            </label>
            <label class="jkrb-card" data-jkrb-card>
              <input type="radio" name="custom-setting-{{ section.id }}" value="Three Stone" data-jkrb-choice data-jkrb-setting="three-stone" data-price-adjustment="85000">
              <span class="jkrb-setting-icon jkrb-setting-icon--three-stone" aria-hidden="true"></span>
              <span class="jkrb-card__title">Three Stone</span>
              <small>Balanced side-stone presence.</small>
            </label>
          </div>
        </fieldset>

        <fieldset class="jkrb-step" data-jkrb-step>
          <legend><span>03</span> Choose metal</legend>
          <div class="jkrb-metal-row">
            <label class="jkrb-metal-button is-selected" data-jkrb-card>
              <input type="radio" name="custom-metal-{{ section.id }}" value="Platinum" data-jkrb-choice data-jkrb-metal="platinum" data-price-adjustment="60000" checked>
              <span class="jkrb-metal-swatch jkrb-metal-swatch--platinum" aria-hidden="true"></span>
              Platinum
            </label>
            <label class="jkrb-metal-button" data-jkrb-card>
              <input type="radio" name="custom-metal-{{ section.id }}" value="18K Yellow Gold" data-jkrb-choice data-jkrb-metal="yellow-gold" data-price-adjustment="0">
              <span class="jkrb-metal-swatch jkrb-metal-swatch--yellow-gold" aria-hidden="true"></span>
              18K Yellow Gold
            </label>
            <label class="jkrb-metal-button" data-jkrb-card>
              <input type="radio" name="custom-metal-{{ section.id }}" value="18K White Gold" data-jkrb-choice data-jkrb-metal="white-gold" data-price-adjustment="15000">
              <span class="jkrb-metal-swatch jkrb-metal-swatch--white-gold" aria-hidden="true"></span>
              18K White Gold
            </label>
            <label class="jkrb-metal-button" data-jkrb-card>
              <input type="radio" name="custom-metal-{{ section.id }}" value="Rose Gold" data-jkrb-choice data-jkrb-metal="rose-gold" data-price-adjustment="15000">
              <span class="jkrb-metal-swatch jkrb-metal-swatch--rose-gold" aria-hidden="true"></span>
              Rose Gold
            </label>
          </div>
        </fieldset>

        <div class="jkrb-step jkrb-step--carat" data-jkrb-step>
          <div class="jkrb-step__heading">
            <span>04</span>
            <label for="CustomCarat-{{ section.id }}">Choose carat presence</label>
          </div>
          <div class="jkrb-range">
            <input id="CustomCarat-{{ section.id }}" type="range" min="0.5" max="5" step="0.25" value="{{ section.settings.base_carat }}" data-jkrb-choice data-jkrb-carat>
            <output for="CustomCarat-{{ section.id }}" data-jkrb-carat-output>{{ section.settings.base_carat }} ct</output>
          </div>
          <p>Estimate updates instantly. Final price depends on live diamond availability, certification, and setting review.</p>
        </div>

        <div class="jkrb-builder-summary">
          <div>
            <p class="jkrb-eyebrow">Selected design</p>
            <h2 data-jkrb-summary-panel>Round solitaire in platinum</h2>
          </div>
          <div class="jkrb-estimate jkrb-estimate--panel">
            <span>Estimated from</span>
            <strong data-jkrb-price-panel>{{ section.settings.base_price | plus: 60000 | money }}</strong>
          </div>
          <div class="jkrb-builder-actions">
            <a class="jkrb-button jkrb-button--dark" href="{{ section.settings.choose_diamond_link | default: '/collections/loose-diamonds' }}" data-jkrb-choose-diamond-link>Choose a Diamond</a>
            <a class="jkrb-button jkrb-button--light" href="{{ section.settings.choose_setting_link | default: '/pages/contact' }}" data-jkrb-choose-setting-link>Choose this Setting</a>
            <a class="jkrb-button jkrb-button--outline" href="{{ section.settings.request_link | default: '/pages/contact' }}" data-jkrb-request-link-panel>Request This Ring</a>
          </div>
        </div>
      </div>

      <aside class="jkrb-preview" aria-label="Luxury live ring preview">
        <div class="jkrb-preview__media{% if section.settings.preview_image != blank %} jkrb-preview__media--image{% endif %}">
          {% if section.settings.preview_image != blank %}
            {{ section.settings.preview_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500, 700, 900, 1200', sizes: '(min-width: 990px) 460px, 100vw', alt: section.settings.preview_image_alt, class: 'jkrb-preview__backdrop' }}
          {% endif %}

          <div class="jkrb-preview-stage" data-jkrb-preview-stage>
            {% if initial_model_url != blank and sequence_count == 0 %}
              <div class="jkrb-model-shell" data-jkrb-model-shell>
                <model-viewer
                  class="jkrb-model-viewer"
                  data-jkrb-model
                  src="{{ initial_model_url | escape }}"
                  {% if section.settings.preview_image != blank %}
                    poster="{{ section.settings.preview_image | image_url: width: 1200 }}"
                  {% endif %}
                  camera-controls
                  auto-rotate
                  auto-rotate-delay="1800"
                  rotation-per-second="18deg"
                  shadow-intensity="0.72"
                  exposure="1"
                  environment-image="neutral"
                  loading="eager"
                  reveal="auto"
                  aria-label="Interactive Joyari Krafted ring model"
                >
                  <div class="jkrb-model-progress" slot="progress-bar"><span></span></div>
                </model-viewer>
                <div class="jkrb-model-loading" data-jkrb-model-loading>
                  <span></span>
                  <p>Preparing 3D ring preview</p>
                </div>
              </div>
            {% endif %}

            {% if sequence_count > 0 %}
              <div class="jkrb-sequence-viewer" data-jkrb-sequence-viewer aria-label="Drag to rotate ring preview" role="img">
                <div class="jkrb-sequence-viewer__hint">
                  <span>{% if sequence_count > 1 %}Drag to rotate{% else %}Move to inspect{% endif %}</span>
                </div>
                {% assign rendered_sequence_index = 0 %}
                {% if sequence_frame_1_url != blank %}
                  {% assign rendered_sequence_index = rendered_sequence_index | plus: 1 %}
                  {% assign sequence_alt = 'Joyari Krafted 360 ring frame ' | append: rendered_sequence_index %}
                  <img src="{{ sequence_frame_1_url }}" alt="Joyari Krafted 360 ring preview" class="jkrb-sequence-main" loading="eager" width="1600" height="1600" data-jkrb-sequence-main>
                  <div class="jkrb-sequence-frame is-active" data-jkrb-sequence-frame data-frame-index="0">
                    <img src="{{ sequence_frame_1_url }}" alt="{{ sequence_alt | escape }}" class="jkrb-sequence-frame__image" loading="eager" width="1600" height="1600">
                  </div>
                {% endif %}
                {% if sequence_frame_2_url != blank %}
                  {% assign rendered_sequence_index = rendered_sequence_index | plus: 1 %}
                  {% assign sequence_alt = 'Joyari Krafted 360 ring frame ' | append: rendered_sequence_index %}
                  <div class="jkrb-sequence-frame{% if rendered_sequence_index == 1 %} is-active{% endif %}" data-jkrb-sequence-frame data-frame-index="{{ rendered_sequence_index | minus: 1 }}">
                    <img src="{{ sequence_frame_2_url }}" alt="{{ sequence_alt | escape }}" class="jkrb-sequence-frame__image" loading="eager" width="1600" height="1600">
                  </div>
                {% endif %}
                {% if sequence_frame_3_url != blank %}
                  {% assign rendered_sequence_index = rendered_sequence_index | plus: 1 %}
                  {% assign sequence_alt = 'Joyari Krafted 360 ring frame ' | append: rendered_sequence_index %}
                  <div class="jkrb-sequence-frame{% if rendered_sequence_index == 1 %} is-active{% endif %}" data-jkrb-sequence-frame data-frame-index="{{ rendered_sequence_index | minus: 1 }}">
                    <img src="{{ sequence_frame_3_url }}" alt="{{ sequence_alt | escape }}" class="jkrb-sequence-frame__image" loading="eager" width="1600" height="1600">
                  </div>
                {% endif %}
                {% if sequence_frame_4_url != blank %}
                  {% assign rendered_sequence_index = rendered_sequence_index | plus: 1 %}
                  {% assign sequence_alt = 'Joyari Krafted 360 ring frame ' | append: rendered_sequence_index %}
                  <div class="jkrb-sequence-frame{% if rendered_sequence_index == 1 %} is-active{% endif %}" data-jkrb-sequence-frame data-frame-index="{{ rendered_sequence_index | minus: 1 }}">
                    <img src="{{ sequence_frame_4_url }}" alt="{{ sequence_alt | escape }}" class="jkrb-sequence-frame__image" loading="eager" width="1600" height="1600">
                  </div>
                {% endif %}
                {% if sequence_frame_5_url != blank %}
                  {% assign rendered_sequence_index = rendered_sequence_index | plus: 1 %}
                  {% assign sequence_alt = 'Joyari Krafted 360 ring frame ' | append: rendered_sequence_index %}
                  <div class="jkrb-sequence-frame{% if rendered_sequence_index == 1 %} is-active{% endif %}" data-jkrb-sequence-frame data-frame-index="{{ rendered_sequence_index | minus: 1 }}">
                    <img src="{{ sequence_frame_5_url }}" alt="{{ sequence_alt | escape }}" class="jkrb-sequence-frame__image" loading="eager" width="1600" height="1600">
                  </div>
                {% endif %}
                {% if sequence_frame_6_url != blank %}
                  {% assign rendered_sequence_index = rendered_sequence_index | plus: 1 %}
                  {% assign sequence_alt = 'Joyari Krafted 360 ring frame ' | append: rendered_sequence_index %}
                  <div class="jkrb-sequence-frame{% if rendered_sequence_index == 1 %} is-active{% endif %}" data-jkrb-sequence-frame data-frame-index="{{ rendered_sequence_index | minus: 1 }}">
                    <img src="{{ sequence_frame_6_url }}" alt="{{ sequence_alt | escape }}" class="jkrb-sequence-frame__image" loading="eager" width="1600" height="1600">
                  </div>
                {% endif %}
                {% if sequence_frame_7_url != blank %}
                  {% assign rendered_sequence_index = rendered_sequence_index | plus: 1 %}
                  {% assign sequence_alt = 'Joyari Krafted 360 ring frame ' | append: rendered_sequence_index %}
                  <div class="jkrb-sequence-frame{% if rendered_sequence_index == 1 %} is-active{% endif %}" data-jkrb-sequence-frame data-frame-index="{{ rendered_sequence_index | minus: 1 }}">
                    <img src="{{ sequence_frame_7_url }}" alt="{{ sequence_alt | escape }}" class="jkrb-sequence-frame__image" loading="eager" width="1600" height="1600">
                  </div>
                {% endif %}
                {% if sequence_frame_8_url != blank %}
                  {% assign rendered_sequence_index = rendered_sequence_index | plus: 1 %}
                  {% assign sequence_alt = 'Joyari Krafted 360 ring frame ' | append: rendered_sequence_index %}
                  <div class="jkrb-sequence-frame{% if rendered_sequence_index == 1 %} is-active{% endif %}" data-jkrb-sequence-frame data-frame-index="{{ rendered_sequence_index | minus: 1 }}">
                    <img src="{{ sequence_frame_8_url }}" alt="{{ sequence_alt | escape }}" class="jkrb-sequence-frame__image" loading="eager" width="1600" height="1600">
                  </div>
                {% endif %}
              </div>
            {% endif %}

            <div class="jkrb-preview-photo jkrb-preview-photo--setting is-active" data-jkrb-preview-setting="solitaire">
              {% if section.settings.setting_solitaire_image != blank %}
                {{ section.settings.setting_solitaire_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500, 700, 900, 1200', sizes: '(min-width: 990px) 460px, 100vw', alt: 'Solitaire engagement ring preview', class: 'jkrb-preview-photo__image' }}
              {% else %}
                <span class="jkrb-preview-placeholder jkrb-preview-placeholder--setting jkrb-preview-placeholder--solitaire"><span>Solitaire setting</span></span>
              {% endif %}
            </div>
            <div class="jkrb-preview-photo jkrb-preview-photo--setting" data-jkrb-preview-setting="hidden-halo">
              {% if section.settings.setting_hidden_halo_image != blank %}
                {{ section.settings.setting_hidden_halo_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500, 700, 900, 1200', sizes: '(min-width: 990px) 460px, 100vw', alt: 'Hidden halo engagement ring preview', class: 'jkrb-preview-photo__image' }}
              {% else %}
                <span class="jkrb-preview-placeholder jkrb-preview-placeholder--setting jkrb-preview-placeholder--hidden-halo"><span>Hidden halo setting</span></span>
              {% endif %}
            </div>
            <div class="jkrb-preview-photo jkrb-preview-photo--setting" data-jkrb-preview-setting="halo">
              {% if section.settings.setting_halo_image != blank %}
                {{ section.settings.setting_halo_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500, 700, 900, 1200', sizes: '(min-width: 990px) 460px, 100vw', alt: 'Halo engagement ring preview', class: 'jkrb-preview-photo__image' }}
              {% else %}
                <span class="jkrb-preview-placeholder jkrb-preview-placeholder--setting jkrb-preview-placeholder--halo"><span>Halo setting</span></span>
              {% endif %}
            </div>
            <div class="jkrb-preview-photo jkrb-preview-photo--setting" data-jkrb-preview-setting="three-stone">
              {% if section.settings.setting_three_stone_image != blank %}
                {{ section.settings.setting_three_stone_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500, 700, 900, 1200', sizes: '(min-width: 990px) 460px, 100vw', alt: 'Three stone engagement ring preview', class: 'jkrb-preview-photo__image' }}
              {% else %}
                <span class="jkrb-preview-placeholder jkrb-preview-placeholder--setting jkrb-preview-placeholder--three-stone"><span>Three stone setting</span></span>
              {% endif %}
            </div>

            <div class="jkrb-preview-inset" aria-hidden="true">
              <span class="jkrb-preview-inset__label">Diamond shape</span>
              <div class="jkrb-preview-photo jkrb-preview-photo--shape is-active" data-jkrb-preview-shape="round">
                {% if section.settings.shape_round_image != blank %}
                  {{ section.settings.shape_round_image | image_url: width: 520 | image_tag: loading: 'lazy', widths: '220, 360, 520', sizes: '150px', alt: 'Round diamond preview', class: 'jkrb-preview-photo__image' }}
                {% else %}
                  <span class="jkrb-preview-placeholder jkrb-preview-placeholder--shape jkrb-preview-placeholder--round"><span>Round</span></span>
                {% endif %}
              </div>
              <div class="jkrb-preview-photo jkrb-preview-photo--shape" data-jkrb-preview-shape="oval">
                {% if section.settings.shape_oval_image != blank %}
                  {{ section.settings.shape_oval_image | image_url: width: 520 | image_tag: loading: 'lazy', widths: '220, 360, 520', sizes: '150px', alt: 'Oval diamond preview', class: 'jkrb-preview-photo__image' }}
                {% else %}
                  <span class="jkrb-preview-placeholder jkrb-preview-placeholder--shape jkrb-preview-placeholder--oval"><span>Oval</span></span>
                {% endif %}
              </div>
              <div class="jkrb-preview-photo jkrb-preview-photo--shape" data-jkrb-preview-shape="pear">
                {% if section.settings.shape_pear_image != blank %}
                  {{ section.settings.shape_pear_image | image_url: width: 520 | image_tag: loading: 'lazy', widths: '220, 360, 520', sizes: '150px', alt: 'Pear diamond preview', class: 'jkrb-preview-photo__image' }}
                {% else %}
                  <span class="jkrb-preview-placeholder jkrb-preview-placeholder--shape jkrb-preview-placeholder--pear"><span>Pear</span></span>
                {% endif %}
              </div>
              <div class="jkrb-preview-photo jkrb-preview-photo--shape" data-jkrb-preview-shape="emerald">
                {% if section.settings.shape_emerald_image != blank %}
                  {{ section.settings.shape_emerald_image | image_url: width: 520 | image_tag: loading: 'lazy', widths: '220, 360, 520', sizes: '150px', alt: 'Emerald diamond preview', class: 'jkrb-preview-photo__image' }}
                {% else %}
                  <span class="jkrb-preview-placeholder jkrb-preview-placeholder--shape jkrb-preview-placeholder--emerald"><span>Emerald</span></span>
                {% endif %}
              </div>
              <div class="jkrb-preview-photo jkrb-preview-photo--shape" data-jkrb-preview-shape="cushion">
                {% if section.settings.shape_cushion_image != blank %}
                  {{ section.settings.shape_cushion_image | image_url: width: 520 | image_tag: loading: 'lazy', widths: '220, 360, 520', sizes: '150px', alt: 'Cushion diamond preview', class: 'jkrb-preview-photo__image' }}
                {% else %}
                  <span class="jkrb-preview-placeholder jkrb-preview-placeholder--shape jkrb-preview-placeholder--cushion"><span>Cushion</span></span>
                {% endif %}
              </div>
            </div>

            <div class="jkrb-preview-metal-panel" aria-hidden="true">
              <span class="jkrb-preview-inset__label">Metal tone</span>
              <div class="jkrb-preview-photo jkrb-preview-photo--metal is-active" data-jkrb-preview-metal="platinum">
                {% if section.settings.metal_platinum_image != blank %}
                  {{ section.settings.metal_platinum_image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '240, 420, 640', sizes: '190px', alt: 'Platinum metal tone preview', class: 'jkrb-preview-photo__image' }}
                {% else %}
                  <span class="jkrb-preview-placeholder jkrb-preview-placeholder--metal jkrb-preview-placeholder--platinum"><span>Platinum</span></span>
                {% endif %}
              </div>
              <div class="jkrb-preview-photo jkrb-preview-photo--metal" data-jkrb-preview-metal="yellow-gold">
                {% if section.settings.metal_yellow_gold_image != blank %}
                  {{ section.settings.metal_yellow_gold_image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '240, 420, 640', sizes: '190px', alt: '18K yellow gold metal tone preview', class: 'jkrb-preview-photo__image' }}
                {% else %}
                  <span class="jkrb-preview-placeholder jkrb-preview-placeholder--metal jkrb-preview-placeholder--yellow-gold"><span>18K Yellow Gold</span></span>
                {% endif %}
              </div>
              <div class="jkrb-preview-photo jkrb-preview-photo--metal" data-jkrb-preview-metal="white-gold">
                {% if section.settings.metal_white_gold_image != blank %}
                  {{ section.settings.metal_white_gold_image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '240, 420, 640', sizes: '190px', alt: '18K white gold metal tone preview', class: 'jkrb-preview-photo__image' }}
                {% else %}
                  <span class="jkrb-preview-placeholder jkrb-preview-placeholder--metal jkrb-preview-placeholder--white-gold"><span>18K White Gold</span></span>
                {% endif %}
              </div>
              <div class="jkrb-preview-photo jkrb-preview-photo--metal" data-jkrb-preview-metal="rose-gold">
                {% if section.settings.metal_rose_gold_image != blank %}
                  {{ section.settings.metal_rose_gold_image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '240, 420, 640', sizes: '190px', alt: 'Rose gold metal tone preview', class: 'jkrb-preview-photo__image' }}
                {% else %}
                  <span class="jkrb-preview-placeholder jkrb-preview-placeholder--metal jkrb-preview-placeholder--rose-gold"><span>Rose Gold</span></span>
                {% endif %}
              </div>
            </div>

            <div class="jkrb-lifestyle-panel" data-jkrb-lifestyle-panel aria-hidden="true">
              {% if section.settings.lifestyle_image != blank %}
                {{ section.settings.lifestyle_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500, 700, 900, 1200', sizes: '(min-width: 990px) 600px, 100vw', alt: section.settings.lifestyle_image_alt, class: 'jkrb-lifestyle-panel__image' }}
              {% else %}
                <span class="jkrb-preview-placeholder jkrb-preview-placeholder--lifestyle"><span>Lifestyle preview</span></span>
              {% endif %}
            </div>

            <button class="jkrb-zoom-trigger" type="button" data-jkrb-zoom-open aria-label="Open ring preview fullscreen">
              <span>Zoom</span>
            </button>
          </div>
        </div>

        <div class="jkrb-gallery-thumbs" aria-label="Preview gallery">
          <button class="jkrb-gallery-thumb is-active" type="button" data-jkrb-gallery-thumb data-gallery-view="main">
            <span class="jkrb-gallery-thumb__visual jkrb-gallery-thumb__visual--main"></span>
            <span>{% if sequence_count > 1 %}360 preview{% else %}Main preview{% endif %}</span>
          </button>
          <button class="jkrb-gallery-thumb" type="button" data-jkrb-gallery-thumb data-gallery-view="shape">
            <span class="jkrb-gallery-thumb__visual">
              <span class="jkrb-gallery-thumb__layer is-active" data-jkrb-thumb-shape="round">{% if section.settings.shape_round_image != blank %}{{ section.settings.shape_round_image | image_url: width: 220 | image_tag: loading: 'lazy', widths: '120, 180, 220', sizes: '72px', alt: 'Round diamond thumbnail' }}{% else %}<span class="jkrb-gallery-thumb__stone jkrb-gallery-thumb__stone--round"></span>{% endif %}</span>
              <span class="jkrb-gallery-thumb__layer" data-jkrb-thumb-shape="oval">{% if section.settings.shape_oval_image != blank %}{{ section.settings.shape_oval_image | image_url: width: 220 | image_tag: loading: 'lazy', widths: '120, 180, 220', sizes: '72px', alt: 'Oval diamond thumbnail' }}{% else %}<span class="jkrb-gallery-thumb__stone jkrb-gallery-thumb__stone--oval"></span>{% endif %}</span>
              <span class="jkrb-gallery-thumb__layer" data-jkrb-thumb-shape="pear">{% if section.settings.shape_pear_image != blank %}{{ section.settings.shape_pear_image | image_url: width: 220 | image_tag: loading: 'lazy', widths: '120, 180, 220', sizes: '72px', alt: 'Pear diamond thumbnail' }}{% else %}<span class="jkrb-gallery-thumb__stone jkrb-gallery-thumb__stone--pear"></span>{% endif %}</span>
              <span class="jkrb-gallery-thumb__layer" data-jkrb-thumb-shape="emerald">{% if section.settings.shape_emerald_image != blank %}{{ section.settings.shape_emerald_image | image_url: width: 220 | image_tag: loading: 'lazy', widths: '120, 180, 220', sizes: '72px', alt: 'Emerald diamond thumbnail' }}{% else %}<span class="jkrb-gallery-thumb__stone jkrb-gallery-thumb__stone--emerald"></span>{% endif %}</span>
              <span class="jkrb-gallery-thumb__layer" data-jkrb-thumb-shape="cushion">{% if section.settings.shape_cushion_image != blank %}{{ section.settings.shape_cushion_image | image_url: width: 220 | image_tag: loading: 'lazy', widths: '120, 180, 220', sizes: '72px', alt: 'Cushion diamond thumbnail' }}{% else %}<span class="jkrb-gallery-thumb__stone jkrb-gallery-thumb__stone--cushion"></span>{% endif %}</span>
            </span>
            <span>Shape image</span>
          </button>
          <button class="jkrb-gallery-thumb" type="button" data-jkrb-gallery-thumb data-gallery-view="setting">
            <span class="jkrb-gallery-thumb__visual">
              <span class="jkrb-gallery-thumb__layer is-active" data-jkrb-thumb-setting="solitaire">{% if section.settings.setting_solitaire_image != blank %}{{ section.settings.setting_solitaire_image | image_url: width: 220 | image_tag: loading: 'lazy', widths: '120, 180, 220', sizes: '72px', alt: 'Solitaire setting thumbnail' }}{% else %}<span class="jkrb-gallery-thumb__ring"></span>{% endif %}</span>
              <span class="jkrb-gallery-thumb__layer" data-jkrb-thumb-setting="hidden-halo">{% if section.settings.setting_hidden_halo_image != blank %}{{ section.settings.setting_hidden_halo_image | image_url: width: 220 | image_tag: loading: 'lazy', widths: '120, 180, 220', sizes: '72px', alt: 'Hidden halo setting thumbnail' }}{% else %}<span class="jkrb-gallery-thumb__ring"></span>{% endif %}</span>
              <span class="jkrb-gallery-thumb__layer" data-jkrb-thumb-setting="halo">{% if section.settings.setting_halo_image != blank %}{{ section.settings.setting_halo_image | image_url: width: 220 | image_tag: loading: 'lazy', widths: '120, 180, 220', sizes: '72px', alt: 'Halo setting thumbnail' }}{% else %}<span class="jkrb-gallery-thumb__ring"></span>{% endif %}</span>
              <span class="jkrb-gallery-thumb__layer" data-jkrb-thumb-setting="three-stone">{% if section.settings.setting_three_stone_image != blank %}{{ section.settings.setting_three_stone_image | image_url: width: 220 | image_tag: loading: 'lazy', widths: '120, 180, 220', sizes: '72px', alt: 'Three stone setting thumbnail' }}{% else %}<span class="jkrb-gallery-thumb__ring"></span>{% endif %}</span>
            </span>
            <span>Setting image</span>
          </button>
          <button class="jkrb-gallery-thumb" type="button" data-jkrb-gallery-thumb data-gallery-view="lifestyle">
            <span class="jkrb-gallery-thumb__visual">
              {% if section.settings.lifestyle_image != blank %}
                {{ section.settings.lifestyle_image | image_url: width: 220 | image_tag: loading: 'lazy', widths: '120, 180, 220', sizes: '72px', alt: section.settings.lifestyle_image_alt }}
              {% else %}
                <span class="jkrb-gallery-thumb__lifestyle"></span>
              {% endif %}
            </span>
            <span>Lifestyle</span>
          </button>
        </div>

        <div class="jkrb-preview__content">
          <p class="jkrb-eyebrow">Live preview</p>
          <h2 data-jkrb-summary>Round solitaire in platinum</h2>
          <dl class="jkrb-preview-list">
            <div><dt>Shape</dt><dd data-jkrb-selected-shape>Round</dd></div>
            <div><dt>Setting</dt><dd data-jkrb-selected-setting>Solitaire</dd></div>
            <div><dt>Metal</dt><dd data-jkrb-selected-metal>Platinum</dd></div>
            <div><dt>Carat</dt><dd data-jkrb-selected-carat>{{ section.settings.base_carat }} ct</dd></div>
          </dl>
          <div class="jkrb-estimate">
            <span>Estimated from</span>
            <strong data-jkrb-price>{{ section.settings.base_price | plus: 60000 | money }}</strong>
          </div>
          <p class="jkrb-preview__note">{{ section.settings.estimate_note }}</p>
          <a class="jkrb-button jkrb-button--dark jkrb-request-button" href="{{ section.settings.request_link | default: '/pages/contact' }}" data-jkrb-request-link>Request This Ring</a>
          <textarea class="jkrb-payload" aria-hidden="true" tabindex="-1" data-jkrb-payload readonly></textarea>
        </div>
      </aside>
    </div>

    <div class="jkrb-spec-grid" aria-label="Ring specification cards">
      <article>
        <span>Metal</span>
        <strong data-jkrb-spec-metal>Platinum</strong>
        <p>Refined finish selected for tone, durability, and daily wear.</p>
      </article>
      <article>
        <span>Diamond shape</span>
        <strong data-jkrb-spec-shape>Round</strong>
        <p>Preview shape updates now; live diamond availability can connect later.</p>
      </article>
      <article>
        <span>Setting</span>
        <strong data-jkrb-spec-setting>Solitaire</strong>
        <p>Setting architecture is prepared for future setting and diamond API data.</p>
      </article>
      <article>
        <span>Private quote</span>
        <strong>Joyari guidance</strong>
        <p>Our team confirms proportions, certification, and final pricing before production.</p>
      </article>
    </div>

    <div class="jkrb-consultation">
      <p class="jkrb-eyebrow">Consultation</p>
      <h2>{{ section.settings.consultation_heading }}</h2>
      <p>{{ section.settings.consultation_text }}</p>
      <div class="jkrb-consultation__actions">
        <a class="jkrb-button jkrb-button--dark" href="{{ section.settings.consultation_link | default: '/pages/contact' }}" data-jkrb-consultation-link>{{ section.settings.consultation_label }}</a>
        <a class="jkrb-button jkrb-button--light" href="{{ section.settings.request_link | default: '/pages/contact' }}" data-jkrb-request-link-secondary>Request This Ring</a>
      </div>
    </div>
  </div>

  <div class="jkrb-sticky-cta" data-jkrb-sticky-cta>
    <div>
      <span>Current estimate</span>
      <strong data-jkrb-sticky-price>{{ section.settings.base_price | plus: 60000 | money }}</strong>
    </div>
    <a class="jkrb-button jkrb-button--dark" href="{{ section.settings.request_link | default: '/pages/contact' }}" data-jkrb-sticky-link>Request This Ring</a>
  </div>

  <div class="jkrb-zoom-modal" data-jkrb-zoom-modal hidden>
    <button class="jkrb-zoom-modal__backdrop" type="button" data-jkrb-zoom-close aria-label="Close preview"></button>
    <div class="jkrb-zoom-modal__dialog" role="dialog" aria-modal="true" aria-label="Ring preview fullscreen">
      <button class="jkrb-zoom-modal__close" type="button" data-jkrb-zoom-close aria-label="Close fullscreen preview">Close</button>
      <div class="jkrb-zoom-modal__media">
        <div class="jkrb-zoom-modal__image" role="img" aria-label="Joyari Krafted ring preview" data-jkrb-zoom-image hidden></div>
        <div class="jkrb-zoom-modal__placeholder" data-jkrb-zoom-placeholder>
          <span>Joyari Krafted ring preview</span>
        </div>
      </div>
    </div>
  </div>
</section>

