{{ 'custom-ring-builder.css' | asset_url | stylesheet_tag }}

<section class="jkb jkb--enquiry" aria-labelledby="CustomRingEnquiryTitle">
  <div class="jkb-enquiry__inner">
    <div class="jkb-enquiry__hero">
      <p class="jkb-enquiry__eyebrow">Joyari Krafted bespoke design</p>
      <h1 id="CustomRingEnquiryTitle">Custom Engagement Rings</h1>
      <p class="jkb-enquiry__subtitle">Share your dream ring with us. Our team will guide you through diamond selection, metal choice, CAD design and final crafting.</p>
      <a class="jkb-enquiry__primary" href="#custom-ring-enquiry">Request a Custom Ring Quote</a>
    </div>

    <div class="jkb-enquiry__panel" id="custom-ring-enquiry">
      <div class="jkb-enquiry__copy">
        <h2>Private Guidance</h2>
        <p>For custom designs, quotes, CAD requests or private guidance, please email us.</p>
        <div class="jkb-enquiry__email">
          <span>Email</span>
          <strong>[PUT EMAIL HERE LATER]</strong>
        </div>
        <a class="jkb-enquiry__secondary" href="#custom-ring-enquiry" aria-label="Email Joyari Krafted for a custom ring enquiry">Email Us</a>
      </div>

      <ul class="jkb-enquiry__list" aria-label="Custom ring inclusions">
        <li>Lab-grown and natural diamonds available</li>
        <li>10K, 14K and 18K gold options</li>
        <li>CAD preview before production</li>
        <li>IGI/GIA certified stones available</li>
        <li>Made to order in 12–15 business days</li>
        <li>Insured delivery</li>
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom ring enquiry",
  "tag": "section",
  "class": "shopify-section--custom-ring-builder",
  "settings": [],
  "presets": [{ "name": "Custom ring enquiry" }]
}
{% endschema %}
