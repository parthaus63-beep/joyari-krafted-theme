{% render 'diamond-selection-markup' %}
{% schema %}
{
  "name": "Custom ring builder",
  "tag": "section",
  "class": "shopify-section--custom-ring-builder",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Hero eyebrow",
      "default": "Joyari Krafted custom design"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Hero heading",
      "default": "Design Your Ring"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Hero text",
      "default": "Shape a custom engagement ring with a calm, luxurious first-design experience."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "hero_image_alt",
      "label": "Hero image alt text",
      "default": "Joyari Krafted custom engagement ring"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Hero primary button",
      "default": "Start Designing"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Hero secondary button",
      "default": "Book Consultation"
    },
    {
      "type": "image_picker",
      "id": "preview_image",
      "label": "Preview background image"
    },
    {
      "type": "text",
      "id": "preview_image_alt",
      "label": "Preview image alt text",
      "default": "Luxury ring preview"
    },
    {
      "type": "image_picker",
      "id": "lifestyle_image",
      "label": "Lifestyle gallery image"
    },
    {
      "type": "text",
      "id": "lifestyle_image_alt",
      "label": "Lifestyle image alt text",
      "default": "Joyari Krafted custom ring lifestyle preview"
    },
    {
      "type": "header",
      "content": "Free 360 image sequence"
    },
    {
      "type": "image_picker",
      "id": "sequence_frame_1",
      "label": "360 frame 1"
    },
    {
      "type": "image_picker",
      "id": "sequence_frame_2",
      "label": "360 frame 2"
    },
    {
      "type": "image_picker",
      "id": "sequence_frame_3",
      "label": "360 frame 3"
    },
    {
      "type": "image_picker",
      "id": "sequence_frame_4",
      "label": "360 frame 4"
    },
    {
      "type": "image_picker",
      "id": "sequence_frame_5",
      "label": "360 frame 5"
    },
    {
      "type": "image_picker",
      "id": "sequence_frame_6",
      "label": "360 frame 6"
    },
    {
      "type": "image_picker",
      "id": "sequence_frame_7",
      "label": "360 frame 7"
    },
    {
      "type": "image_picker",
      "id": "sequence_frame_8",
      "label": "360 frame 8"
    },
    {
      "type": "header",
      "content": "Optional 3D model URLs"
    },
    {
      "type": "text",
      "id": "default_model_url",
      "label": "Default GLB/GLTF model URL",
      "info": "Upload a .glb or .gltf file to Shopify Files, then paste the file URL here."
    },
    {
      "type": "text",
      "id": "round_model_url",
      "label": "Round GLB/GLTF model URL"
    },
    {
      "type": "text",
      "id": "oval_model_url",
      "label": "Oval GLB/GLTF model URL"
    },
    {
      "type": "text",
      "id": "emerald_model_url",
      "label": "Emerald GLB/GLTF model URL"
    },
    {
      "type": "text",
      "id": "pear_model_url",
      "label": "Pear GLB/GLTF model URL"
    },
    {
      "type": "text",
      "id": "cushion_model_url",
      "label": "Cushion GLB/GLTF model URL"
    },
    {
      "type": "header",
      "content": "Diamond shape preview photos"
    },
    {
      "type": "image_picker",
      "id": "shape_round_image",
      "label": "Round diamond photo"
    },
    {
      "type": "image_picker",
      "id": "shape_oval_image",
      "label": "Oval diamond photo"
    },
    {
      "type": "image_picker",
      "id": "shape_pear_image",
      "label": "Pear diamond photo"
    },
    {
      "type": "image_picker",
      "id": "shape_emerald_image",
      "label": "Emerald diamond photo"
    },
    {
      "type": "image_picker",
      "id": "shape_cushion_image",
      "label": "Cushion diamond photo"
    },
    {
      "type": "header",
      "content": "Ring setting preview photos"
    },
    {
      "type": "image_picker",
      "id": "setting_solitaire_image",
      "label": "Solitaire ring photo"
    },
    {
      "type": "image_picker",
      "id": "setting_hidden_halo_image",
      "label": "Hidden halo ring photo"
    },
    {
      "type": "image_picker",
      "id": "setting_halo_image",
      "label": "Halo ring photo"
    },
    {
      "type": "image_picker",
      "id": "setting_three_stone_image",
      "label": "Three stone ring photo"
    },
    {
      "type": "header",
      "content": "Metal tone preview photos"
    },
    {
      "type": "image_picker",
      "id": "metal_platinum_image",
      "label": "Platinum tone photo"
    },
    {
      "type": "image_picker",
      "id": "metal_yellow_gold_image",
      "label": "18K yellow gold tone photo"
    },
    {
      "type": "image_picker",
      "id": "metal_white_gold_image",
      "label": "18K white gold tone photo"
    },
    {
      "type": "image_picker",
      "id": "metal_rose_gold_image",
      "label": "Rose gold tone photo"
    },
    {
      "type": "number",
      "id": "base_price",
      "label": "Base estimate, in cents",
      "default": 280000
    },
    {
      "type": "text",
      "id": "base_carat",
      "label": "Starting carat",
      "default": "1.50"
    },
    {
      "type": "number",
      "id": "carat_quarter_premium",
      "label": "Estimate increase per 0.25ct above 1ct, in cents",
      "default": 18500
    },
    {
      "type": "textarea",
      "id": "estimate_note",
      "label": "Estimate note",
      "default": "This is a design estimate using demo data. A Joyari specialist will confirm the final quote after stone selection, certification, and setting review."
    },
    {
      "type": "text",
      "id": "consultation_heading",
      "label": "Consultation heading",
      "default": "Ready to refine the ring privately?"
    },
    {
      "type": "textarea",
      "id": "consultation_text",
      "label": "Consultation text",
      "default": "Send your design direction to Joyari Krafted and our team will guide the stone, setting, proportion, ring size, and final quote."
    },
    {
      "type": "text",
      "id": "consultation_label",
      "label": "Consultation button label",
      "default": "Book Consultation"
    },
    {
      "type": "url",
      "id": "consultation_link",
      "label": "Consultation link"
    },
    {
      "type": "url",
      "id": "choose_diamond_link",
      "label": "Choose a Diamond link"
    },
    {
      "type": "url",
      "id": "choose_setting_link",
      "label": "Choose this Setting link"
    },
    {
      "type": "url",
      "id": "request_link",
      "label": "Request ring link"
    }
  ],
  "presets": [
    {
      "name": "Custom ring builder"
    }
  ]
}
{% endschema %}
