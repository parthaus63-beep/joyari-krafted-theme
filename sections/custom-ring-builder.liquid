    { "type": "image_picker", "id": "shape_marquise_image", "label": "Marquise diamond photo" },
    { "type": "image_picker", "id": "shape_radiant_image", "label": "Radiant diamond photo" },
    { "type": "header", "content": "Ring setting preview photos" },
    { "type": "image_picker", "id": "setting_solitaire_image", "label": "Solitaire ring photo" },
    { "type": "image_picker", "id": "setting_hidden_halo_image", "label": "Hidden halo ring photo" },
    { "type": "image_picker", "id": "setting_halo_image", "label": "Halo ring photo" },
    { "type": "image_picker", "id": "setting_three_stone_image", "label": "Three stone ring photo" },
