<section class="jk-ring-studio" aria-labelledby="RingStudioHeading-{{ section.id }}">
  <div class="jk-ring-studio__shell">
    <div class="jk-ring-studio__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="jk-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 id="RingStudioHeading-{{ section.id }}">{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}
        <p>{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    {% if section.settings.show_sync_message %}
      <div class="jk-ring-studio__status" role="status">
        <span class="jk-ring-studio__status-mark" aria-hidden="true"></span>
        <div class="jk-ring-studio__status-copy">
          <p class="jk-eyebrow">{{ section.settings.status_eyebrow }}</p>
          <h3>{{ section.settings.status_heading }}</h3>
          <p>{{ section.settings.status_text }}</p>
        </div>
        <div class="jk-ring-studio__actions">
          {% if section.settings.primary_label != blank %}
            <a class="jk-button jk-button--primary" href="{{ section.settings.primary_link | default: '/pages/contact' }}">{{ section.settings.primary_label }}</a>
          {% endif %}
          {% if section.settings.secondary_label != blank %}
            <a class="jk-button jk-button--secondary" href="{{ section.settings.secondary_link | default: '/pages/contact' }}">{{ section.settings.secondary_label }}</a>
          {% endif %}
        </div>
      </div>
    {% endif %}

    <div class="jk-ring-studio__app" data-nivoda-ring-studio>
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="jk-ring-studio__app-block" {{ block.shopify_attributes }}>
            {% render block %}
          </div>
        {% endfor %}
      {% else %}
        <div class="jk-ring-studio__empty">
          <p class="jk-eyebrow">Ring Studio</p>
          <h3>Connect the Nivoda Ring Studio app block</h3>
          <p>Add the Nivoda Ring Studio app block in the Shopify customizer to begin syncing settings and diamonds.</p>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Nivoda Ring Studio",
  "tag": "section",
  "class": "shopify-section--nivoda-ring-studio",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Design Your Ring"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Live ring studio"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore settings and diamonds in one refined studio experience once Nivoda syncing is complete."
    },
    {
      "type": "checkbox",
      "id": "show_sync_message",
      "label": "Show syncing message",
      "default": true
    },
    {
      "type": "text",
      "id": "status_eyebrow",
      "label": "Status eyebrow",
      "default": "Studio status"
    },
    {
      "type": "text",
      "id": "status_heading",
      "label": "Status heading",
      "default": "Premium settings are syncing"
    },
    {
      "type": "textarea",
      "id": "status_text",
      "label": "Status text",
      "default": "Our live ring studio is currently syncing premium ring settings and diamonds. Please check back shortly or contact us for a bespoke consultation."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Book Consultation"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Request Custom Ring"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Nivoda Ring Studio"
    }
  ]
}
{% endschema %}
