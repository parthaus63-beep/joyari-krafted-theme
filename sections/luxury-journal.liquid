<section class="jk-section jk-journal">
  <div class="jk-section__header jk-section__header--split">
    <div>
      {% if section.settings.eyebrow != blank %}
        <p class="jk-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}
        <p>{{ section.settings.subheading }}</p>
      {% endif %}
    </div>
  </div>

  <div class="jk-journal__grid">
    {% for block in section.blocks %}
      {% assign journal_image_alt = block.settings.image_alt | default: block.settings.title %}
      <article class="jk-journal-card" {{ block.shopify_attributes }}>
        <div class="jk-journal-card__media">
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '420, 640, 820, 1200', sizes: '(min-width: 900px) 33vw, 100vw', alt: journal_image_alt, class: 'jk-journal-card__image' }}
          {% else %}
            <span class="jk-journal-placeholder jk-journal-placeholder--{{ forloop.index }}" aria-hidden="true"></span>
          {% endif %}
        </div>
        <div class="jk-journal-card__content">
          {% if block.settings.eyebrow != blank %}
            <p class="jk-card-badge">{{ block.settings.eyebrow }}</p>
          {% endif %}
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Luxury journal cards",
  "tag": "section",
  "class": "shopify-section--luxury-journal",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Notes on diamonds, design, and meaningful moments"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Use these image-led cards for proposal guides, diamond education, styling notes, or behind-the-scenes atelier stories."
    }
  ],
  "blocks": [
    {
      "type": "journal_card",
      "name": "Journal card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Journal card image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Guide"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Choosing a diamond shape"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "A refined editorial card for helpful brand content and visual storytelling."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury journal cards",
      "blocks": [
        {
          "type": "journal_card",
          "settings": {
            "eyebrow": "Diamond guide",
            "title": "Choosing a diamond shape",
            "text": "A calm guide to proportion, silhouette, and the feeling each shape brings."
          }
        },
        {
          "type": "journal_card",
          "settings": {
            "eyebrow": "Proposal notes",
            "title": "Planning the reveal",
            "text": "Thoughtful details for making the moment feel intimate, elegant, and personal."
          }
        },
        {
          "type": "journal_card",
          "settings": {
            "eyebrow": "Atelier",
            "title": "Behind the polish",
            "text": "A space for craftsmanship, packaging, certification, and care-led storytelling."
          }
        }
      ]
    }
  ]
}
{% endschema %}
