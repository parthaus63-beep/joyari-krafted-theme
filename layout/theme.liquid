<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#F8F6F1">
    <meta name="joyari-theme-build" content="final-luxury-20260601-e3028b8">

    <link rel="canonical" href="{{ canonical_url }}">

    {% liquid
      assign joyari_brand_name = settings.brand_name | default: 'Joyari Krafted'
      assign joyari_page_title = page_title | replace: 'JoyariKrafted', 'Joyari Krafted' | replace: 'Joyari krafted', 'Joyari Krafted'
      assign joyari_meta_description = page_description | default: settings.meta_description | default: 'Luxury lab-grown diamond jewellery, engagement rings, and made-to-order bridal pieces by Joyari Krafted.'
      assign joyari_meta_description = joyari_meta_description | replace: 'JoyariKrafted', 'Joyari Krafted' | replace: 'Joyari krafted', 'Joyari Krafted'
    %}

    <title>
      {{ joyari_page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless joyari_page_title contains joyari_brand_name %} &ndash; {{ joyari_brand_name }}{% endunless -%}
    </title>

    <meta name="description" content="{{ joyari_meta_description | escape }}">

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.JoyariTheme = {
        moneyFormat: {{ shop.money_format | json }},
        routes: {
          cartAdd: {{ routes.cart_add_url | json }},
          cart: {{ routes.cart_url | json }}
        }
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}&joyari_build=final_luxury_20260601_e3028b8" defer></script>
    <script src="{{ 'joyari-live-polish.js' | asset_url }}&joyari_build=final_luxury_20260601_e3028b8" defer></script>

    {{ content_for_header }}
  </head>

  <body class="jk-template-{{ template.name | handle }} color-ivory">
    <a class="skip-to-content" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {% section 'header' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}
  </body>
</html>
