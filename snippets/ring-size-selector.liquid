{% liquid
  assign ring_size_select_id = select_id | default: 'JoyariRingSize'
  assign ring_size_modal_id = modal_id | default: 'JoyariRingSizeGuide'
  assign ring_size_options = 'F,F 1/2,G,G 1/2,H,H 1/2,I,I 1/2,J,J 1/2,K,K 1/2,L,L 1/2,M,M 1/2,N,N 1/2,O,O 1/2,P,P 1/2,Q,Q 1/2,R,R 1/2,S,S 1/2,T,T 1/2,U,U 1/2,V,V 1/2,W,W 1/2,X,X 1/2,Y,Y 1/2,Z,Help Me Later,Request free ring sizing kit' | split: ','
  assign ring_size_rows = 'F|US 3|44|14.1|44.2;G|US 3.5|45|14.4|45.5;H|US 4|46.5|14.8|46.8;I|US 4.5|47.5|15.2|48.0;J|US 4.75|49|15.5|48.7;K|US 5.25|50|15.9|50.0;L|US 5.75|51|16.3|51.2;M|US 6.25|52|16.7|52.5;N|US 6.75|54|17.1|53.8;O|US 7|55|17.5|55.1;P|US 7.5|56|17.9|56.3;Q|US 8|57|18.3|57.6;R|US 8.5|58.5|18.7|58.9;S|US 9|60|19.1|60.2;T|US 9.5|61|19.5|61.4;U|US 10|62.5|19.9|62.7;V|US 10.5|63.5|20.3|64.0;W|US 11|65|20.7|65.3;X|US 11.5|66|21.1|66.6;Y|US 12|67.5|21.5|67.8;Z|US 12.5|69|21.9|69.1;Z+1|US 13|70|22.3|70.4;Z+2|US 13.5|71|22.7|71.7' | split: ';'
%}

<div class="jk-builder-field jk-builder-field--ring-size">
  <div class="jk-builder-field__label-row">
    <label for="{{ ring_size_select_id }}">Ring size</label>
    <button
      type="button"
      class="jk-size-guide-trigger"
      aria-haspopup="dialog"
      aria-controls="{{ ring_size_modal_id }}"
      data-ring-size-guide-open="{{ ring_size_modal_id }}"
    >
      Ring Size Guide
    </button>
  </div>

  <div class="jk-ring-size-control">
    <select id="{{ ring_size_select_id }}" name="properties[Ring Size]" data-ring-size-select>
      <option value="">Select ring size</option>
      {% for size_option in ring_size_options %}
        <option value="{{ size_option | escape }}">
          {{ size_option }}
        </option>
      {% endfor %}
    </select>
  </div>

  <p class="jk-ring-size-assurance">Ring size is saved with your order as a line item detail, not as a Shopify variant.</p>

  <div
    id="{{ ring_size_modal_id }}"
    class="jk-size-guide-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="{{ ring_size_modal_id }}-Title"
    hidden
    data-ring-size-guide-modal
  >
    <button type="button" class="jk-size-guide-modal__backdrop" aria-label="Close size guide" data-ring-size-guide-close></button>

    <div class="jk-size-guide-modal__panel" role="document">
      <div class="jk-size-guide-modal__header">
        <div>
          <p class="jk-eyebrow">Joyari ring sizing</p>
          <h2 id="{{ ring_size_modal_id }}-Title">Ring Size Guide</h2>
          <p>Use the chart below to compare AUS/UK, US/Canada, EU, inside diameter, and inside circumference measurements.</p>
        </div>
        <button type="button" class="jk-size-guide-modal__close" aria-label="Close size guide" data-ring-size-guide-close>
          <span aria-hidden="true">&times;</span>
        </button>
      </div>

      <div class="jk-size-guide-table-wrap">
        <table class="jk-size-guide-table">
          <thead>
            <tr>
              <th scope="col">AUS/UK size</th>
              <th scope="col">US/Canada size</th>
              <th scope="col">EU size</th>
              <th scope="col">Inside diameter mm</th>
              <th scope="col">Inside circumference mm</th>
            </tr>
          </thead>
          <tbody>
            {% for row in ring_size_rows %}
              {% assign columns = row | split: '|' %}
              <tr>
                <td>{{ columns[0] }}</td>
                <td>{{ columns[1] }}</td>
                <td>{{ columns[2] }}</td>
                <td>{{ columns[3] }}</td>
                <td>{{ columns[4] }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <div class="jk-size-guide-notes">
        <h3>Helpful sizing notes</h3>
        <ul>
          <li>Measure at the end of the day when fingers are naturally warmer.</li>
          <li>Avoid measuring cold fingers, as they can read smaller than usual.</li>
          <li>Wider bands may need a half size up for a comfortable fit.</li>
          <li>If you are between sizes, choose the larger size.</li>
        </ul>
      </div>
    </div>
  </div>
</div>
