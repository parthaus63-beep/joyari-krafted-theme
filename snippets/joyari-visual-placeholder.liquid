{% liquid
  assign visual_type = type | default: 'ring'
%}

<div class="jk-luxury-visual-placeholder jk-luxury-visual-placeholder--{{ visual_type | handleize }}" aria-hidden="true">
  <svg viewBox="0 0 220 220" focusable="false" xmlns="http://www.w3.org/2000/svg">
    {% case visual_type %}
      {% when 'diamond' %}
        <path d="M50 72h120l-26 92H76Z"></path>
        <path d="M50 72l26-34h68l26 34M76 164l34-92 34 92M50 72l60 92 60-92M76 38l34 34 34-34M76 72h68"></path>
      {% when 'hand' %}
        <path d="M58 126c20-8 38-9 58-2l34 12c12 4 22 3 33-3"></path>
        <path d="M72 103c18-8 35-9 52-4l24 7"></path>
        <circle cx="111" cy="116" r="16"></circle>
        <path d="M111 93v46M88 116h46M95 100l32 32M127 100l-32 32"></path>
      {% when 'box' %}
        <path d="M54 88h112v76H54Z"></path>
        <path d="M54 88l24-28h64l24 28M78 60v28M142 60v28M76 124h68M96 144h28"></path>
        <circle cx="110" cy="106" r="12"></circle>
      {% when 'craft' %}
        <path d="M58 154l104-104M132 50l38 38M72 140l24 24"></path>
        <path d="M54 72h52M54 92h36M128 132h38M116 152h50"></path>
        <circle cx="110" cy="110" r="18"></circle>
      {% when 'video' %}
        <rect x="44" y="58" width="132" height="104" rx="14"></rect>
        <path d="M96 88l42 22-42 22Z"></path>
      {% else %}
        <circle cx="110" cy="112" r="54"></circle>
        <circle cx="110" cy="112" r="34"></circle>
        <path d="M84 63l26-30 26 30M84 63h52M94 82l16-19 16 19M56 112h108M72 148h76"></path>
    {% endcase %}
  </svg>
</div>
