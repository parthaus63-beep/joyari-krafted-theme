{{ 'diamond-selection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'diamond-selection.js' | asset_url }}" defer></script>

<section
  class="jk-diamond-select"
  data-diamond-selection
  data-endpoint="/apps/diamonds/search"
  data-setting-url="/pages/custom-design?step=setting"
>
  <div class="jk-diamond-select__hero">
    <div class="jk-diamond-select__intro">
      <p class="jk-diamond-select__eyebrow">Step 1 · Diamond first</p>
      <h1>Choose Your Centre Diamond</h1>
      <p>Filter live certified lab-grown diamonds from our trusted global diamond network before choosing a Joyari setting.</p>
    </div>

    <div class="jk-diamond-select__steps" aria-label="Design your ring steps">
      <span class="is-active">1. Choose diamond</span>
      <span>2. Choose ring setting</span>
      <span>3. Metal / ring size</span>
      <span>4. Review / add to cart</span>
    </div>
  </div>

  <div class="jk-diamond-select__shell">
    <aside class="jk-diamond-filters" aria-label="Diamond filters">
      <div class="jk-diamond-filters__heading">
        <p class="jk-diamond-select__eyebrow">Refine stones</p>
        <h2>Diamond filters</h2>
      </div>

      <form class="jk-diamond-filters__form" data-diamond-filter-form>
        <fieldset class="jk-filter-group jk-filter-group--shape">
          <legend>Shape</legend>
          <div class="jk-shape-filter-grid">
            {% assign shapes = 'Round,Oval,Pear,Emerald,Cushion,Princess,Marquise,Radiant' | split: ',' %}
            {% for shape in shapes %}
              {% assign shape_handle = shape | handleize %}
              <label class="jk-shape-filter">
                <input type="checkbox" name="shape" value="{{ shape }}">
                <span class="jk-shape-filter__stone jk-shape-filter__stone--{{ shape_handle }}" aria-hidden="true"></span>
                <span>{{ shape }}</span>
              </label>
            {% endfor %}
          </div>
        </fieldset>

        <div class="jk-filter-grid">
          <div class="jk-filter-group">
            <label for="DiamondCaratMin-Fallback">Carat min</label>
            <input id="DiamondCaratMin-Fallback" type="number" min="0" step="0.01" name="carat_min" placeholder="0.50">
          </div>
          <div class="jk-filter-group">
            <label for="DiamondCaratMax-Fallback">Carat max</label>
            <input id="DiamondCaratMax-Fallback" type="number" min="0" step="0.01" name="carat_max" placeholder="3.00">
          </div>
        </div>

        <div class="jk-filter-grid">
          <div class="jk-filter-group">
            <label for="DiamondColour-Fallback">Colour</label>
            <select id="DiamondColour-Fallback" name="colour">
              <option value="">Any colour</option>
              <option value="D">D</option>
              <option value="E">E</option>
              <option value="F">F</option>
              <option value="G">G</option>
              <option value="H">H</option>
              <option value="I">I</option>
            </select>
          </div>
          <div class="jk-filter-group">
            <label for="DiamondClarity-Fallback">Clarity</label>
            <select id="DiamondClarity-Fallback" name="clarity">
              <option value="">Any clarity</option>
              <option value="FL">FL</option>
              <option value="IF">IF</option>
              <option value="VVS1">VVS1</option>
              <option value="VVS2">VVS2</option>
              <option value="VS1">VS1</option>
              <option value="VS2">VS2</option>
              <option value="SI1">SI1</option>
            </select>
          </div>
        </div>

        <div class="jk-filter-grid">
          <div class="jk-filter-group">
            <label for="DiamondCut-Fallback">Cut</label>
            <select id="DiamondCut-Fallback" name="cut">
              <option value="">Any cut</option>
              <option value="Excellent">Excellent</option>
              <option value="Ideal">Ideal</option>
              <option value="Very Good">Very Good</option>
              <option value="Good">Good</option>
            </select>
          </div>
          <div class="jk-filter-group">
            <label for="DiamondType-Fallback">Origin</label>
            <select id="DiamondType-Fallback" name="type">
              <option value="">Lab grown or natural</option>
              <option value="Lab Grown" selected>Lab grown</option>
              <option value="Natural">Natural</option>
            </select>
          </div>
        </div>

        <div class="jk-filter-grid">
          <div class="jk-filter-group">
            <label for="DiamondLab-Fallback">Certificate lab</label>
            <select id="DiamondLab-Fallback" name="certificate_lab">
              <option value="">Any lab</option>
              <option value="GIA">GIA</option>
              <option value="IGI">IGI</option>
              <option value="GCAL">GCAL</option>
              <option value="HRD">HRD</option>
            </select>
          </div>
          <div class="jk-filter-group">
            <label for="DiamondSort-Fallback">Sort</label>
            <select id="DiamondSort-Fallback" name="sort">
              <option value="recommended">Recommended</option>
              <option value="carat_desc">Carat: high to low</option>
              <option value="carat_asc">Carat: low to high</option>
              <option value="quality">Quality first</option>
            </select>
          </div>
        </div>

        <div class="jk-filter-grid">
          <div class="jk-filter-group">
            <label for="DiamondPriceMin-Fallback">Price min</label>
            <input id="DiamondPriceMin-Fallback" type="number" min="0" step="1" name="price_min" placeholder="No minimum">
          </div>
          <div class="jk-filter-group">
            <label for="DiamondPriceMax-Fallback">Price max</label>
            <input id="DiamondPriceMax-Fallback" type="number" min="0" step="1" name="price_max" placeholder="No maximum">
          </div>
        </div>

        <div class="jk-diamond-filters__actions">
          <button type="submit" class="jk-diamond-button jk-diamond-button--dark">Search Diamonds</button>
          <button type="button" class="jk-diamond-button jk-diamond-button--quiet" data-diamond-reset>Reset</button>
        </div>
      </form>
    </aside>

    <div class="jk-diamond-results">
      <div class="jk-diamond-results__bar">
        <div>
          <p class="jk-diamond-select__eyebrow">Available diamonds</p>
          <h2 data-diamond-result-count>Curated selection</h2>
        </div>
        <p data-diamond-status>Loading live diamond inventory.</p>
      </div>

      <div class="jk-diamond-selected" data-selected-diamond-panel hidden>
        <div>
          <p class="jk-diamond-select__eyebrow">Selected diamond</p>
          <h3 data-selected-diamond-title>Choose a diamond to begin</h3>
          <p data-selected-diamond-meta>Your selected stone will be saved for the next step.</p>
        </div>
        <a class="jk-diamond-button jk-diamond-button--dark is-disabled" href="/pages/custom-design?step=setting" data-continue-setting aria-disabled="true">Choose Ring Setting</a>
      </div>

      <div class="jk-diamond-grid" data-diamond-results aria-live="polite"></div>

      <template data-diamond-card-template>
        <article class="jk-diamond-card">
          <div class="jk-diamond-card__media" data-diamond-media></div>
          <div class="jk-diamond-card__body">
            <div class="jk-diamond-card__topline">
              <p class="jk-diamond-card__type" data-diamond-type></p>
              <p class="jk-diamond-card__price" data-diamond-price></p>
            </div>
            <h3 data-diamond-title></h3>
            <dl class="jk-diamond-specs">
              <div><dt>Stock ID</dt><dd data-diamond-stock></dd></div>
              <div><dt>Carat</dt><dd data-diamond-carat></dd></div>
              <div><dt>Shape</dt><dd data-diamond-shape></dd></div>
              <div><dt>Colour</dt><dd data-diamond-colour></dd></div>
              <div><dt>Clarity</dt><dd data-diamond-clarity></dd></div>
              <div><dt>Cut</dt><dd data-diamond-cut></dd></div>
              <div><dt>Lab</dt><dd data-diamond-lab></dd></div>
              <div><dt>Status</dt><dd data-diamond-availability></dd></div>
            </dl>
            <p class="jk-diamond-card__certificate" data-diamond-certificate></p>
            <button type="button" class="jk-diamond-button jk-diamond-button--outline" data-select-diamond>Select Diamond</button>
          </div>
        </article>
      </template>
    </div>
  </div>
</section>
