{% liquid
  assign shape_label = shape | default: 'Round'
  assign shape_handle = shape_label | handleize
  assign icon_classes = icon_class | default: 'jk-diamond-shape-icon'
%}

<svg
  class="{{ icon_classes }} jk-diamond-shape-icon--{{ shape_handle }}"
  data-joyari-diamond-shape-icon="true"
  viewBox="0 0 64 64"
  role="img"
  aria-label="{{ shape_label | escape }} diamond cut icon"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  {% case shape_handle %}
    {% when 'round' %}
      <circle cx="32" cy="32" r="25"></circle>
      <circle cx="32" cy="32" r="13"></circle>
      <path d="M32 7v12M32 45v12M7 32h12M45 32h12M14.4 14.4l8.5 8.5M41.1 41.1l8.5 8.5M49.6 14.4l-8.5 8.5M22.9 41.1l-8.5 8.5"></path>
      <path d="M19 32l13-13 13 13-13 13Z"></path>
    {% when 'oval' %}
      <ellipse cx="32" cy="32" rx="20" ry="27"></ellipse>
      <ellipse cx="32" cy="32" rx="10" ry="15"></ellipse>
      <path d="M32 5v12M32 47v12M14 18l10 8M50 18l-10 8M14 46l10-8M50 46l-10-8M12 32h40"></path>
      <path d="M24 26l8-9 8 9-8 21Z"></path>
    {% when 'emerald' %}
      <path d="M18 7h28l11 11v28L46 57H18L7 46V18Z"></path>
      <path d="M22 16h20l6 6v20l-6 6H22l-6-6V22Z"></path>
      <path d="M18 7l4 9M46 7l-4 9M57 18l-9 4M57 46l-9-4M46 57l-4-9M18 57l4-9M7 46l9-4M7 18l9 4"></path>
      <path d="M22 32h20M32 16v32"></path>
    {% when 'pear' %}
      <path d="M32 5C18 19 11 31 13 43c1.7 10 9.7 16 19 16s17.3-6 19-16C53 31 46 19 32 5Z"></path>
      <path d="M32 5v54M18 40l14-17 14 17M21 50l11-10 11 10"></path>
      <path d="M20 24l12 16 12-16"></path>
    {% when 'cushion' %}
      <path d="M20 7h24c7 0 13 6 13 13v24c0 7-6 13-13 13H20c-7 0-13-6-13-13V20C7 13 13 7 20 7Z"></path>
      <path d="M22 16h20c4.5 0 6 1.5 6 6v20c0 4.5-1.5 6-6 6H22c-4.5 0-6-1.5-6-6V22c0-4.5 1.5-6 6-6Z"></path>
      <path d="M16 22l16 10 16-10M16 42l16-10 16 10M22 16l10 16 10-16M22 48l10-16 10 16"></path>
    {% when 'princess' %}
      <path d="M10 10h44v44H10Z"></path>
      <path d="M18 18h28v28H18Z"></path>
      <path d="M10 10l22 22 22-22M10 54l22-22 22 22M10 10l44 44M54 10L10 54"></path>
      <path d="M32 10v44M10 32h44"></path>
    {% when 'marquise' %}
      <path d="M5 32c8.5-14 17.5-21 27-21s18.5 7 27 21c-8.5 14-17.5 21-27 21S13.5 46 5 32Z"></path>
      <path d="M5 32h54M32 11v42M17 22l15 10 15-10M17 42l15-10 15 10"></path>
      <path d="M13 32l19-21 19 21-19 21Z"></path>
    {% when 'radiant' %}
      <path d="M17 7h30l10 10v30L47 57H17L7 47V17Z"></path>
      <path d="M20 17h24l3 3v24l-3 3H20l-3-3V20Z"></path>
      <path d="M17 7l15 25 15-25M17 57l15-25 15 25M7 17l25 15L57 17M7 47l25-15 25 15"></path>
      <path d="M32 7v50M7 32h50"></path>
    {% else %}
      <circle cx="32" cy="32" r="25"></circle>
      <circle cx="32" cy="32" r="13"></circle>
      <path d="M32 7v12M32 45v12M7 32h12M45 32h12M14.4 14.4l8.5 8.5M41.1 41.1l8.5 8.5M49.6 14.4l-8.5 8.5M22.9 41.1l-8.5 8.5"></path>
      <path d="M19 32l13-13 13 13-13 13Z"></path>
  {% endcase %}
</svg>
