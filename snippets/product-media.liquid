{% liquid
  assign media_alt = media.alt | default: product.title | escape
  assign thumbnail = media.preview_image
  assign media_mode = mode | default: 'main'
%}

{% if media_mode == 'thumbnail' %}
  {% if thumbnail != blank %}
    {{ thumbnail | image_url: width: 220 | image_tag: loading: 'eager', widths: '90, 140, 180, 220', sizes: '90px', alt: media_alt }}
  {% else %}
    {% render 'joyari-generated-image', file: 'joyari-product-pear-ring-on-hand.jpg', alt: media_alt, class: 'jk-media-thumb__image' %}
  {% endif %}

  {% if media.media_type == 'video' or media.media_type == 'external_video' %}
    <span class="jk-media-thumb__badge" aria-hidden="true">Play</span>
  {% elsif media.media_type == 'model' %}
    <span class="jk-media-thumb__badge" aria-hidden="true">3D</span>
  {% endif %}
{% else %}
  {% case media.media_type %}
    {% when 'image' %}
      {{ media | image_url: width: 1500 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200, 1500', sizes: '(min-width: 990px) 58vw, 100vw', alt: media_alt, class: 'jk-product-media__image' }}
    {% when 'video' %}
      {{ media | media_tag: image_size: '1500x', controls: true, preload: 'metadata', class: 'jk-product-media__video product-video' }}
    {% when 'external_video' %}
      <div class="jk-product-media__external">
        {{ media | external_video_tag: class: 'jk-product-media__external-video' }}
      </div>
    {% when 'model' %}
      {{ media | model_viewer_tag: image_size: '1500x', reveal: 'interaction', class: 'jk-product-media__model' }}
    {% else %}
      {% if thumbnail != blank %}
        {{ thumbnail | image_url: width: 1500 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200, 1500', sizes: '(min-width: 990px) 58vw, 100vw', alt: media_alt, class: 'jk-product-media__image' }}
      {% else %}
        {% render 'joyari-generated-image', file: 'joyari-product-pear-ring-on-hand.jpg', alt: media_alt, class: 'jk-product-media__image' %}
      {% endif %}
  {% endcase %}
{% endif %}
